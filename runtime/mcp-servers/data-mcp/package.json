{
  "name": "@framework/data-mcp",
  "version": "3.0.0",
  "description": "PostgreSQL MCP server with SSH tunnel support - query, inspect, and audit Postgres databases from Claude",
  "keywords": [
    "mcp",
    "postgres",
    "postgresql",
    "database",
    "ssh",
    "claude",
    "ai"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "data-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "node --test",
    "lint": "biome ci .",
    "biome": "biome check --write .",
    "biome:ci": "biome ci ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "exceljs": "^4.4.0",
    "postgres": "^3.4.9",
    "ssh2": "^1.15.0",
    "zod": "^4.4.3",
    "@framework/mcp-shared": "1.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^26.1.0",
    "@types/ssh2": "^1.15.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
