{
  "name": "@framework/penpot-mcp",
  "version": "0.1.0",
  "description": "Keychain-backed stdio bridge to Penpot's official remote MCP server",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "penpot-mcp": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "lint": "biome ci src scripts package.json",
    "biome": "biome check --write .",
    "biome:ci": "biome ci src scripts package.json"
  },
  "dependencies": {
    "mcp-remote": "^0.1.38"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
