{
  "name": "@framework/social-mcp",
  "version": "2.3.2",
  "description": "Social media MCP — browse, download, and extract content from YouTube, Instagram, TikTok, and Facebook via Claude",
  "keywords": [
    "mcp",
    "youtube",
    "instagram",
    "tiktok",
    "facebook",
    "yt-dlp",
    "social",
    "claude",
    "ai"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "social-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "reauth.mjs",
    "scripts/ensure-puppeteer-browser.mjs"
  ],
  "scripts": {
    "build": "tsc",
    "browser:install": "node scripts/ensure-puppeteer-browser.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "reauth": "node reauth.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@googleapis/analyticsadmin": "latest",
    "@googleapis/analyticsdata": "latest",
    "@googleapis/calendar": "latest",
    "@googleapis/gmail": "latest",
    "@googleapis/oauth2": "latest",
    "@googleapis/searchconsole": "latest",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "google-auth-library": "^10.0.0",
    "googleapis-common": "^8.0.2",
    "open": "^11.0.0",
    "puppeteer-core": "^22.0.0",
    "zod": "^3.23.0",
    "@framework/mcp-shared": "*"
  },
  "overrides": {
    "ws": "8.20.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
