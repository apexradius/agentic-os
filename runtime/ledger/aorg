        text = ""
        with contextlib.suppress(OSError):
            text = path.read_text(encoding="utf-8", errors="replace")[:6000].casefold()
        if "active execution board" in text or "status | vna" in text:
            if path.name in PLAN_PROTECTED_NAMES:
                counts["protected"] += 1
            counts["active"] += 1
            continue
        if path.name in PLAN_PROTECTED_NAMES or PLAN_PROTECTED_DIRS.intersection(parts):
            counts["protected"] += 1
            continue
        if "complete" in text or "completed" in text:
            counts["completed"] += 1
            continue
        with contextlib.suppress(OSError):
            age_days = int((now_ts - path.stat().st_mtime) / 86400)
            if age_days >= 30:
                counts["stale"] += 1
                if len(stale_samples) < 5:
                    stale_samples.append(rel)
    return counts, stale_samples


