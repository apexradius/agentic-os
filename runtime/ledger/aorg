def task_is_read_only(task: dict) -> bool:
    mode = str(task.get("mode") or "").strip().lower()
    return mode in READ_ONLY_FILE_MODES


def task_is_non_mutating(task: dict) -> bool:
    """True when the task cannot write or execute against production.

    Read-only mode or the read-only-tools sandbox is a hard capability
    boundary; scope-text risk escalation (which gates production mutation)
    must not fire on it. Host-execution and sandbox-scope gates run upstream
    in dispatch_denial and still apply, so this exemption cannot let an
    actually-executing task through.
    """
    if task_is_read_only(task):
        return True
    return task_sandbox_profile(task) == "read-only-tools"


def task_is_approval_gate(task: dict) -> bool:
    mode = str(task.get("mode") or "").strip().lower()
    return mode in APPROVAL_GATE_MODES


def vps_scoped_task(task: dict) -> bool:
    text = task_scope_text(task).casefold()
    if any(text_has_token(text, term) for term in VPS_SCOPE_TERMS):
        return True
    candidates = [str(task.get("repo") or "")]
    candidates.extend(str(item) for item in (task.get("files") or []))
    candidates.extend(str(item) for item in (task.get("files_owned") or []))
    return any(
        candidate.startswith(VPS_SCOPE_PATH_PREFIXES)
        for candidate in candidates
        if candidate
    )


def host_execution_requested(task: dict) -> bool:
    text = task_scope_text(task)
    for pattern in HOST_EXECUTION_PATTERNS:
        for match in pattern.finditer(text):
            line_start = text.rfind("\n", 0, match.start()) + 1
            prefix = text[line_start : match.start()]
            if HOST_EXECUTION_NEGATION_RE.search(prefix):
                continue
            return True
    return False


def apply_sandbox_defaults(task: dict) -> None:
    profile = task_sandbox_profile(task)
    if not profile and task_is_approval_gate(task):
        task["sandbox_profile"] = HOST_EXECUTION_SANDBOX_PROFILE
        return
    if not profile and task_is_read_only(task):
        task["sandbox_profile"] = "read-only-tools"
        return
    if not profile and not vps_scoped_task(task):
        task["sandbox_profile"] = "local-workspace"
        return
    if profile:
        task["sandbox_profile"] = profile


def sandbox_denial(task: dict) -> str | None:
    apply_sandbox_defaults(task)
    profile = task_sandbox_profile(task)
    if profile and profile not in SANDBOX_PROFILES:
        return f"invalid_sandbox_profile:{profile}"
    if not vps_scoped_task(task):
        return None
    if not profile:
        return "missing_sandbox_profile:vps_scope"
    if profile not in VPS_SANDBOX_PROFILES:
        return f"invalid_vps_sandbox_profile:{profile}"
    if host_execution_requested(task) and profile != HOST_EXECUTION_SANDBOX_PROFILE:
        return "host_execution_requires_human_approved_host"
    return None


def apply_sandbox_risk(task: dict) -> None:
    apply_sandbox_defaults(task)
    if task_sandbox_profile(task) != HOST_EXECUTION_SANDBOX_PROFILE:
        return
    risk_order = {"low": 0, "medium": 1, "high": 2, "critical": 3}
    current = str(task.get("risk_level") or "low").casefold()
    if risk_order.get(current, 0) < risk_order["high"]:
        task["risk_level"] = "high"
        task["risk_escalated_by"] = "sandbox_profile:human-approved-host"


def is_probably_text(path: Path, max_bytes: int = 512_000) -> bool:
    try:
        return path.stat().st_size <= max_bytes
    except OSError:
        return False


def is_inactive_aorg_artifact(path: Path) -> bool:
    if path.parent.name != "bin":
        return False
    name = path.name
    return (
        name.startswith("aorg.bak-")
        or name.startswith("aorg.blockade-fix-")
        or name.startswith("aorg.pre-")
        or name.endswith(".new")
    )


def scan_billing_paths(paths: list[Path], *, active_hooks_only: bool = False) -> list[dict]:
    findings: list[dict] = []
    seen: set[Path] = set()
    for root in paths:
        try:
            root_exists = root.exists()
        except OSError:
            continue
        if not root_exists:
            continue
        try:
            root_is_file = root.is_file()
        except OSError:
            continue
        if root_is_file:
            files = [root]
        else:
            files = []
            for dirpath, dirnames, filenames in os.walk(root):
                dirnames[:] = [name for name in dirnames if name not in SCAN_SKIP_DIRS]
                for filename in filenames:
                    files.append(Path(dirpath) / filename)
        for path in files:
            if path in seen:
                continue
            seen.add(path)
            if any(str(path).endswith(suffix) for suffix in SCAN_SKIP_SUFFIXES):
                continue
            if is_inactive_aorg_artifact(path):
                continue
            if active_hooks_only and ".disabled" in path.name:
                continue
            if path == Path(__file__).resolve():
                continue
            if not is_probably_text(path):
                continue
            try:
                text = path.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            for line_no, line in enumerate(text.splitlines(), 1):
                for label, pattern in BILLING_PATTERN_SPECS:
                    if pattern.search(line):
                        findings.append({"path": str(path), "line": line_no, "pattern": label})
    return findings


def run_billing_scan(include_vps: bool = False) -> tuple[list[dict], list[str]]:
    active_hook_roots = list(BILLING_HOOK_ROOTS)
    local_code_roots = [ROOT, *BILLING_LOCAL_ROOTS]
    findings = scan_billing_paths(active_hook_roots, active_hooks_only=True)
    findings.extend(scan_billing_paths(local_code_roots))
    notes: list[str] = []
    if include_vps:
        pattern = (
            r"claude -p|claude --print|claude --bare|@anthropic-ai/sdk|api\.anthropic\.com|"
            r"ANTHROPIC_API_KEY|GEMINI_API_KEY|google\.generativeai|"
            r"@google/generative-ai|@google/genai"
        )
        quoted_pattern = shlex.quote(pattern)
        remote_scan_roots = BILLING_REMOTE_SCAN_ROOTS
        scan_roots = " ".join(shlex.quote(root) for root in remote_scan_roots)
        command = (
            f"roots=''; for root in {scan_roots}; do [ -e \"$root\" ] && roots=\"$roots $root\"; done; "
            "[ -n \"$roots\" ] || exit 1; "
            "if command -v rg >/dev/null 2>&1; then "
            "echo __aorg_scan_tool=rg; "
            f"rg -n --glob '!*.disabled' --glob '!*.log' --glob '!node_modules/**' "
            f"--glob '!target/**' --glob '!dist/**' --glob '!venv/**' --glob '!.venv/**' "
            f"--glob '!site-packages/**' --glob '!_work/**' --glob '!backups/**' --glob '!state/**' "
            f"--glob '!bin/aorg' --glob '!bin/aorg.pre-*' --glob '!bin/aorg.bak-*' "
            f"--glob '!bin/aorg.blockade-fix-*' --glob '!bin/*.new' {quoted_pattern} $roots 2>/dev/null; "
            "else "
            "echo __aorg_scan_tool=grep; "
            "grep -rInE --binary-files=without-match --exclude='*.disabled' --exclude='*.log' "
            "--exclude='aorg' --exclude='aorg.pre-*' --exclude='aorg.bak-*' "
            "--exclude='aorg.blockade-fix-*' --exclude='*.new' "
            "--exclude-dir=node_modules --exclude-dir=target --exclude-dir=dist --exclude-dir=.git "
            "--exclude-dir=venv --exclude-dir=.venv --exclude-dir=site-packages --exclude-dir=_work "
            "--exclude-dir=backups --exclude-dir=state "
            f"{quoted_pattern} $roots 2>/dev/null; "
            "fi"
        )
        proc = subprocess.run([*ssh_base_command(10), VPS_SSH_TARGET, command], text=True, capture_output=True, timeout=60)
        if proc.returncode in {0, 1}:
            for raw_line in proc.stdout.splitlines():
                if raw_line.startswith("__aorg_scan_tool="):
                    notes.append(f"vps_scan_tool={raw_line.split('=', 1)[1]}")
                    continue
                parts = raw_line.split(":", 2)
                if len(parts) >= 2:
                    findings.append({"path": f"vps:{parts[0]}", "line": parts[1], "pattern": "remote_billing_pattern"})
            notes.append(f"vps_scan_exit={proc.returncode}")
        else:
            notes.append(f"vps_scan_failed_exit={proc.returncode}")
    return findings, notes


def dispatch_denial(task: dict) -> tuple[str, str] | None:
    role_denial = role_policy_window_denial(task.get("assignee", ""), task.get("mode"))
    if role_denial:
        return ("policy_window", role_denial)
    if task_assignee_is_human(task):
        return None
    sandbox = sandbox_denial(task)
    if sandbox:
        return ("sandbox", sandbox)
    apply_sandbox_risk(task)
    risk_denial = risk_approval_denial(task)
    if risk_denial:
        return ("risk_approval", risk_denial)
    billing_denial = task_billing_denial(task)
    if billing_denial:
        return ("billing", billing_denial)
    return policy_denial(task)


def task_scope_text(task: dict) -> str:
    parts = [
        str(task.get("title") or ""),
        str(task.get("task") or ""),
        str(task.get("repo") or ""),
        "\n".join(str(item) for item in (task.get("files") or [])),
        "\n".join(str(item) for item in (task.get("files_owned") or [])),
    ]
    return "\n".join(part for part in parts if part)


def file_scope_risk_reason(task: dict) -> str | None:
    candidates = []
    repo = str(task.get("repo") or "")
    if repo:
        candidates.append(normalize_task_file(repo))
    for value in [*(task.get("files") or []), *(task.get("files_owned") or [])]:
        if value:
            candidates.append(normalize_task_file(str(value), repo))

    lowered_text = task_scope_text(task).casefold()
    if production_scope_in_text(lowered_text):
        return "production_scope"
    for candidate in candidates:
        matched = any_casefold_match(candidate, PATH_HIGH_RISK_PATTERNS)
        if matched:
            return f"path_scope:{matched}"
    return None


def apply_scope_risk(task: dict) -> None:
    if task_is_non_mutating(task):
        return
    reason = file_scope_risk_reason(task)
    if not reason:
        return
    risk_order = {"low": 0, "medium": 1, "high": 2, "critical": 3}
    current = str(task.get("risk_level") or "low").casefold()
    if risk_order.get(current, 0) < risk_order["high"]:
        task["risk_level"] = "high"
        task["risk_escalated_by"] = reason


def risk_approval_denial(task: dict) -> str | None:
    apply_scope_risk(task)
    risk_level = str(task.get("risk_level") or "low").casefold()
    if risk_level not in REVIEW_REQUIRED_RISKS:
        return None
    if task.get("approvals"):
        return None
    if risk_level == "critical":
        return "critical_risk_requires_recorded_approval"
    return "high_risk_requires_recorded_approval"


def evidence_path_exists(value: str) -> bool:
    if not value:
        return False
    if value.startswith(("http://", "https://", "cmd:", "note:")):
        return True
    if value.startswith("/") or value.startswith("."):
        return Path(value).expanduser().exists()
    return True


GIT_COMMIT_SHA_RE = re.compile(
    r"\b(?:commit(?:\s+sha)?|git(?:\s+sha)?|head(?:\s+sha)?|sha)\b[^0-9a-f]{0,40}[0-9a-f]{7,40}\b"
    r"|\b[0-9a-f]{40}\b",
    re.IGNORECASE,
)


def completion_claims_code_change(task: dict, args: argparse.Namespace) -> bool:
    mode = str(task.get("mode") or "").strip().lower()
    if mode in READ_ONLY_FILE_MODES or task_is_approval_gate(task):
        return False
    return bool((getattr(args, "files", None) or []) or task_file_set(task))


def evidence_text_candidates(evidence: list[str]) -> list[str]:
    candidates = list(evidence)
    for item in evidence:
        if not item or item.startswith(("http://", "https://", "cmd:", "note:")):
            continue
        path = Path(item).expanduser()
        if not path.is_absolute() and not str(path).startswith("."):
            continue
        try:
            if path.exists() and path.is_file() and path.stat().st_size <= 512_000:
                candidates.append(path.read_text(encoding="utf-8", errors="replace"))
        except OSError:
            continue
    return candidates


def evidence_has_commit_sha(evidence: list[str]) -> bool:
    return any(GIT_COMMIT_SHA_RE.search(candidate) for candidate in evidence_text_candidates(evidence))


def task_acceptance_criteria(task: dict) -> list[str]:
    return task.get("acceptance_criteria") or DEFAULT_ACCEPTANCE_CRITERIA


def verification_satisfied(task: dict) -> bool:
    command = task.get("verification_command")
    if not command:
        return True
    for run in task.get("verification_runs") or []:
        if run.get("command") == command and run.get("exit_code") == 0:
            return True
    return False


def completion_errors(task: dict, args: argparse.Namespace, tasks: list[dict] | None = None) -> list[str]:
    if task.get("mode") == "bootstrap":
        return []
    errors: list[str] = []
    if task_is_approval_gate(task) and not task.get("approvals"):
        errors.append("approval_gate_missing_recorded_approval")
    evidence = args.evidence or []
    if not evidence:
        errors.append("missing_evidence")
    missing = [item for item in evidence if not evidence_path_exists(item)]
    if missing:
        errors.append("missing_evidence_path:" + ",".join(missing))
    for required in task.get("verification_evidence_required") or []:
        if not any(required in item for item in evidence):
            errors.append(f"missing_required_evidence:{required}")
    if completion_claims_code_change(task, args) and not evidence_has_commit_sha(evidence):
        errors.append("missing_commit_sha_evidence")
    criteria = task_acceptance_criteria(task)
    if criteria and len(args.acceptance_met or []) < len(criteria):
        errors.append(f"acceptance_criteria_unmet:{len(args.acceptance_met or [])}/{len(criteria)}")
    if not verification_satisfied(task):
        errors.append("verification_command_not_passed")
    errors.extend(worktree_completion_errors(task, args))
    errors.extend(parent_completion_sibling_errors(tasks, task))
    return errors


