def cmd_plan(args: argparse.Namespace) -> None:
    templates_dir = STATE / "templates"
    if not templates_dir.is_dir():
        print(f"plan templates missing: {templates_dir}", file=sys.stderr)
        sys.exit(2)
    template_paths = sorted(path for path in templates_dir.glob("*.md") if path.is_file())
    if not template_paths:
        print(f"plan templates missing: {templates_dir}/*.md", file=sys.stderr)
        sys.exit(2)

    with task_write_lock():
        tasks = read_tasks_unlocked()
        task = task_by_id(tasks, args.task_id)
        if not task:
            print(f"task not found: {args.task_id}", file=sys.stderr)
            sys.exit(2)

        plan_dir = STATE / "plans" / args.task_id
        plan_dir.mkdir(parents=True, exist_ok=True)
        written: list[str] = []
        for template in template_paths:
            target = plan_dir / template.name
            if target.exists() and not args.force:
                continue
            content = template.read_text(encoding="utf-8")
            content = content.replace("<task-id>", args.task_id)
            content = content.replace("<title>", str(task.get("title") or "untitled"))
            target.write_text(content, encoding="utf-8")
            written.append(str(target))

        task["plan_artifact"] = f"plans/{args.task_id}"
        task["plan_artifact_created_at"] = now()
        write_tasks_unlocked(tasks)

    print(f"plan {args.task_id}")
    print(plan_dir)
    for path in written:
        print(path)


def cmd_claim(args: argparse.Namespace) -> None:
    role_or_die(args.role)
    halt = active_halt()
    if halt:
        print(f"global halt active: {halt.get('reason')}", file=sys.stderr)
        sys.exit(2)
    with task_write_lock():
        tasks = read_tasks_unlocked()
        task = task_by_id(tasks, args.task_id)
        if not task:
            print(f"task not found: {args.task_id}", file=sys.stderr)
            sys.exit(2)
        if task.get("assignee") != args.role:
            print(f"task assigned to {task.get('assignee')}, not {args.role}", file=sys.stderr)
            sys.exit(2)
        if task.get("status") == "claimed":
            denial = live_claim_denial(task, args)
            if denial:
                print(denial, file=sys.stderr)
                sys.exit(2)
        elif task.get("status") not in {"pending", "blocked"}:
            print(f"task is {task.get('status')}; refusing claim", file=sys.stderr)
            sys.exit(2)
        if task_is_approval_gate(task):
            print("approval gate tasks do not require claim; record approval and complete with evidence", file=sys.stderr)
            sys.exit(2)
        denial = dependency_denial(tasks, task)
        if not denial:
            denial = role_policy_window_denial(args.role, task.get("mode"))
        if not denial:
            denial = plan_artifact_denial(task)
        if not denial:
            denial = risk_approval_denial(task)
        if not denial:
            denial = sandbox_denial(task)
        if not denial:
            apply_sandbox_risk(task)
            denial = risk_approval_denial(task)
        if not denial:
            denial = file_ownership_denial(tasks, task)
        if not denial and getattr(args, "worktree", False):
            denial = worktree_claim_denial(task)
        if denial:
            task["status"] = "blocked"
            task["blocked_at"] = now()
            task["blocked_reason"] = denial
            write_tasks_unlocked(tasks)
            print(f"blocked {args.task_id}: {denial}", file=sys.stderr)
            sys.exit(2)
        if getattr(args, "worktree", False):
            denial = create_task_worktree(task)
            if denial:
                print(f"blocked {args.task_id}: {denial}", file=sys.stderr)
                sys.exit(2)
        task["status"] = "claimed"
        stamp_task_session(task, args, args.role, claimed=True)
        owned = sorted(task_file_set(task))
        if owned:
            task["files_owned"] = owned
        write_tasks_unlocked(tasks)
    print(f"claimed {args.task_id}")


