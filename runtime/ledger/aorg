def local_verification_repo(repo: Path) -> Path:
    if repo.exists():
        return repo
    if not local_default_state_uses_vps_canonical():
        return repo
    raw = str(repo)
    if CANONICAL_WORKSPACE and (raw == CANONICAL_WORKSPACE or raw.startswith(CANONICAL_WORKSPACE + "/")):
        mapped = Path(str(WORKSPACE) + raw[len(CANONICAL_WORKSPACE) :])
        if mapped.exists():
            return mapped
    return repo


def remote_report_path(local_path: Path) -> str:
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    safe_name = re.sub(r"[^A-Za-z0-9_.-]+", "_", local_path.name)
    return f"{VPS_CANONICAL_STATE_DIR.rstrip('/')}/reports/proxy-{stamp}-{safe_name}"


def mirror_proxy_evidence(argv: list[str]) -> list[str]:
    rewritten = list(argv)
    evidence_flags = {"--evidence"}
    idx = 0
    while idx < len(rewritten):
        token = rewritten[idx]
        if token not in evidence_flags:
            idx += 1
            continue
        idx += 1
        while idx < len(rewritten) and not rewritten[idx].startswith("--"):
            evidence = rewritten[idx]
            path = Path(evidence).expanduser()
            if path.is_file() and str(path).startswith(SAFE_PATH_PREFIXES):
                remote_path = remote_report_path(path)
                report_dir = shlex.quote(VPS_CANONICAL_STATE_DIR.rstrip("/") + "/reports")
                owner = shlex.quote(VPS_CANONICAL_EXPECT_STATE_OWNER)
                group = shlex.quote(VPS_CANONICAL_EXPECT_STATE_GROUP)
                mkdir_cmd = f"mkdir -p {report_dir} && chown {owner}:{group} {report_dir} && chmod 2775 {report_dir}"
                mkdir_proc = subprocess.run(
                    [*ssh_base_command(10), VPS_CANONICAL_HOST, mkdir_cmd],
                    text=True,
                    capture_output=True,
                    timeout=VPS_CANONICAL_TIMEOUT,
                )
                if mkdir_proc.returncode != 0:
                    print(f"remote evidence mkdir failed: {(mkdir_proc.stderr or mkdir_proc.stdout).strip()}", file=sys.stderr)
                    sys.exit(2)
                # Write a redacted copy before rsyncing so secrets never land on VPS.
                raw_content = path.read_text(encoding="utf-8", errors="replace")
                redacted_content = redact_text(raw_content, max_chars=len(raw_content) + 1)
                import tempfile as _tempfile
                with _tempfile.NamedTemporaryFile(
                    mode="w", suffix=path.suffix, delete=False, encoding="utf-8"
                ) as _tmp:
                    _tmp.write(redacted_content)
                    _redacted_path = _tmp.name
                try:
                    rsync_proc = subprocess.run(
                        [*rsync_base_command(10), _redacted_path, f"{VPS_CANONICAL_HOST}:{remote_path}"],
                        text=True,
                        capture_output=True,
                        timeout=VPS_CANONICAL_TIMEOUT,
                    )
                finally:
                    os.unlink(_redacted_path)
                if rsync_proc.returncode != 0:
                    print(f"remote evidence rsync failed: {(rsync_proc.stderr or rsync_proc.stdout).strip()}", file=sys.stderr)
                    sys.exit(2)
                rewritten[idx] = remote_path
            idx += 1
    return rewritten


def proxy_to_vps_canonical(argv: list[str]) -> int:
    if broker_transport_available():
        return proxy_to_broker(argv)
    remote_argv = mirror_proxy_evidence(argv)
    remote_env = [
        f"AORG_WORKSPACE={shlex.quote(CANONICAL_WORKSPACE)}",
        f"AORG_STATE_DIR={shlex.quote(VPS_CANONICAL_STATE_DIR)}",
        f"AORG_EXPECT_STATE_OWNER={shlex.quote(VPS_CANONICAL_EXPECT_STATE_OWNER)}",
        f"AORG_EXPECT_STATE_GROUP={shlex.quote(VPS_CANONICAL_EXPECT_STATE_GROUP)}",
        f"APEX_AGENT_HOST={shlex.quote(current_host())}",
    ]
    agent_pid = current_agent_pid()
    if agent_pid:
        remote_env.append(f"APEX_AGENT_PID={agent_pid}")
    agent_identity = os.environ.get("APEX_AGENT_IDENTITY")
    if agent_identity:
        remote_env.append(f"APEX_AGENT_IDENTITY={shlex.quote(agent_identity)}")
    remote_command = " ".join(
        [
            *remote_env,
            shlex.quote(VPS_CANONICAL_BIN),
            *(shlex.quote(arg) for arg in remote_argv),
        ]
    )
    proc = subprocess.run(
        [*ssh_base_command(10), VPS_CANONICAL_HOST, remote_command],
        text=True,
        capture_output=False,
        timeout=VPS_CANONICAL_TIMEOUT,
    )
    return proc.returncode


def task_progress_stamp(task: dict) -> str:
    """Latest progress timestamp on a task record. ISO-8601 UTC 'Z' stamps
    compare correctly as strings; absent/malformed stamps rank lowest so a
    record with real progress always beats one without."""
    stamps: list[str] = []
    for key in (
        "created_at",
        "claimed_at",
        "last_heartbeat_at",
        "completed_at",
        "completion_candidate_at",
        "cancelled_at",
        "blocked_at",
        "updated_at",
    ):
        value = task.get(key)
        if isinstance(value, str) and value:
            stamps.append(value)
    for run in task.get("verification_runs") or []:
        if isinstance(run, dict):
            value = run.get("completed_at")
            if isinstance(value, str) and value:
                stamps.append(value)
    return max(stamps) if stamps else ""


def merge_task_records(
    canonical: list[dict], local: list[dict]
) -> tuple[list[dict], list[str], list[str]]:
    """Union-by-id merge of the canonical and local task ledgers.

    Invariant: no task id present on EITHER side is ever dropped — a sync must
    never destroy a record (task aorg-20260610-192629-claude-bb33fd was lost to
    a blind canonical-over-local overwrite on 2026-06-10). Same-id conflicts
    resolve to the record with the later progress stamp; canonical wins ties.
    Returns (merged, local_only_ids, local_won_ids).
    """
    local_by_id: dict[str, dict] = {}
    for task in local:
        if isinstance(task, dict) and isinstance(task.get("id"), str) and task["id"]:
            local_by_id.setdefault(task["id"], task)
    merged: list[dict] = []
    seen: set[str] = set()
    local_only: list[str] = []
    local_won: list[str] = []
    for task in canonical:
        if not isinstance(task, dict):
            continue
        task_id = task.get("id")
        if not isinstance(task_id, str) or not task_id:
            merged.append(task)
            continue
        if task_id in seen:
            continue
        seen.add(task_id)
        local_task = local_by_id.get(task_id)
        if (
            local_task is not None
            and local_task != task
            and task_progress_stamp(local_task) > task_progress_stamp(task)
        ):
            merged.append(local_task)
            local_won.append(task_id)
        else:
            merged.append(task)
    for task in local:
        if not isinstance(task, dict):
            continue
        task_id = task.get("id")
        if isinstance(task_id, str) and task_id and task_id not in seen:
            seen.add(task_id)
            merged.append(task)
            local_only.append(task_id)
    return merged, local_only, local_won


def _review_already_recorded(parent: dict, review: dict) -> bool:
    for existing in parent.get("reviews") or []:
        if not isinstance(existing, dict):
            continue
        if (
            existing.get("reviewer") == review.get("reviewer")
            and existing.get("decision") == review.get("decision")
            and existing.get("reviewed_at") == review.get("reviewed_at")
        ):
            return True
    return False


def reconcile_review_pass_invariants(tasks: list[dict]) -> list[str]:
    """Repair cross-record invariants after independent task-record merge.

    Completion-review tasks are the durable review receipts. If a completed
    passing review survives merge, its reviewed parent must also be complete.
    """
    by_id = {task.get("id"): task for task in tasks if isinstance(task, dict) and task.get("id")}
    repaired: list[str] = []
    for review_task in tasks:
        if not isinstance(review_task, dict):
            continue
        if review_task.get("mode") != "completion-review":
            continue
        if review_task.get("status") != "complete" or review_task.get("review_passed") is not True:
            continue
        parent_id = review_task.get("reviews_task")
        parent = by_id.get(parent_id)
        if not parent:
            continue

        changed = False
        if parent.get("status") != "complete":
            parent["status"] = "complete"
            changed = True
        if parent.get("review_passed") is not True:
            parent["review_passed"] = True
            changed = True
        reviewed_at = review_task.get("reviewed_at") or review_task.get("completed_at")
        if reviewed_at and parent.get("reviewed_at") != reviewed_at:
            parent["reviewed_at"] = reviewed_at
            changed = True
        if parent.get("blocked_reason") is not None:
            parent["blocked_reason"] = None
            changed = True
        for review in review_task.get("reviews") or []:
            if isinstance(review, dict) and not _review_already_recorded(parent, review):
                parent.setdefault("reviews", []).append(review)
                changed = True
        if changed:
            repaired.append(str(parent_id))
    return repaired


def cmd_sync_from_vps(args: argparse.Namespace) -> None:
    backup_dir = STATE / "backups" / f"pre-vps-sync-{datetime.now().strftime('%Y%m%d-%H%M%S-%f')}"
    backup_dir.mkdir(parents=True, exist_ok=True)
    for path in [TASKS, HALT_FILE, STATE / "escalations.jsonl", STATE / "approvals.jsonl", STATE / "cancellations.jsonl"]:
        if path.exists():
            shutil.copy2(path, backup_dir / path.name)
    if INBOX.exists():
        inbox_backup = backup_dir / "inbox"
        shutil.copytree(INBOX, inbox_backup, dirs_exist_ok=True)
    if REPORTS.exists():
        reports_backup = backup_dir / "reports"
        shutil.copytree(REPORTS, reports_backup, dirs_exist_ok=True)

    remote_dir = VPS_CANONICAL_STATE_DIR.rstrip("/")
    state_names = ["tasks.jsonl", "halt.json", "escalations.jsonl", "approvals.jsonl", "cancellations.jsonl"]
    list_script = "\n".join(
        [
            "import json, pathlib, sys",
            "root = pathlib.Path(sys.argv[1])",
            "names = json.loads(sys.argv[2])",
            "for name in names:",
            "    if (root / name).exists():",
            "        print(name)",
        ]
    )
    list_command = " ".join(
        shlex.quote(part) for part in ["python3", "-c", list_script, remote_dir, json.dumps(state_names)]
    )
    list_proc = subprocess.run(
        [*ssh_base_command(10), VPS_CANONICAL_HOST, list_command],
        text=True,
        capture_output=True,
        timeout=VPS_CANONICAL_TIMEOUT,
    )
    if list_proc.returncode != 0:
        print(f"sync-from-vps failed listing state files: {(list_proc.stderr or list_proc.stdout).strip()}", file=sys.stderr)
        print(f"backup: {backup_dir}", file=sys.stderr)
        sys.exit(2)
    existing_names = [line.strip() for line in list_proc.stdout.splitlines() if line.strip() in state_names]
    if "tasks.jsonl" not in existing_names:
        print(f"sync-from-vps failed: remote canonical tasks.jsonl missing at {remote_dir}", file=sys.stderr)
        print(f"backup: {backup_dir}", file=sys.stderr)
        sys.exit(2)
    # Canonical tasks.jsonl lands in a temp file, NEVER directly over the local
    # ledger: a blind overwrite destroys any record that only exists locally
    # (lost task aorg-20260610-192629-claude-bb33fd, 2026-06-10). Other state
    # files keep the direct pull; the tasks ledger is merged below.
    canonical_tmp = STATE / ".tasks.canonical.sync.tmp"
    fetch_proc = subprocess.run(
        [*rsync_base_command(10), f"{VPS_CANONICAL_HOST}:{remote_dir}/tasks.jsonl", str(canonical_tmp)],
        text=True,
        capture_output=True,
        timeout=VPS_CANONICAL_TIMEOUT,
    )
    if fetch_proc.returncode != 0:
        canonical_tmp.unlink(missing_ok=True)
        print(f"sync-from-vps failed at tasks ledger: {(fetch_proc.stderr or fetch_proc.stdout).strip()}", file=sys.stderr)
        print(f"backup: {backup_dir}", file=sys.stderr)
        sys.exit(2)
    other_sources = [f"{VPS_CANONICAL_HOST}:{remote_dir}/{name}" for name in existing_names if name != "tasks.jsonl"]
    if other_sources:
        others_proc = subprocess.run(
            [*rsync_base_command(10), *other_sources, f"{STATE}/"],
            text=True,
            capture_output=True,
            timeout=VPS_CANONICAL_TIMEOUT,
        )
        if others_proc.returncode != 0:
            canonical_tmp.unlink(missing_ok=True)
            print(f"sync-from-vps failed at state files: {(others_proc.stderr or others_proc.stdout).strip()}", file=sys.stderr)
            print(f"backup: {backup_dir}", file=sys.stderr)
            sys.exit(2)
    canonical_tasks, canonical_errors = read_jsonl_readonly_unlocked(canonical_tmp)
    if canonical_errors:
        canonical_tmp.unlink(missing_ok=True)
        print(f"sync-from-vps refused: canonical tasks.jsonl has parse errors, local ledger left untouched: {canonical_errors[:3]}", file=sys.stderr)
        print(f"backup: {backup_dir}", file=sys.stderr)
        sys.exit(2)
    with task_write_lock():
        local_tasks, _local_errors = read_jsonl_readonly_unlocked(TASKS)
        merged_tasks, local_only_ids, local_won_ids = merge_task_records(canonical_tasks, local_tasks)
        review_invariant_ids = reconcile_review_pass_invariants(merged_tasks)
        if local_only_ids or local_won_ids or review_invariant_ids:
            write_tasks_unlocked(merged_tasks)
            canonical_tmp.unlink(missing_ok=True)
        else:
            # Byte-faithful adoption preserves the canonical-health sha256 match.
            os.replace(canonical_tmp, TASKS)
            chmod_best_effort(TASKS, 0o664)
            refresh_inboxes(merged_tasks)
    if local_only_ids or local_won_ids or review_invariant_ids:
        if local_only_ids:
            print(f"rescued-local-only-tasks {len(local_only_ids)}: {' '.join(local_only_ids)}")
        if local_won_ids:
            print(f"local-won-conflicts {len(local_won_ids)}: {' '.join(local_won_ids)}")
        if review_invariant_ids:
            print(f"repaired-review-pass-invariants {len(review_invariant_ids)}: {' '.join(review_invariant_ids)}")
        rescue_push = mirror_vps_state(force=True)
        if not rescue_push or not rescue_push.get("ok"):
            print("warning: rescue push to canonical failed; merged ledger retains rescued records locally and will retry on next sync", file=sys.stderr)
    inbox_proc = subprocess.run(
        [*rsync_base_command(10), f"{VPS_CANONICAL_HOST}:{remote_dir}/inbox/", f"{INBOX}/"],
        text=True,
        capture_output=True,
        timeout=VPS_CANONICAL_TIMEOUT,
    )
    if inbox_proc.returncode != 0:
        print(f"sync-from-vps failed at inbox: {(inbox_proc.stderr or inbox_proc.stdout).strip()}", file=sys.stderr)
        print(f"backup: {backup_dir}", file=sys.stderr)
        sys.exit(2)
    reports_remote = f"{remote_dir}/reports"
    reports_exists = subprocess.run(
        [*ssh_base_command(10), VPS_CANONICAL_HOST, f"test -d {shlex.quote(reports_remote)}"],
        text=True,
        capture_output=True,
        timeout=VPS_CANONICAL_TIMEOUT,
    )
    if reports_exists.returncode == 0:
        REPORTS.mkdir(parents=True, exist_ok=True)
        reports_proc = subprocess.run(
            [*rsync_base_command(10), f"{VPS_CANONICAL_HOST}:{reports_remote}/", f"{REPORTS}/"],
            text=True,
            capture_output=True,
            timeout=VPS_CANONICAL_TIMEOUT,
        )
        if reports_proc.returncode != 0:
            print(f"sync-from-vps failed at reports: {(reports_proc.stderr or reports_proc.stdout).strip()}", file=sys.stderr)
            print(f"backup: {backup_dir}", file=sys.stderr)
            sys.exit(2)
    removed = prune_named_backups(
        "pre-vps-sync-",
        env_int("AORG_PRE_VPS_SYNC_BACKUPS_TO_KEEP", default=0, minimum=0),
    )
    print(f"synced-from-vps {VPS_CANONICAL_HOST}:{remote_dir}")
    print(f"backup: {backup_dir}")
    if removed:
        print(f"pruned-pre-vps-sync-backups {len(removed)}")


def summarize_task_ledger(path: Path) -> dict:
    summary = {
        "path": str(path),
        "exists": path.exists(),
        "sha256": None,
        "bytes": 0,
        "line_count": 0,
        "task_count": 0,
        "open_count": 0,
        "counts": {},
        "parse_errors": [],
    }
    if not path.exists():
        return summary
    raw = path.read_bytes()
    summary["sha256"] = hashlib.sha256(raw).hexdigest()
    summary["bytes"] = len(raw)
    for line_no, line in enumerate(raw.decode("utf-8", errors="replace").splitlines(), start=1):
        if not line.strip():
            continue
        summary["line_count"] += 1
        try:
            task = json.loads(line)
        except json.JSONDecodeError as exc:
            summary["parse_errors"].append({"line": line_no, "error": f"{exc.msg} at column {exc.colno}"})
            continue
        if not isinstance(task, dict):
            summary["parse_errors"].append({"line": line_no, "error": "non-object JSON value"})
            continue
        summary["task_count"] += 1
        status = str(task.get("status") or "unknown")
        summary["counts"][status] = summary["counts"].get(status, 0) + 1
        if status in OPEN_STATUSES:
            summary["open_count"] += 1
    return summary


def remote_task_ledger_summary(host: str, remote_state_dir: str) -> dict:
    remote_tasks = f"{remote_state_dir.rstrip('/')}/tasks.jsonl"
    script = "\n".join(
        [
            "import hashlib, json, pathlib, sys",
            "open_statuses = {'pending','claimed','blocked','pending-human','review-pending'}",
            "path = pathlib.Path(sys.argv[1])",
            "summary = {'path': str(path), 'exists': path.exists(), 'sha256': None, 'bytes': 0, 'line_count': 0, 'task_count': 0, 'open_count': 0, 'counts': {}, 'parse_errors': []}",
            "if path.exists():",
            "    raw = path.read_bytes()",
            "    summary['sha256'] = hashlib.sha256(raw).hexdigest()",
            "    summary['bytes'] = len(raw)",
            "    for line_no, line in enumerate(raw.decode('utf-8', errors='replace').splitlines(), start=1):",
            "        if not line.strip():",
            "            continue",
            "        summary['line_count'] += 1",
            "        try:",
            "            task = json.loads(line)",
            "        except json.JSONDecodeError as exc:",
            "            summary['parse_errors'].append({'line': line_no, 'error': f'{exc.msg} at column {exc.colno}'})",
            "            continue",
            "        if not isinstance(task, dict):",
            "            summary['parse_errors'].append({'line': line_no, 'error': 'non-object JSON value'})",
            "            continue",
            "        summary['task_count'] += 1",
            "        status = str(task.get('status') or 'unknown')",
            "        summary['counts'][status] = summary['counts'].get(status, 0) + 1",
            "        if status in open_statuses:",
            "            summary['open_count'] += 1",
            "print(json.dumps(summary, separators=(',', ':'), sort_keys=True))",
        ]
    )
    command = " ".join(shlex.quote(part) for part in ["python3", "-c", script, remote_tasks])
    proc = subprocess.run(
        [*ssh_base_command(10), host, command],
        text=True,
        capture_output=True,
        timeout=VPS_CANONICAL_TIMEOUT,
    )
    if proc.returncode != 0:
        raise RuntimeError((proc.stderr or proc.stdout).strip()[:500])
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"remote summary returned invalid JSON: {exc.msg}") from exc
    if not isinstance(payload, dict):
        raise RuntimeError("remote summary returned non-object JSON")
    return payload


def cmd_canonical_health(args: argparse.Namespace) -> None:
    local = summarize_task_ledger(TASKS)
    mirror_owed = mirror_owed_payload()
    remote_error = None
    try:
        remote = remote_task_ledger_summary(args.host, args.state_dir)
    except Exception as exc:
        remote = None
        remote_error = str(exc)
    checks = {
        "local_tasks_exists": bool(local.get("exists")),
        "remote_tasks_exists": bool(remote and remote.get("exists")),
        "local_parse_clean": not local.get("parse_errors"),
        "remote_parse_clean": bool(remote is not None and not remote.get("parse_errors")),
        "ledger_hash_match": bool(remote and local.get("sha256") == remote.get("sha256")),
        "status_counts_match": bool(remote and local.get("counts") == remote.get("counts")),
        "mirror_owed_clear": mirror_owed is None,
    }
    ok = all(checks.values())
    payload = {
        "ok": ok,
        "generated_at": now(),
        "host": args.host,
        "remote_state_dir": args.state_dir,
        "checks": checks,
        "local": local,
        "remote": remote,
        "remote_error": remote_error,
        "mirror_owed": mirror_owed,
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(f"canonical_health: {'ok' if ok else 'failed'}")
        print(f"local:  tasks={local.get('task_count')} open={local.get('open_count')} sha256={local.get('sha256')}")
        if remote:
            print(f"remote: tasks={remote.get('task_count')} open={remote.get('open_count')} sha256={remote.get('sha256')}")
        else:
            print(f"remote: error={remote_error}")
        for name, passed in checks.items():
            print(f"{name}: {'ok' if passed else 'failed'}")
        if mirror_owed:
            print(f"mirror_owed: failed {mirror_owed.get('path')} task_count={mirror_owed.get('task_count')} error={mirror_owed.get('error')}")
    if not ok:
        sys.exit(2)


def cmd_task_check(args: argparse.Namespace) -> None:
    paths = package_commit_paths(args.files or [])
    if not paths:
        print(f"task-check ok {args.task_id or '-'} no_package_files")
        return

    if args.ci:
        if not args.task_id:
            print("missing_task_trailer", file=sys.stderr)
            sys.exit(2)
        task = task_by_id(read_tasks(), args.task_id)
        if not task:
            print(f"task_not_found:{args.task_id}", file=sys.stderr)
            sys.exit(2)
        denial = task_file_coverage_denial(task, paths)
        if denial:
            print(denial, file=sys.stderr)
            sys.exit(2)
        print(f"task-check ok {args.task_id} ci")
        return

    committer_value = args.committer_role or args.committer
    committer_role = infer_committer_role(committer_value)
    if committer_role == "ayo":
        print(f"task-check ok {args.task_id or '-'} ayo_exempt")
        return
    if not args.task_id:
        print("missing_task_trailer", file=sys.stderr)
        sys.exit(2)
    if not committer_role:
        print("committer_role_unknown", file=sys.stderr)
        sys.exit(2)

    task = task_by_id(read_tasks(), args.task_id)
    if not task:
        print(f"task_not_found:{args.task_id}", file=sys.stderr)
        sys.exit(2)

    for denial in (
        task_check_status_denial(task, review_fix=args.review_fix),
        task_check_actor_denial(task, committer_role, review_fix=args.review_fix),
        task_file_coverage_denial(task, paths),
    ):
        if denial:
            print(denial, file=sys.stderr)
            sys.exit(2)

    print(f"task-check ok {args.task_id}")


def role_or_die(role: str) -> dict:
    roles = load_roles()
    if role not in roles:
        print(f"unknown role: {role}", file=sys.stderr)
        print("valid roles: " + ", ".join(sorted(roles)), file=sys.stderr)
        sys.exit(2)
    return roles[role]


def find_task(task_id: str) -> tuple[list[dict], dict]:
    tasks = read_tasks()
    for task in tasks:
        if task.get("id") == task_id:
            return tasks, task
    print(f"task not found: {task_id}", file=sys.stderr)
    sys.exit(2)


def task_by_id(tasks: list[dict], task_id: str) -> dict | None:
    for task in tasks:
        if task.get("id") == task_id:
            return task
    return None


def dependency_denial(tasks: list[dict], task: dict) -> str | None:
    for dep_id in task.get("depends_on") or []:
        dep = task_by_id(tasks, dep_id)
        if not dep:
            return f"missing_dependency:{dep_id}"
        if dep.get("status") != "complete":
            return f"dependency_not_complete:{dep_id}:{dep.get('status')}"
    return None


def task_created_before_plan_gate(task: dict) -> bool:
    created = parse_ts(task.get("created_at"))
    effective = parse_ts(PLAN_ARTIFACT_REQUIRED_AFTER)
    if not created or not effective:
        return True
    return created < effective


def plan_artifact_path(value: str | None) -> Path | None:
    if not value:
        return None
    path = Path(value).expanduser()
    if path.is_absolute():
        return path
    return STATE / path


def plan_artifact_denial(task: dict) -> str | None:
    if str(task.get("mode") or "").strip().lower() in {"review", "completion-review"}:
        return None
    risk_level = str(task.get("risk_level") or "low").casefold()
    if risk_level not in PLAN_ARTIFACT_REQUIRED_RISKS:
        return None
    if task_created_before_plan_gate(task):
        return None
    artifact = plan_artifact_path(task.get("plan_artifact"))
    if not artifact:
        return f"missing_plan_artifact:{risk_level}"
    if not artifact.exists():
        return f"missing_plan_artifact_path:{task.get('plan_artifact')}"
    return None


def review_required_path_match(path: str) -> str | None:
    normalized = str(path).strip().lstrip("./")
    for pattern in REVIEW_REQUIRED_PATHS:
        if fnmatch.fnmatch(normalized, pattern) or fnmatch.fnmatch(normalized, pattern.replace("**", "*")):
            return pattern
    return None


def completion_file_candidates(value: str, repo: str | None = None) -> set[str]:
    raw = str(value).strip()
    if not raw:
        return set()
    candidates = {raw.lstrip("./")}
    normalized = Path(normalize_task_file(raw, repo))
    for base in [Path(repo).expanduser() if repo else None, ROOT.parents[1]]:
        if not base:
            continue
        try:
            candidates.add(str(normalized.relative_to(base.resolve(strict=False))).lstrip("./"))
        except ValueError:
            continue
    return candidates


def completion_file_set(task: dict, files: list[str] | None) -> set[str]:
    repo = task.get("repo")
    raw_files = [
        *(task.get("files") or []),
        *(task.get("files_owned") or []),
        *(task.get("files_touched") or []),
        *(files or []),
    ]
    candidates: set[str] = set()
    for value in raw_files:
        candidates.update(completion_file_candidates(str(value), repo))
    return candidates


def completion_requires_path_review(task: dict, files: list[str] | None) -> bool:
    return any(review_required_path_match(path) for path in completion_file_set(task, files))


def git_run(repo: Path, *args: str, check: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", "-C", str(repo), *args],
        capture_output=True,
        text=True,
        check=check,
    )


def git_repo_root(path_value: str | None) -> Path | None:
    if not path_value:
        return None
    path = Path(path_value).expanduser()
    proc = git_run(path, "rev-parse", "--show-toplevel")
    if proc.returncode != 0:
        return None
    return Path(proc.stdout.strip()).expanduser()


def git_current_branch(repo: Path) -> str | None:
    proc = git_run(repo, "branch", "--show-current")
    if proc.returncode == 0 and proc.stdout.strip():
        return proc.stdout.strip()
    return None


def git_head_sha(repo: Path) -> str | None:
    proc = git_run(repo, "rev-parse", "HEAD")
    if proc.returncode == 0 and proc.stdout.strip():
        return proc.stdout.strip()
    return None


def git_ref_exists(repo: Path, ref: str) -> bool:
    proc = git_run(repo, "rev-parse", "--verify", "--quiet", ref)
    return proc.returncode == 0


def worktree_claim_denial(task: dict) -> str | None:
    repo = git_repo_root(task.get("repo"))
    if not repo:
        return f"worktree_repo_not_git:{task.get('repo')}"
    parent = repo / WORKTREE_DIR_NAME
    if git_run(repo, "check-ignore", "-q", f"{WORKTREE_DIR_NAME}/").returncode != 0:
        return f"worktree_parent_not_ignored:{parent}"
    worktree_path = parent / str(task.get("id"))
    if worktree_path.exists():
        return f"worktree_path_exists:{worktree_path}"
    branch = f"{WORKTREE_BRANCH_PREFIX}/{task.get('id')}"
    if git_ref_exists(repo, branch):
        return f"worktree_branch_exists:{branch}"
    return None


def create_task_worktree(task: dict) -> str | None:
    repo = git_repo_root(task.get("repo"))
    if not repo:
        return f"worktree_repo_not_git:{task.get('repo')}"
    parent = repo / WORKTREE_DIR_NAME
    parent.mkdir(parents=True, exist_ok=True)
    worktree_path = parent / str(task.get("id"))
    branch = f"{WORKTREE_BRANCH_PREFIX}/{task.get('id')}"
    proc = git_run(repo, "worktree", "add", "-b", branch, str(worktree_path))
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "unknown").strip().replace("\n", " ")
        return f"worktree_create_failed:{detail}"
    task["worktree_path"] = str(worktree_path)
    task["worktree_branch"] = branch
    task["worktree_base_branch"] = git_current_branch(repo)
    task["worktree_base_sha"] = git_head_sha(repo)
    task["worktree_claimed_at"] = now()
    return None


def worktree_completion_errors(task: dict, args: argparse.Namespace) -> list[str]:
    worktree_path = task.get("worktree_path")
    if not worktree_path:
        return []
    errors: list[str] = []
    repo = git_repo_root(task.get("repo"))
    if not repo:
        errors.append(f"worktree_repo_not_git:{task.get('repo')}")
        return errors
    pr_url = getattr(args, "pr_url", None) or task.get("pr_url")
    branch = task.get("worktree_branch")
    base_branch = task.get("worktree_base_branch")
    if not pr_url:
        if not branch or not base_branch:
            errors.append("worktree_merge_metadata_missing")
        elif not git_ref_exists(repo, branch):
            errors.append(f"worktree_branch_missing:{branch}")
        else:
            proc = git_run(repo, "merge-base", "--is-ancestor", branch, base_branch)
            if proc.returncode != 0:
                errors.append(f"worktree_branch_unmerged:{branch}")
    if Path(worktree_path).expanduser().exists():
        errors.append(f"worktree_not_removed:{worktree_path}")
    return errors


def active_halt() -> dict | None:
    if not HALT_FILE.exists():
        return None
    try:
        data = json.loads(HALT_FILE.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return {"active": True, "reason": "corrupt_halt_file"}
    if data.get("active"):
        return data
    return None


def normalize_task_file(path_value: str, repo: str | None = None) -> str:
    raw = Path(path_value).expanduser()
    if not raw.is_absolute() and repo:
        raw = Path(repo).expanduser() / raw
    try:
        return str(raw.resolve(strict=False))
    except OSError:
        return str(raw.absolute())


def task_owns_files(task: dict) -> bool:
    if task.get("files_owned"):
        return True
    mode = str(task.get("mode") or "").strip().lower()
    return mode not in READ_ONLY_FILE_MODES


def task_file_set(task: dict) -> set[str]:
    if not task_owns_files(task):
        return set()
    repo = task.get("repo")
    raw_files = task.get("files_owned") or task.get("files") or []
    return {normalize_task_file(value, repo) for value in raw_files if value}


def package_commit_paths(paths: list[str] | None) -> list[str]:
    seen: dict[str, None] = {}
    for raw_path in paths or []:
        path = str(raw_path).strip().replace("\\", "/").lstrip("./")
        if path.startswith(PACKAGE_COMMIT_PREFIX):
            seen[path] = None
    return list(seen)


def identity_role(identity: str) -> str | None:
    config = load_org_config()
    mapped = (config.get("agent_identities") or {}).get(identity)
    if isinstance(mapped, dict) and mapped.get("role"):
        return str(mapped["role"])
    return None


def infer_committer_role(raw_value: str | None = None) -> str | None:
    roles = load_roles()
    values = [
        raw_value,
        os.environ.get("AORG_COMMITTER_ROLE"),
        os.environ.get("APEX_AGENT_ROLE"),
        os.environ.get("AORG_COMMITTER_IDENTITY"),
        os.environ.get("APEX_AGENT_IDENTITY"),
    ]
    for value in values:
        if not value:
            continue
        normalized = str(value).strip().casefold()
        if normalized in roles:
            return normalized
        mapped = identity_role(str(value).strip())
        if mapped:
            return mapped
        if "codex" in normalized:
            return "codex"
        if "claude" in normalized:
            return "claude"
        if "ayo-fam" in normalized or "ayokunle" in normalized or normalized in {"ayo", "ayo famuagun"}:
            return "ayo"
    return None


def path_candidate_set(path_value: str, repo: str | None) -> set[str]:
    candidates = completion_file_candidates(path_value, repo)
    candidates.add(normalize_task_file(path_value, repo))
    return {candidate.replace("\\", "/").lstrip("./") for candidate in candidates if candidate}


def declaration_covers_path(declaration: str, changed_path: str, task_repo: str | None) -> bool:
    raw_declaration = str(declaration).strip()
    if not raw_declaration:
        return False
    changed_candidates = path_candidate_set(changed_path, str(PLATFORM_ROOT))
    declaration_candidates = path_candidate_set(raw_declaration, task_repo)
    if changed_candidates.intersection(declaration_candidates):
        return True

    for declared in declaration_candidates:
        declared_clean = declared.rstrip("/")
        if any(char in declared_clean for char in "*?["):
            if any(fnmatch.fnmatch(changed, declared_clean) for changed in changed_candidates):
                return True
            continue
        declared_path = Path(declared_clean)
        declaration_is_dir = raw_declaration.endswith("/") or declared_path.is_dir()
        if declaration_is_dir and any(changed.startswith(f"{declared_clean}/") for changed in changed_candidates):
            return True
    return False


def task_declared_files(task: dict) -> list[str]:
    values = [*(task.get("files_owned") or []), *(task.get("files") or [])]
    return list(dict.fromkeys(str(value) for value in values if str(value).strip()))


def task_file_coverage_denial(task: dict, paths: list[str]) -> str | None:
    declarations = task_declared_files(task)
    if not declarations:
        return "task_files_do_not_cover:" + (paths[0] if paths else "<none>")
    repo = task.get("repo")
    for path in paths:
        if not any(declaration_covers_path(declaration, path, repo) for declaration in declarations):
            return f"task_files_do_not_cover:{path}"
    return None


def task_check_status_denial(task: dict, *, review_fix: bool) -> str | None:
    status = str(task.get("status") or "")
    if status == "claimed":
        return None
    if review_fix and status == "review-pending":
        return None
    return f"task_not_claimed:{status or 'missing'}"


def task_check_actor_denial(task: dict, role: str, *, review_fix: bool) -> str | None:
    if role == "ayo":
        return None
    expected = task.get("assignee")
    if review_fix and task.get("status") == "review-pending":
        expected = task.get("reviewer") or other_frontier(str(task.get("assignee") or ""))
    if role != expected:
        return f"committer_assignee_mismatch:{role}:{expected or 'missing'}"
    return None


def file_ownership_denial(tasks: list[dict], task: dict) -> str | None:
    requested = task_file_set(task)
    if not requested:
        return None
    for other in tasks:
        if other.get("id") == task.get("id"):
            continue
        if other.get("status") not in ACTIVE_FILE_OWNER_STATUSES:
            continue
        owned = task_file_set(other)
        conflict = sorted(requested.intersection(owned))
        if conflict:
            return f"file_conflict:{other.get('id')}:{conflict[0]}"
    return None


def parse_shared_invariant(value: str, default_owner: str | None = None) -> dict:
    for sep in ("=", ":"):
        if sep in value:
            owner, invariant = value.split(sep, 1)
            owner = owner.strip()
            invariant = invariant.strip()
            return {"owner_task": owner or default_owner, "invariant": invariant}
    return {"owner_task": default_owner, "invariant": value.strip()}


def parse_shared_invariants(values: list[str] | None, default_owner: str | None = None) -> list[dict]:
    return [parse_shared_invariant(value, default_owner) for value in values or [] if value.strip()]


def sibling_parent_id(task: dict) -> str | None:
    return task.get("parent_task") or task.get("parent")


def sibling_assign_denial(tasks: list[dict], task: dict) -> str | None:
    parent_id = sibling_parent_id(task)
    if not parent_id:
        return None
    parent = task_by_id(tasks, parent_id)
    if not parent:
        return f"parent_not_found:{parent_id}"
    if not parent.get("shared_invariants"):
        return f"parent_missing_shared_invariants:{parent_id}"
    requested = task_file_set(task)
    if not requested:
        return None
    for sibling in tasks:
        if sibling.get("id") == task.get("id"):
            continue
        if sibling_parent_id(sibling) != parent_id:
            continue
        if sibling.get("status") in {"cancelled", "failed"}:
            continue
        conflict = sorted(requested.intersection(task_file_set(sibling)))
        if conflict:
            return f"sibling_file_conflict:{sibling.get('id')}:{conflict[0]}"
    return None


def parent_completion_sibling_errors(tasks: list[dict] | None, task: dict) -> list[str]:
    if not tasks:
        return []
    task_id = task.get("id")
    siblings = [
        candidate
        for candidate in tasks
        if sibling_parent_id(candidate) == task_id and candidate.get("status") not in {"cancelled", "failed"}
    ]
    if not siblings:
        return []
    errors: list[str] = []
    for sibling in siblings:
        if sibling.get("status") != "complete":
            errors.append(f"parent_sibling_not_complete:{sibling.get('id')}:{sibling.get('status')}")
    if errors:
        return errors
    latest_completed: datetime | None = None
    for sibling in siblings:
        completed = parse_ts(sibling.get("completed_at"))
        if not completed:
            errors.append(f"parent_sibling_completed_at_missing:{sibling.get('id')}")
            continue
        if latest_completed is None or completed > latest_completed:
            latest_completed = completed
    if errors or latest_completed is None:
        return errors
    for run in task.get("verification_runs") or []:
        if run.get("exit_code") != 0:
            continue
        completed = parse_ts(run.get("completed_at"))
        if completed and completed >= latest_completed:
            return []
    return ["parent_post_sibling_verification_missing"]


def parse_policy_end(value: str | None) -> datetime | None:
    if not value:
        return None
    if len(value) == 10:
        return datetime.fromisoformat(value).replace(tzinfo=timezone.utc) + timedelta(days=1)
    parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def role_policy_window_denial(role_name: str, mode: str | None = None) -> str | None:
    role = load_roles().get(role_name, {})
    window = role.get("policy_window") or {}
    end = parse_policy_end(window.get("end"))
    if end and current_datetime() >= end:
        if role_name == "claude" and mode not in {"review", "completion-review", "interactive-review", "architecture-review"}:
            return "policy_window_closed:claude_non_interactive"
    return None


# Council v2: the two frontier agents review each other's deliveries. Given the
# executor, the cross-reviewer is always the OTHER frontier agent.
FRONTIER_AGENTS = ("claude", "codex")
COUNCIL_REVIEW_ROUND_CAP = 2
OPERATOR_OVERRIDE_SCOPES = {"operator-override", "review-override", "self-review", "self_review_override"}


# --- Pillar 9: blind peer-review primitives (opt-in; additive; do NOT change decision logic) ---
FRONTIER_REVIEW_POOL = ("claude", "codex")
BLIND_DIR = STATE / "blind"


def reviewer_pool(exclude_author: str = "") -> list[str]:
    """Frontier review pool minus the author — the set a blind reviewer can be drawn from."""
    return [r for r in FRONTIER_REVIEW_POOL if r and r != exclude_author]


def pick_blind_reviewers(author: str, k: int = 2, round_id: str = "") -> list[str]:
    """Pick k non-author reviewers, rotated by round so the same agent isn't always first.
    NEW and intentionally NOT yet wired into create_review_task assignment (determinism risk)."""
    pool = reviewer_pool(author)
    if round_id and pool:
        rot = int(hashlib.sha256(round_id.encode()).hexdigest(), 16) % len(pool)
        pool = pool[rot:] + pool[:rot]
    return pool[: max(0, k)]


def alias_registry(round_id: str, members: list[str]) -> dict:
    """Sealed pseudonym map (Reviewer-A/B/C) for a blind round at STATE/blind/<round>.json.
    Pseudonyms rotate across rounds (hash of round_id+role), are distinct within a round, and
    reveal_at stays null until the decision locks (accountability preserved post-decision)."""
    BLIND_DIR.mkdir(parents=True, exist_ok=True)
    path = BLIND_DIR / f"{round_id}.json"
    if path.exists():
        try:
            return json.loads(path.read_text(encoding="utf-8"))
        except ValueError:
            pass
    ordered = list(dict.fromkeys([m for m in members if m]))
    n = max(1, len(ordered))
    taken: set[str] = set()
    alias_map: dict[str, str] = {}
    for role in ordered:
        base = int(hashlib.sha256(f"{round_id}:{role}".encode()).hexdigest(), 16)
        for off in range(n):
            letter = chr(ord("A") + (base + off) % n)
            if letter not in taken:
                taken.add(letter)
                alias_map[role] = f"Reviewer-{letter}"
                break
    reg = {
        "round_id": round_id,
        "alias_map": alias_map,
        "members": ordered,
        "reveal_at": None,
        "created_at": now(),
    }
    path.write_text(json.dumps(reg, indent=2), encoding="utf-8")
    return reg


def reveal_alias_registry(round_id: str) -> None:
    """Stamp reveal_at on a sealed round so its real identities are openable post-decision."""
    path = BLIND_DIR / f"{round_id}.json"
    if not path.exists():
        return
    try:
        reg = json.loads(path.read_text(encoding="utf-8"))
    except ValueError:
        return
    if reg.get("reveal_at") is None:
        reg["reveal_at"] = now()
        path.write_text(json.dumps(reg, indent=2), encoding="utf-8")


def cmd_blind_alias(args: argparse.Namespace) -> None:
    members_arg = args.members or ",".join(FRONTIER_REVIEW_POOL)
    members = [m.strip() for m in members_arg.split(",") if m.strip()]
    reg = alias_registry(args.round, members)
    if getattr(args, "reveal", False):
        reveal_alias_registry(args.round)
        reg = alias_registry(args.round, members)
    if getattr(args, "field", None):
        print(reg["alias_map"].get(args.field, ""))
    else:
        print(json.dumps(reg, indent=2))


def other_frontier(role: str) -> str:
    """Return the opposite frontier agent. claude<->codex. Falls back to claude."""
