                        *([f"- tokens_in: {task['tokens_in']}"] if task.get("tokens_in") is not None else []),
                        *([f"- tokens_out: {task['tokens_out']}"] if task.get("tokens_out") is not None else []),
                        *([f"- model: {task['cost_model']}"] if task.get("cost_model") else []),
                        "",
                    ]
                    if any(task.get(k) is not None for k in ("cost_usd", "tokens_in", "tokens_out", "cost_model"))
                    else []
