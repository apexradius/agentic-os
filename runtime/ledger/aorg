def cmd_assign(args: argparse.Namespace) -> None:
    role_or_die(args.assignee)
    ensure_state()
    allowlist_identity = identity_for_task(args.assignee, args.allowlist_identity)
    task_id = f"aorg-{datetime.now().strftime('%Y%m%d-%H%M%S')}-{args.assignee}-{uuid4().hex[:6]}"
    risk_level = args.risk_level.lower()
    review_required = bool(args.review_required)
    task = {
        "id": task_id,
        "title": args.title,
        "task": args.task,
        "assignee": args.assignee,
        "priority": args.priority,
        "status": "pending",
        "created_at": now(),
        "created_by": args.created_by,
        "repo": args.repo,
        "files": args.files or [],
        "mode": args.mode,
        "blocked_reason": None,
        "escalation_to": args.escalation_to,
        "depends_on": args.depends_on or [],
        "token_required": args.token_required,
        "allowlist_identity": allowlist_identity,
        "constraints": args.constraints or ["No secrets in output", "Record verification evidence"],
        "acceptance_criteria": args.acceptance_criteria or DEFAULT_ACCEPTANCE_CRITERIA,
        "verification_command": args.verification_command,
        "verification_evidence_required": args.verification_evidence_required or [],
        "review_required": review_required,
        # Council v2: cross-reviewer defaults to the OTHER frontier agent than the executor.
        "reviewer": (args.reviewer or other_frontier(args.assignee)) if review_required else None,
        "risk_level": risk_level,
        "plan_artifact": args.plan_artifact,
        "sandbox_profile": args.sandbox_profile,
    }
    if args.parent:
        task["parent_task"] = args.parent
    shared_invariants = parse_shared_invariants(args.shared_invariant, task_id)
    if shared_invariants:
        task["shared_invariants"] = shared_invariants
    apply_sandbox_defaults(task)
    apply_scope_risk(task)
    denial = dispatch_denial(task)
    sibling_denial = None
    if args.parent:
        sibling_denial = sibling_assign_denial(read_tasks(), task)
    if args.dry_run:
        if denial or sibling_denial:
            if denial:
                print(f"BLOCKED {denial[0]} {denial[1]}")
            if sibling_denial:
                print(f"BLOCKED {sibling_denial}")
            print(json.dumps(task, indent=2))
            return
        print(json.dumps(task, indent=2))
        return
    if sibling_denial:
        print(f"assign rejected: {sibling_denial}", file=sys.stderr)
        sys.exit(2)
    if denial:
        task["status"] = "pending-human"
        task["blocked_reason"] = f"{denial[0]} {denial[1]}"
        task["escalation_to"] = args.escalation_to or "ayo"
    with task_write_lock():
        tasks = read_tasks_unlocked()
        sibling_denial = sibling_assign_denial(tasks, task)
        if sibling_denial:
            print(f"assign rejected: {sibling_denial}", file=sys.stderr)
            sys.exit(2)
        tasks.append(task)
        write_tasks_unlocked(tasks)
    if denial:
        append_jsonl(
            STATE / "escalations.jsonl",
            {
                "task_id": task_id,
                "reason": task["blocked_reason"],
                "evidence": str(POLICY_DIR / f"{allowlist_identity}.allow.toml"),
                "priority": args.priority,
                "escalation_to": task["escalation_to"],
                "requesting_identity": allowlist_identity,
                "timestamp": task["created_at"],
                **sidecar_owner_fields(allowlist_identity),
            },
        )
        print(f"{task_id} BLOCKED {denial[0]} {denial[1]}")
    else:
        print(task_id)


