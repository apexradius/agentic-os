def pause_tasks(reason: str, by: str) -> int:
    halt = {"active": True, "reason": reason, "paused_at": now(), "paused_by": by}
    with task_write_lock():
        tasks = read_tasks_unlocked()
        changed = 0
        for task in tasks:
            if task.get("status") not in {"claimed", "running"}:
                continue
            task["halted_previous_status"] = task.get("status")
            task["status"] = "blocked"
            task["blocked_reason"] = f"halt:{reason}"
            task["halted_at"] = halt["paused_at"]
            changed += 1
        write_text_atomic(HALT_FILE, json.dumps(halt, separators=(",", ":")) + "\n")
        write_tasks_unlocked(tasks)
    append_jsonl(STATE / "halts.jsonl", {**halt, "affected_tasks": changed})
    return changed


def resume_tasks(by: str) -> int:
    previous_halt = active_halt()
    with task_write_lock():
        tasks = read_tasks_unlocked()
        changed = 0
        for task in tasks:
            if str(task.get("blocked_reason") or "").startswith("halt:") and task.get("halted_previous_status"):
                task["status"] = task.pop("halted_previous_status")
                task["resumed_at"] = now()
                task["resumed_by"] = by
                task["blocked_reason"] = None
                changed += 1
        write_text_atomic(
            HALT_FILE,
            json.dumps(
                {
                    "active": False,
                    "resumed_at": now(),
                    "resumed_by": by,
                    "previous_halt": previous_halt,
                    "affected_tasks": changed,
                },
                separators=(",", ":"),
            )
            + "\n",
        )
        write_tasks_unlocked(tasks)
    append_jsonl(STATE / "halts.jsonl", {"active": False, "resumed_at": now(), "resumed_by": by, "affected_tasks": changed})
    return changed


