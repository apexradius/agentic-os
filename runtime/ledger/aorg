DIRECTIVE_DECISION_RE = re.compile(
    r"\b(?:KEEP|ADOPT|COPY|DEFER|REJECT)\b|(?:\*\*(?:KEEP|ADOPT|COPY|DEFER|REJECT)\s*:?\*\*)",
    re.IGNORECASE,
)
DIRECTIVE_Q2_RE = re.compile(r"\b(?:Q2|P[0-4]|revenue|merchant|client|contract|MRR)\b", re.IGNORECASE)
DIRECTIVE_QA_RE = re.compile(r"\b(?:QA\s*gate|quality\s*gate|proof\s*gate|gate:|verification|acceptance|evidence)\b", re.IGNORECASE)
DIRECTIVE_RISK_RE = re.compile(r"\b(?:risk|risks|blast radius|rollback)\b", re.IGNORECASE)
DIRECTIVE_VNA_RE = re.compile(r"\b(?:VNA|Very Next Action|Next Codex action)\b", re.IGNORECASE)


def gemini_directive_candidates() -> list[Path]:
    candidates: list[Path] = []
    if REPORTS.exists():
        for path in REPORTS.glob("*.md"):
            lower = path.name.lower()
            if "review-claude" in lower or "claude-review" in lower:
                continue
            if lower.startswith("proxy-") or "evidence" in lower:
                continue
            if "directive" in lower or "council-decision" in lower:
                candidates.append(path)
    for path in iter_doctor_files(
        lambda candidate: candidate.suffix.lower() == ".md"
        and ("gemini" in candidate.name.lower() or "directive" in candidate.name.lower())
    ):
        lower_parts = {part.lower() for part in path.parts}
        if lower_parts & {"backups", "archive", "archives", ".archive", ".archived"}:
            continue
        if path not in candidates:
            candidates.append(path)
    return sorted(candidates)


def directive_schema_missing(text: str) -> list[str]:
    checks = [
        ("decision", DIRECTIVE_DECISION_RE),
        ("q2_priority", DIRECTIVE_Q2_RE),
        ("qa_gate", DIRECTIVE_QA_RE),
        ("risk", DIRECTIVE_RISK_RE),
        ("vna", DIRECTIVE_VNA_RE),
    ]
    return [name for name, pattern in checks if not pattern.search(text)]


def run_gemini_directive_schema_doctor(results: list[tuple[str, str, str]]) -> None:
    candidates = gemini_directive_candidates()
    checked = 0
    invalid: list[str] = []
    for path in candidates:
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        lower_name = path.name.lower()
        is_directive = "directive" in lower_name or "council-decision" in lower_name or any(
            token in text
            for token in ("Decision Table", "Architectural Decisions", "Candidate Rankings", "Implementation Tasks")
        )
        if not is_directive:
            continue
        checked += 1
        missing = directive_schema_missing(text)
        if missing:
            invalid.append(f"{workspace_rel(path)} missing={','.join(missing)}")
    if checked == 0:
        doctor_report(results, "PASS", "Council directive schema", "no current Council directive candidates")
        return
    detail = f"checked={checked} invalid={len(invalid)}"
    if invalid:
        detail += " sample=" + " | ".join(invalid[:3])
        doctor_report(results, "WARN", "Council directive schema", detail)
    else:
        doctor_report(results, "PASS", "Council directive schema", detail)


