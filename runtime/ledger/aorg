    if role == "claude":
        return "codex"
    return "claude"


def approval_by_ayo_with_override_scope(*tasks: dict | None) -> bool:
    for task in tasks:
        if not task:
            continue
        for approval in task.get("approvals") or []:
            if not isinstance(approval, dict):
                continue
            if (
                approval.get("approved_by") == "ayo"
                and approval.get("scope") in OPERATOR_OVERRIDE_SCOPES
            ):
                return True
    return False


def review_self_denial(task: dict, parent: dict | None, args: argparse.Namespace) -> str | None:
    if task.get("mode") != "completion-review" or not parent:
        return None
    implementer_roles = {parent.get("assignee"), parent.get("claimed_by")}
    actor_identity = str(parent.get("completion_actor_identity") or "")
    if actor_identity:
        for role in FRONTIER_AGENTS:
            if actor_identity == role or actor_identity.startswith(f"{role}-"):
                implementer_roles.add(role)
    if args.role not in implementer_roles:
        return None
    if getattr(args, "operator_override", False) and approval_by_ayo_with_override_scope(task, parent):
        return None
    if getattr(args, "operator_override", False):
        return "self_review_denied:operator_override_requires_ayo_approval"
    return "self_review_denied"


