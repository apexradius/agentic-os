def normalize_ollama_model_name(model: str) -> str:
    aliases = {
        "apex-codex:latest": "gemma4:26b",
        "apex-general:latest": "gemma4:e4b",
        "gemma3:latest": "gemma4:e4b",
        "gemma-4-e4b-it": "gemma4:e4b",
        "google/gemma-4-e4b": "gemma4:e4b",
        "gpt-oss:20b": "gemma4:e4b",
    }
    return aliases.get(model, model)


def run_ollama_chat(model: str, prompt: str, timeout: int, role: str) -> subprocess.CompletedProcess[str]:
    ollama_cmd = ["ollama", "run"]
    normalized_model = normalize_ollama_model_name(model)
    ollama_cmd.append(normalized_model)
    return subprocess.run(
        ollama_cmd,
        input=prompt,
        text=True,
        capture_output=True,
        timeout=timeout,
    )


def cmd_run_local(args: argparse.Namespace) -> None:
    role = role_or_die(args.role)
    if args.role != "gemma":
        print("run-local is only for the gemma local critic role", file=sys.stderr)
        sys.exit(2)
    canonical_local = local_default_state_uses_vps_canonical()
    if canonical_local:
        sync_proc = subprocess.run([str(Path(__file__).resolve()), "sync-from-vps"], text=True)
        if sync_proc.returncode != 0:
            print("canonical run-local preflight sync failed", file=sys.stderr)
            sys.exit(sync_proc.returncode)
    tasks, task = find_task(args.task_id)
    if task.get("assignee") != args.role:
        print(f"task assigned to {task.get('assignee')}, not {args.role}", file=sys.stderr)
        sys.exit(2)
    if task.get("status") == "pending":
        if canonical_local:
            claim_rc = proxy_to_vps_canonical(["claim", args.role, args.task_id])
            if claim_rc != 0:
                sys.exit(claim_rc)
            sync_proc = subprocess.run([str(Path(__file__).resolve()), "sync-from-vps"], text=True)
            if sync_proc.returncode != 0:
                print("canonical run-local post-claim sync failed", file=sys.stderr)
                sys.exit(sync_proc.returncode)
            tasks, task = find_task(args.task_id)
        else:
            task["status"] = "claimed"
            task["claimed_at"] = now()
            task["claimed_by"] = args.role
            task["last_heartbeat_at"] = task["claimed_at"]
            task["last_heartbeat_by"] = args.role
            liveness = task_liveness_metadata(args)
            task["claimed_by_host"] = liveness["host"]
            if liveness.get("pid"):
                task["claimed_by_pid"] = liveness["pid"]
            task["last_heartbeat_host"] = liveness["host"]
            if liveness.get("pid"):
                task["last_heartbeat_pid"] = liveness["pid"]
            write_tasks(tasks)

    model = args.model or OLLAMA_DEFAULT_MODEL
    context_parts: list[str] = []
    for raw_path in args.context or []:
        path = Path(raw_path)
        if not path.exists() or not path.is_file():
            context_parts.append(f"\n[missing context file: {raw_path}]\n")
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        if len(text) > args.max_chars:
            text = text[: args.max_chars] + "\n[truncated]\n"
        context_parts.append(f"\n## Context File: {path}\n\n{text}\n")

    prompt = "\n".join(
        [
            f"You are {args.role}: {role['display']} in the Apex AI coding organization.",
            f"Authority: {role['authority']}.",
            "Do not include secrets. If context contains secret-looking values, redact them.",
            "Return a concise report with: Result, Findings, Verification, Risks, VNA.",
            "",
            f"Task ID: {task['id']}",
            f"Title: {task.get('title')}",
            f"Task: {task.get('task')}",
            f"Repo: {task.get('repo')}",
            f"Files: {', '.join(task.get('files', []))}",
            "",
            "".join(context_parts),
        ]
    )

    report = REPORTS / f"{args.task_id}-{args.role}-local.md"
    started = now()
    proc = run_ollama_chat(model, prompt, args.timeout, args.role)
    completed = now()
    report.write_text(proc.stdout or proc.stderr, encoding="utf-8")

    if canonical_local:
        if proc.returncode == 0:
            summary = f"Local {args.role} report written to {report}"
            complete_args = [
                "complete",
                args.role,
                args.task_id,
                "--summary",
                summary,
                "--evidence",
                str(report),
                "--acceptance-met",
                *task_acceptance_criteria(task),
                "--risk",
                "local model run",
                "--vna",
                "Review the local model report and dispatch follow-up implementation or review work if needed.",
            ]
            complete_rc = proxy_to_vps_canonical(complete_args)
            if complete_rc != 0:
                sys.exit(complete_rc)
            sync_proc = subprocess.run([str(Path(__file__).resolve()), "sync-from-vps"], text=True)
            if sync_proc.returncode != 0:
                print("canonical run-local completion recorded, but local cache refresh failed", file=sys.stderr)
                sys.exit(sync_proc.returncode)
            print(summary)
            return
        block_reason = f"Local {args.role} run failed; see {report}"
        block_rc = proxy_to_vps_canonical(["block", args.role, args.task_id, "--reason", block_reason, "--escalation-to", "codex"])
        if block_rc != 0:
            sys.exit(block_rc)
        sync_proc = subprocess.run([str(Path(__file__).resolve()), "sync-from-vps"], text=True)
        if sync_proc.returncode != 0:
            print("canonical run-local failure recorded, but local cache refresh failed", file=sys.stderr)
            sys.exit(sync_proc.returncode)
        print(block_reason)
        sys.exit(proc.returncode)

    tasks, task = find_task(args.task_id)
    task["completed_at"] = completed
    task["started_at"] = task.get("started_at", started)
    task["result_file"] = str(report)
    task["exit_code"] = proc.returncode
    if proc.returncode == 0:
        task["summary"] = f"Local {args.role} report written to {report}"
        task["evidence"] = [str(report)]
        task["acceptance_met"] = task_acceptance_criteria(task)
        if task.get("review_required") and not task.get("review_passed"):
            reviewer = task.get("reviewer") or other_frontier(task.get("assignee", ""))
            task["status"] = "review-pending"
            task["blocked_reason"] = f"completion_review_required:{reviewer}"
            create_review_task(tasks, task, reviewer)
        else:
            task["status"] = "complete"
    else:
        task["status"] = "failed"
        task["summary"] = f"Local {args.role} run failed; see {report}"
    write_tasks(tasks)
    print(task["summary"])


def task_trajectory_text(task: dict) -> str:
    return " ".join(
        redact_text(value, max_chars=2000)
        for value in [
            task.get("id"),
            task.get("title"),
            task.get("task"),
            task.get("summary"),
            task.get("risk"),
            task.get("vna"),
            task.get("files_touched"),
        ]
    ).casefold()


def task_matches_trajectory_filters(task: dict, args: argparse.Namespace, since: datetime | None) -> bool:
    if task.get("status") != "complete":
        return False
    completed = parse_ts(task.get("completed_at"))
    if since and (not completed or completed < since):
        return False
    if args.assignee and task.get("assignee") not in set(args.assignee):
        return False
    if args.priority and task.get("priority") not in set(args.priority):
        return False
    if args.contains:
        haystack = task_trajectory_text(task)
        if not all(term.casefold() in haystack for term in args.contains):
            return False
    return True


def task_trajectory_record(task: dict) -> dict:
    verification_runs = []
    for run in task.get("verification_runs", [])[-3:]:
        verification_runs.append(
            {
                "command": redact_text(run.get("command"), max_chars=500),
                "cwd": redact_text(run.get("cwd"), max_chars=300),
                "exit_code": run.get("exit_code"),
                "evidence": redact_text(run.get("evidence"), max_chars=500),
            }
        )
    return {
        "id": task.get("id"),
        "title": redact_text(task.get("title"), max_chars=240),
        "assignee": task.get("assignee"),
        "priority": task.get("priority"),
        "mode": task.get("mode"),
        "repo": redact_text(task.get("repo"), max_chars=300),
        "completed_at": task.get("completed_at"),
        "sandbox_profile": task.get("sandbox_profile"),
        "risk_level": task.get("risk_level"),
        "summary": redact_text(task.get("summary"), max_chars=900),
        "acceptance_met": [redact_text(item, max_chars=240) for item in task.get("acceptance_met", [])],
        "files_touched": [redact_text(item, max_chars=300) for item in task.get("files_touched", [])],
        "evidence": [redact_text(item, max_chars=300) for item in task.get("evidence", [])],
        "verification_runs": verification_runs,
        "risk": redact_text(task.get("risk"), max_chars=500),
        "vna": redact_text(task.get("vna"), max_chars=700),
    }


def build_trajectory_payload(tasks: list[dict], args: argparse.Namespace, since: datetime | None) -> dict:
    selected = [task for task in tasks if task_matches_trajectory_filters(task, args, since)]
    selected.sort(key=lambda task: (task.get("completed_at") or "", task.get("id") or ""), reverse=True)
    if args.limit:
        selected = selected[: args.limit]
    source_hash = hashlib.sha256(TASKS.read_bytes()).hexdigest() if TASKS.exists() else None
    return {
        "source": str(TASKS),
        "source_sha256": source_hash,
        "report_content_included": False,
        "filters": {
            "since": args.since,
            "assignee": args.assignee or [],
            "priority": args.priority or [],
            "contains": args.contains or [],
            "limit": args.limit,
        },
        "task_count": len(selected),
        "trajectories": [task_trajectory_record(task) for task in selected],
    }


def render_trajectory_markdown(payload: dict) -> str:
    lines = [
        "# AORG Trajectory Context Pack",
        "",
        f"Source: `{payload.get('source')}`",
        f"Source SHA-256: `{payload.get('source_sha256')}`",
        "Report content included: `false`",
        "",
        "## Filters",
    ]
    for key, value in payload.get("filters", {}).items():
        lines.append(f"- {key}: `{value}`")
    lines.extend(["", "## Summary", f"- Completed trajectories selected: {payload.get('task_count', 0)}", ""])

    if not payload.get("trajectories"):
        lines.append("No completed tasks matched the filters.")
        return "\n".join(lines).rstrip() + "\n"

    lines.append("## Trajectories")
    for item in payload["trajectories"]:
        lines.extend(
            [
                "",
                f"### {item.get('id')} - {item.get('title')}",
                f"- Assignee: `{item.get('assignee')}`",
                f"- Priority: `{item.get('priority')}`",
                f"- Mode: `{item.get('mode')}`",
                f"- Completed: `{item.get('completed_at')}`",
                f"- Sandbox: `{item.get('sandbox_profile')}`",
                f"- Risk level: `{item.get('risk_level')}`",
                "",
                "Result:",
                item.get("summary") or "None recorded",
                "",
                "Acceptance:",
            ]
        )
        lines.extend(f"- {value}" for value in (item.get("acceptance_met") or ["None recorded"]))
        lines.extend(["", "Files touched:"])
        lines.extend(f"- `{value}`" for value in (item.get("files_touched") or ["None recorded"]))
        lines.extend(["", "Evidence paths:"])
        lines.extend(f"- `{value}`" for value in (item.get("evidence") or ["None recorded"]))
        if item.get("verification_runs"):
            lines.extend(["", "Verification runs:"])
            for run in item["verification_runs"]:
                lines.append(f"- `{run.get('command')}` exit={run.get('exit_code')} evidence=`{run.get('evidence')}`")
        lines.extend(["", "Residual risk:", item.get("risk") or "None recorded", "", "VNA:", item.get("vna") or "None recorded"])
    return "\n".join(lines).rstrip() + "\n"


def cmd_trajectory_pack(args: argparse.Namespace) -> None:
    if args.since and not parse_filter_ts(args.since):
        print(f"invalid --since timestamp: {args.since}", file=sys.stderr)
        sys.exit(2)
    if not args.no_sync and local_start_uses_vps_canonical():
        proc = subprocess.run(
            [str(Path(__file__).resolve()), "sync-from-vps"],
            text=True,
            capture_output=True,
            timeout=VPS_CANONICAL_TIMEOUT,
        )
        if proc.returncode != 0:
            print(f"trajectory-pack sync-from-vps failed: {(proc.stderr or proc.stdout).strip()}", file=sys.stderr)
            sys.exit(proc.returncode)
    since = parse_filter_ts(args.since)
    payload = build_trajectory_payload(read_tasks(), args, since)
    rendered = json.dumps(payload, indent=2, sort_keys=True) + "\n" if args.json else render_trajectory_markdown(payload)
    if args.output:
        output_path = safe_output_path(args.output)
        output_path.parent.mkdir(parents=True, exist_ok=True)
        output_path.write_text(rendered, encoding="utf-8")
        print(output_path)
        return
    print(rendered, end="")


