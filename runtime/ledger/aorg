def cmd_verify(args: argparse.Namespace) -> None:
    role_or_die(args.role)
    if local_default_state_uses_vps_canonical():
        sync_proc = subprocess.run([str(Path(__file__).resolve()), "sync-from-vps"], text=True)
        if sync_proc.returncode != 0:
            print("canonical verify preflight sync failed", file=sys.stderr)
            sys.exit(sync_proc.returncode)
    tasks, task = find_task(args.task_id)
    if task.get("assignee") != args.role and task.get("claimed_by") != args.role:
        print(f"task assigned to {task.get('assignee')}, not {args.role}", file=sys.stderr)
        sys.exit(2)
    command = args.command or task.get("verification_command")
    if not command:
        print("no verification command supplied or recorded on task", file=sys.stderr)
        sys.exit(2)
    command = normalize_verification_command(command)
    allowlist_identity = identity_for_task(args.role, task.get("allowlist_identity"))
    denial = verification_command_denial(command, allowlist_identity)
    if denial:
        print(f"verification command denied: {denial[0]} {denial[1]}", file=sys.stderr)
        sys.exit(2)
    repo = local_verification_repo(Path(args.cwd or task.get("repo") or WORKSPACE).expanduser())
    env = os.environ.copy()
    env.setdefault("PYTHONPYCACHEPREFIX", str(TMP_ROOT / "aorg-pycache"))
    started = now()
    proc = subprocess.run(
        [os.environ.get("SHELL", "zsh"), "-lc", command],
        cwd=str(repo),
        env=env,
        text=True,
        capture_output=True,
        timeout=args.timeout,
    )
    completed = now()
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    evidence = REPORTS / f"{args.task_id}-verification-{stamp}.log"
    evidence.write_text(
        "\n".join(
            [
                f"task_id={args.task_id}",
                f"role={args.role}",
                f"started={started}",
                f"completed={completed}",
                f"cwd={repo}",
                f"exit_code={proc.returncode}",
                f"command={command}",
                "",
                "## STDOUT",
                proc.stdout,
                "",
                "## STDERR",
                proc.stderr,
                "",
            ]
        ),
        encoding="utf-8",
    )
    with task_write_lock():
        tasks = read_tasks_unlocked()
        task = task_by_id(tasks, args.task_id)
        if not task:
            print(f"task not found after verification: {args.task_id}", file=sys.stderr)
            sys.exit(2)
        task.setdefault("verification_runs", []).append(
            {
                "command": command,
                "cwd": str(repo),
                "exit_code": proc.returncode,
                "started_at": started,
                "completed_at": completed,
                "evidence": str(evidence),
            }
        )
        task["last_verification_exit_code"] = proc.returncode
        task["last_verification_evidence"] = str(evidence)
        if task.get("status") == "claimed":
            task["last_heartbeat_at"] = completed
            task["last_heartbeat_by"] = args.role
            liveness = task_liveness_metadata(args)
            task["last_heartbeat_host"] = liveness["host"]
            if liveness.get("pid"):
                task["last_heartbeat_pid"] = liveness["pid"]
        write_tasks_unlocked(tasks)
    if local_default_state_uses_vps_canonical():
        record_rc = proxy_to_vps_canonical(
            [
                "record-verification",
                args.role,
                args.task_id,
                "--command",
                command,
                "--cwd",
                str(repo),
                "--exit-code",
                str(proc.returncode),
                "--started-at",
                started,
                "--completed-at",
                completed,
                "--evidence",
                str(evidence),
            ]
        )
        if record_rc != 0:
            print("canonical verification receipt failed to record on VPS", file=sys.stderr)
            sys.exit(record_rc)
        sync_proc = subprocess.run([str(Path(__file__).resolve()), "sync-from-vps"], text=True)
        if sync_proc.returncode != 0:
            print("canonical verification receipt recorded, but local cache refresh failed", file=sys.stderr)
            sys.exit(sync_proc.returncode)
    print(f"verification exit_code={proc.returncode}")
    print(evidence)
    if proc.returncode != 0:
        sys.exit(proc.returncode)


