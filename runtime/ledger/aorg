def doctor_command(command: list[str], *, cwd: Path | None = None, timeout: int = 30) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, cwd=str(cwd) if cwd else None, text=True, capture_output=True, timeout=timeout)


def doctor_report(results: list[tuple[str, str, str]], status: str, name: str, detail: str) -> None:
    results.append((status, name, detail))
    print(f"{status}: {name}: {detail}")


def command_excerpt(proc: subprocess.CompletedProcess[str], limit: int = 220) -> str:
    text = (proc.stdout or proc.stderr or "").strip().replace("\n", " ")
    if len(text) > limit:
        return text[: limit - 3] + "..."
    return text


def doctor_ssh_command(command: str, *, timeout: int = 30) -> subprocess.CompletedProcess[str]:
    return doctor_command([*ssh_base_command(10), VPS_SSH_TARGET, command], timeout=timeout)


def parse_systemctl_show(output: str) -> dict[str, str]:
    props: dict[str, str] = {}
    for line in output.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        props[key] = value
    return props


def run_hermes_runtime_doctor(results: list[tuple[str, str, str]]) -> None:
    show_cmd = (
        'uid="$(id -u hermes 2>/dev/null || true)"; '
        'if [ -z "$uid" ]; then echo "HermesUser=missing"; exit 0; fi; '
        'sudo -u hermes XDG_RUNTIME_DIR=/run/user/$uid systemctl --user show hermes-gateway.service '
        '-p LoadState -p ActiveState -p SubState -p MainPID -p Restart -p NoNewPrivileges -p FragmentPath -p ControlGroup'
    )
    show_proc = doctor_ssh_command(show_cmd, timeout=30)
    if show_proc.returncode != 0:
        doctor_report(results, "WARN", "Hermes runtime", command_excerpt(show_proc) or f"ssh_exit={show_proc.returncode}")
        return

    props = parse_systemctl_show(show_proc.stdout)
    if props.get("HermesUser") == "missing":
        doctor_report(results, "PASS", "Hermes runtime", "hermes user missing; no runtime boundary present")
        return

    active_state = props.get("ActiveState", "unknown")
    load_state = props.get("LoadState", "unknown")
    if active_state != "active":
        doctor_report(results, "PASS", "Hermes runtime", f"user unit {load_state}/{active_state}")
        return

    control_group = props.get("ControlGroup", "")
    process_proc = doctor_ssh_command(
        f"cat /sys/fs/cgroup{shlex.quote(control_group)}/cgroup.procs 2>/dev/null || true",
        timeout=20,
    )
    listener_proc = doctor_ssh_command('ss -ltnp | grep -E "3010|hermes" || true', timeout=20)
    main_pid = props.get("MainPID", "")
    journal_pid_filter = f" _PID={shlex.quote(main_pid)}" if main_pid.isdigit() and main_pid != "0" else ""
    log_cmd = (
        'uid="$(id -u hermes 2>/dev/null || true)"; '
        'sudo -u hermes XDG_RUNTIME_DIR=/run/user/$uid journalctl --user -u hermes-gateway.service -n 120 --no-pager '
        f'{journal_pid_filter} | grep -E "ERROR|WARNING|not a valid SQLite|stuck|disk I/O" || true'
    )
    log_proc = doctor_ssh_command(log_cmd, timeout=30)

    process_lines = [line for line in process_proc.stdout.splitlines() if line.strip()]
    local_3010 = "127.0.0.1:3010" in listener_proc.stdout
    logs = log_proc.stdout
    issues: list[str] = []
    if props.get("NoNewPrivileges") != "yes":
        issues.append("no_new_privileges=off")
    if "not a valid SQLite" in logs or "disk I/O error" in logs:
        issues.append("kanban_db_corrupt")
    if "dispatcher stuck" in logs:
        issues.append("dispatcher_stuck")
    if not local_3010:
        issues.append("local_port_3010_not_seen")

    detail = (
        "quarantine keep; "
        f"unit={active_state}/{props.get('SubState', 'unknown')} "
        f"pid={props.get('MainPID', 'unknown')} restart={props.get('Restart', 'unknown')} "
        f"processes={len(process_lines)} local_port_3010={str(local_3010).lower()}"
    )
    if issues:
        detail += f" issues={','.join(issues)}"
        doctor_report(results, "WARN", "Hermes runtime", detail)
    else:
        doctor_report(results, "PASS", "Hermes runtime", detail)


def run_discord_bridge_doctor(results: list[tuple[str, str, str]]) -> None:
    show_cmd = (
        "systemctl show apex-discord-bridge.service "
        "-p LoadState -p ActiveState -p SubState -p MainPID -p User -p Restart -p NoNewPrivileges -p FragmentPath"
