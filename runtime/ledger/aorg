    if role.get("default_allowlist_identity"):
        return role["default_allowlist_identity"]
    return f"{assignee}-local"


def load_policy(identity: str) -> dict:
    path = POLICY_DIR / f"{identity}.allow.toml"
    if not path.exists():
        return {}
    if tomllib is None:
        return load_simple_toml_policy(path)
    with path.open("rb") as f:
        return tomllib.load(f)


def load_simple_toml_policy(path: Path) -> dict:
    data: dict[str, dict] = {}
    section: dict | None = None
    pending_key: str | None = None
    pending_values: list[str] = []
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.split("#", 1)[0].strip()
        if not line:
            continue
        if pending_key:
            if line.startswith("]"):
                section[pending_key] = pending_values if section is not None else pending_values
                pending_key = None
                pending_values = []
                continue
            value = line.rstrip(",").strip()
            if value.startswith('"') and value.endswith('"'):
                pending_values.append(value[1:-1])
            continue
        if line.startswith("[") and line.endswith("]"):
            section_name = line[1:-1].strip()
            section = data.setdefault(section_name, {})
            continue
        if section is None or "=" not in line:
            continue
        key, value = [part.strip() for part in line.split("=", 1)]
        if value == "[":
            pending_key = key
            pending_values = []
        elif value.startswith("[") and value.endswith("]"):
            items = []
            for item in value[1:-1].split(","):
                item = item.strip()
                if item.startswith('"') and item.endswith('"'):
                    items.append(item[1:-1])
            section[key] = items
        elif value in {"true", "false"}:
            section[key] = value == "true"
        elif value.startswith('"') and value.endswith('"'):
            section[key] = value[1:-1]
        else:
            section[key] = value
    return data


def any_match(value: str, patterns: list[str]) -> str | None:
    for pattern in patterns:
        if fnmatch.fnmatch(value, pattern) or fnmatch.fnmatch(value, pattern.replace("**", "*")):
            return pattern
    return None


def any_casefold_match(value: str, patterns: list[str]) -> str | None:
    folded = value.casefold()
    for pattern in patterns:
        folded_pattern = pattern.casefold()
        if fnmatch.fnmatch(folded, folded_pattern) or fnmatch.fnmatch(folded, folded_pattern.replace("**", "*")):
            return pattern
    return None


def normalize_verification_command(command: str) -> str:
    return " ".join(command.strip().split())


def verification_command_denial(command: str, identity: str | None) -> tuple[str, str] | None:
    normalized = normalize_verification_command(command)
    if not normalized:
        return ("empty_verification_command", "")
    if not identity:
        return ("missing_allowlist_identity", "verification")

    policy = load_policy(identity)
    if not policy:
        return ("missing_allowlist", identity)

    for token in VERIFICATION_SHELL_CONTROL_TOKENS:
        if token in command:
            return ("shell_control_token", token.replace("\n", "\\n").replace("\r", "\\r"))
    if re.search(r"(^|\s)&($|\s)", normalized):
        return ("shell_control_token", "&")

    try:
        tokens = shlex.split(normalized)
    except ValueError as exc:
        return ("invalid_verification_command", str(exc))
    if not tokens:
        return ("empty_verification_command", "")

    executable = Path(tokens[0]).name.casefold()
    if executable in VERIFICATION_DENIED_EXECUTABLES:
        return ("denied_verification_executable", executable)

    verification_policy = policy.get("verification", {})
    denied_patterns = [*VERIFICATION_DENIED_COMMAND_PATTERNS, *verification_policy.get("deny_commands", [])]
    denied_pattern = any_casefold_match(normalized, denied_patterns)
    if denied_pattern:
        return ("denied_verification_command", denied_pattern)

    allowed_commands = verification_policy.get("allowed_commands", [])
    if not allowed_commands:
        return ("missing_verification_allowlist", identity)
    if not any_casefold_match(normalized, allowed_commands):
        return ("unlisted_verification_command", identity)

    return None


def delete_action_segments(text: str) -> list[str]:
    segments: list[str] = []
    for clause in re.split(r"(?:[\n;]|(?<=\.)\s+)", text):
        clause = clause.strip()
        if not clause:
            continue
        for match in DELETE_ACTION_RE.finditer(clause):
            prefix = clause[max(0, match.start() - 80) : match.start()]
            if DELETE_NEGATION_PREFIX_RE.search(prefix):
                continue
            segments.append(clause[match.start() :].strip())
    return segments


def deletion_candidates(task: dict, text: str) -> list[str]:
    del task
    candidates = []
    for segment in delete_action_segments(text):
        for token in segment.replace(",", " ").split():
            cleaned = token.strip("'\"`()[]{}.:;,!?")
            if cleaned.startswith(SAFE_PATH_PREFIXES):
                candidates.append(cleaned)
    return list(dict.fromkeys(candidates))


def write_action_segments(text: str) -> list[str]:
    segments: list[str] = []
    for clause in re.split(r"(?:[\n;]|(?<=\.)\s+)", text):
        clause = clause.strip()
        if not clause:
            continue
        for match in WRITE_ACTION_RE.finditer(clause):
            prefix = clause[max(0, match.start() - 80) : match.start()]
            if WRITE_NEGATION_PREFIX_RE.search(prefix):
                continue
            segments.append(clause[match.start() :].strip())
    return segments


def path_candidates_from_segment(segment: str, repo: str | None = None) -> list[str]:
    candidates: list[str] = []
    for token in segment.replace(",", " ").split():
        cleaned = token.strip("'\"`()[]{}<>")
        cleaned = cleaned.rstrip(".:")
        if not cleaned:
            continue
        if cleaned.startswith(SAFE_PATH_PREFIXES) or cleaned.startswith(("/", "./", "../")) or "/" in cleaned:
            candidates.append(normalize_task_file(cleaned, repo))
    return candidates


def write_candidates(task: dict, text: str) -> list[str]:
    repo = str(task.get("repo") or "")
    candidates = list(task_file_set(task))
    for segment in write_action_segments(text):
        candidates.extend(path_candidates_from_segment(segment, repo))
    return list(dict.fromkeys(candidates))


def task_assignee_is_human(task: dict) -> bool:
    assignee_role = load_roles().get(task.get("assignee", ""), {})
    return assignee_role.get("model") == "human" or assignee_role.get("policy_window", {}).get("type") == "human"


def text_tokens(text: str) -> list[str]:
    tokens = []
    for token in text.replace(",", " ").replace(";", " ").split():
        cleaned = token.strip("'\"`()[]{}").rstrip(".:;?!")
        if cleaned:
            tokens.append(cleaned)
    return tokens


def text_has_token(text: str, token: str) -> bool:
    return re.search(rf"(?<![A-Za-z0-9_]){re.escape(token)}(?![A-Za-z0-9_])", text, re.IGNORECASE) is not None


# 'production' only escalates risk as an ENVIRONMENT reference. Quality-adjective
# compounds and words that merely contain it are inert prose.
PRODUCTION_BENIGN_COMPOUND_RE = re.compile(
    r"\breproduction\b|\b(?:non|pre)[- ]?production\b|\bproduction[- ](?:grade|ready|quality|level)\b",
    re.IGNORECASE,
)


def production_scope_in_text(text: str) -> bool:
    folded = text.casefold()
    if "prod secret" in folded:
        return True
    return text_has_token(PRODUCTION_BENIGN_COMPOUND_RE.sub(" ", folded), "production")


# A denied branch name counts only in a git ref context: origin/<b>, refs/heads/<b>,
# or immediately after one of these markers ("push main", "merge into main",
# "--base main"). The same word used as ordinary English ("update the main README")
# is not a ref.
BRANCH_REF_CONTEXT_MARKERS = {
    "push", "force-push", "merge", "checkout", "switch", "rebase", "reset",
    "branch", "branches", "base", "head", "origin", "remote", "into", "onto",
    "to", "from", "on", "delete", "track", "pr",
}
BRANCH_ACTION_TOKENS = {"push", "merge", "checkout", "switch", "force-push", "gh"}
BRANCH_ACTION_FILLERS = {"-", "--", "branch", "branches"}


def branch_token_match(token: str, denied: str) -> bool:
    folded = token.casefold()
    denied_folded = denied.casefold()
    return (
        folded in (denied_folded, f"origin/{denied_folded}", f"refs/heads/{denied_folded}")
        or fnmatch.fnmatch(folded, denied_folded)
        or fnmatch.fnmatch(folded, f"origin/{denied_folded}")
        or fnmatch.fnmatch(folded, f"refs/heads/{denied_folded}")
    )


def branch_ref_context_match(tokens: list[str], denied: str) -> bool:
    for index, token in enumerate(tokens):
        if branch_token_match(token, f"origin/{denied}") or branch_token_match(token, f"refs/heads/{denied}"):
            return True
        if branch_token_match(token, denied):
            prev = tokens[index - 1].lstrip("-").casefold() if index else ""
            if prev in BRANCH_REF_CONTEXT_MARKERS:
                return True
    return False


def branch_action_near_ref(tokens: list[str], index: int) -> bool:
    for step in (-1, 1):
        j = index + step
        while 0 <= j < len(tokens):
            token = tokens[j].strip().casefold()
            marker = token.lstrip("-")
            if token in BRANCH_ACTION_FILLERS or marker in BRANCH_ACTION_FILLERS:
                j += step
                continue
            if marker in BRANCH_ACTION_TOKENS or marker.startswith("git"):
                return True
            break
    return False


def branch_sensitive_match(tokens: list[str], denied: str) -> bool:
    return any(branch_token_match(token, denied) and branch_action_near_ref(tokens, index) for index, token in enumerate(tokens))


def text_has_policy_secret_context(text: str) -> bool:
    return re.search(
        r"\b(secret|secrets|credential|credentials|token|tokens|api[-_ ]?key|password)\b",
        text,
        re.IGNORECASE,
    ) is not None


def policy_denial(task: dict) -> tuple[str, str] | None:
    # Human assignees receive inbox/approval/FYI items, not sandboxed execution.
    # The executor allowlist cannot apply to a human because they do not have
    # *.allow.toml files. Without this exemption, FYI/escalation tasks to Ayo
    # are spuriously blocked as missing_allowlist.
    if task_assignee_is_human(task):
        return None

    identity = task.get("allowlist_identity")
    if not identity:
        return None
    policy = load_policy(identity)
    if not policy:
        return ("missing_allowlist", identity)

    text_parts = [str(task.get(key, "")) for key in ("title", "task", "repo")]
    if task.get("files"):
        text_parts.append("files:\n" + "\n".join(task.get("files") or []))
    text = "\n".join(part for part in text_parts if part)

    fs_policy = policy.get("filesystem", {})
    candidates = write_candidates(task, text)
    for denied in fs_policy.get("deny_write_paths", []):
        if any(any_match(candidate, [denied]) for candidate in candidates):
            return ("denied_path", denied)

    delete_paths = fs_policy.get("delete_paths", [])
    if delete_action_segments(text):
        if not delete_paths:
            return ("delete_requires_escalation", "delete_paths=[]")
        candidates = deletion_candidates(task, text)
        if not candidates:
            return ("delete_requires_escalation", "no_delete_target_declared")
        for candidate in candidates:
            if not any_match(candidate, delete_paths):
                return ("delete_requires_escalation", candidate)
        for denied in fs_policy.get("deny_write_paths", []):
            if any(any_match(candidate, [denied]) for candidate in candidates):
                return ("denied_path", denied)

    git_policy = policy.get("git", {})
    tokens = text_tokens(text)
    if "push --force" in text or "push -f" in text:
        if not git_policy.get("force_push", False):
            branch = "unknown"
            for denied in git_policy.get("branches_denied", []):
                if branch_ref_context_match(tokens, denied):
                    branch = denied
                    break
            return ("denied_branch", branch)
    branch_sensitive = any(token.casefold() in BRANCH_ACTION_TOKENS or token.casefold().startswith("git") for token in tokens)
    if branch_sensitive:
        for denied in git_policy.get("branches_denied", []):
            if branch_ref_context_match(tokens, denied) or branch_sensitive_match(tokens, denied):
                return ("denied_branch", denied)

    secrets_policy = policy.get("secrets", {})
    if text_has_policy_secret_context(text):
        for denied in secrets_policy.get("deny_tags", []):
            if text_has_token(text, denied):
                return ("denied_secret_tag", denied)
    token_required = task.get("token_required")
    if token_required and token_required.startswith("tag:"):
        tag = token_required.split(":", 1)[1]
        if tag not in secrets_policy.get("read_tags", []):
            return ("secret_tag_not_allowed", tag)

    deploy_policy = policy.get("deploy", {})
    for denied in deploy_policy.get("targets_denied", []):
        if denied in text:
            return ("denied_deploy_target", denied)

    return None


def read_tasks_unlocked() -> list[dict]:
    ensure_state()
    tasks: list[dict] = []
    for line in TASKS.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        tasks.append(json.loads(line))
    return tasks


def read_tasks() -> list[dict]:
    ensure_state()
    with task_read_lock():
        return read_tasks_unlocked()


def read_jsonl_readonly_unlocked(path: Path, *, limit: int | None = None) -> tuple[list[dict], list[dict]]:
    if not path.exists():
        return [], []
    records: list[dict] = []
    errors: list[dict] = []
    lines = path.read_text(encoding="utf-8").splitlines()
    if limit and limit > 0:
        lines = lines[-limit:]
    for line_no, line in enumerate(lines, start=1):
        if not line.strip():
            continue
        try:
            value = json.loads(line)
        except json.JSONDecodeError as exc:
            errors.append({"path": str(path), "line": line_no, "error": f"{exc.msg} at column {exc.colno}"})
            continue
        if not isinstance(value, dict):
            errors.append({"path": str(path), "line": line_no, "error": "non-object JSON value"})
            continue
        records.append(value)
    return records, errors


def read_jsonl_readonly(path: Path, *, limit: int | None = None) -> tuple[list[dict], list[dict]]:
    if jsonl_needs_file_lock(path):
        with jsonl_file_lock(path, exclusive=False):
            return read_jsonl_readonly_unlocked(path, limit=limit)
    return read_jsonl_readonly_unlocked(path, limit=limit)


def read_tasks_readonly() -> tuple[list[dict], list[dict]]:
    return read_jsonl_readonly(TASKS)


def write_tasks_unlocked(tasks: list[dict]) -> None:
    tmp = TASKS.with_suffix(".jsonl.tmp")
    tmp.write_text("".join(json.dumps(t, separators=(",", ":")) + "\n" for t in tasks), encoding="utf-8")
    chmod_best_effort(tmp, 0o664)
    tmp.replace(TASKS)
    chmod_best_effort(TASKS, 0o664)
    refresh_inboxes(tasks)
    mirror_result = mirror_vps_state(timeout=POST_WRITE_MIRROR_TIMEOUT)
    handle_mirror_result(mirror_result, task_count=len(tasks))
    if mirror_result and not mirror_result.get("ok"):
        print(f"warning: VPS mirror failed; mirror_owed marker written: {mirror_result.get('error')}", file=sys.stderr)


def write_tasks(tasks: list[dict]) -> None:
    ensure_state()
    with task_write_lock():
        write_tasks_unlocked(tasks)


def chmod_best_effort(path: Path, mode: int) -> None:
    try:
        path.chmod(mode)
    except OSError:
        pass


def expected_state_owner_ids() -> tuple[str, int, int | None] | None:
    expected_owner = os.environ.get("AORG_EXPECT_STATE_OWNER")
    if not expected_owner:
        return None
    owner_record = pwd.getpwnam(expected_owner)
    expected_group = os.environ.get("AORG_EXPECT_STATE_GROUP")
    gid = grp.getgrnam(expected_group).gr_gid if expected_group else None
    return expected_owner, owner_record.pw_uid, gid


def normalize_expected_state_owner(path: Path) -> None:
    expected = expected_state_owner_ids()
    if not expected:
        return
    _, uid, gid = expected
    st = path.stat()
    owner_mismatch = st.st_uid != uid
    group_mismatch = gid is not None and st.st_gid != gid
    if not owner_mismatch and not group_mismatch:
        return
    if os.geteuid() != 0:
        return
    os.chown(path, uid if owner_mismatch else -1, gid if group_mismatch else -1)


def assert_expected_state_owner(path: Path) -> None:
    expected = expected_state_owner_ids()
    if not expected:
        return
    expected_owner, _, gid = expected
    normalize_expected_state_owner(path)
    st = path.stat()
    owner = pwd.getpwuid(path.stat().st_uid).pw_name
    if owner != expected_owner:
        raise PermissionError(f"{path} owner is {owner}, expected {expected_owner}")
    if gid is not None and st.st_gid != gid:
        group = name_for_gid(st.st_gid)
        expected_group = os.environ.get("AORG_EXPECT_STATE_GROUP")
        raise PermissionError(f"{path} group is {group}, expected {expected_group}")


def write_text_atomic(path: Path, text: str, mode: int = 0o664) -> None:
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        tmp.write_text(text, encoding="utf-8")
        chmod_best_effort(tmp, mode)
        assert_expected_state_owner(tmp)
        tmp.replace(path)
        chmod_best_effort(path, mode)
        assert_expected_state_owner(path)
    except Exception:
        with contextlib.suppress(OSError):
            tmp.unlink()
        raise


def refresh_inboxes(tasks: list[dict] | None = None) -> bool:
    ensure_state()
    tasks = tasks if tasks is not None else read_tasks()
    ok = True
    for path in INBOX.glob("*.jsonl"):
        try:
            path.unlink()
        except OSError as exc:
            ok = False
            print(f"warning: inbox refresh could not remove {path}: {exc}", file=sys.stderr)
    by_role: dict[str, list[dict]] = {}
    for task in tasks:
        assignee = task.get("assignee")
        if not assignee:
            continue
        by_role.setdefault(assignee, []).append(task)
        escalation_to = task.get("escalation_to")
        if task.get("status") == "pending-human" and escalation_to and escalation_to != assignee:
            by_role.setdefault(escalation_to, []).append(task)
        reviewer = task.get("reviewer")
        if task.get("status") == "review-pending" and reviewer and reviewer != assignee:
            by_role.setdefault(reviewer, []).append(task)
    for role, role_tasks in by_role.items():
        path = INBOX / f"{role}.jsonl"
        try:
            write_text_atomic(path, "".join(json.dumps(t, separators=(",", ":")) + "\n" for t in role_tasks))
        except OSError as exc:
            ok = False
            print(f"warning: inbox refresh could not write {path}: {exc}", file=sys.stderr)
    return ok


def append_jsonl_unlocked(path: Path, obj: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    chmod_best_effort(path.parent, 0o2775)
    assert_expected_state_owner(path.parent)
    with path.open("a", encoding="utf-8") as f:
        f.write(json.dumps(obj, separators=(",", ":")) + "\n")
    chmod_best_effort(path, 0o664)
    assert_expected_state_owner(path)


def append_jsonl(path: Path, obj: dict) -> None:
    if jsonl_needs_file_lock(path):
        with jsonl_file_lock(path, exclusive=True):
            append_jsonl_unlocked(path, obj)
        return
    append_jsonl_unlocked(path, obj)


def env_truthy(value: str | None) -> bool:
    return value is not None and value.lower() in {"1", "true", "yes", "on"}


def env_falsey(value: str | None) -> bool:
    return value is not None and value.lower() in {"0", "false", "no", "off"}


def env_int(name: str, default: int, minimum: int | None = None) -> int:
    raw = os.environ.get(name)
    if raw is None:
        return default
    try:
        value = int(raw)
    except ValueError:
        return default
    if minimum is not None:
        return max(minimum, value)
    return value


def prune_named_backups(prefix: str, keep: int) -> list[Path]:
    backups_root = STATE / "backups"
    if keep < 0 or not backups_root.exists():
        return []
    candidates = sorted(
        (path for path in backups_root.iterdir() if path.is_dir() and path.name.startswith(prefix)),
        key=lambda path: path.name,
        reverse=True,
    )
    removed: list[Path] = []
    for stale in candidates[keep:]:
        shutil.rmtree(stale)
        removed.append(stale)
    return removed


def default_state_path() -> Path:
    return CANONICAL_LOCAL_STATE.expanduser().resolve(strict=False)


def repo_relative_state_path() -> Path:
    return REPO_RELATIVE_STATE.expanduser().resolve(strict=False)


def state_dir_unset() -> bool:
    return "AORG_STATE_DIR" not in os.environ


def state_dir_unset_and_repo_relative() -> bool:
    return state_dir_unset() and STATE.expanduser().resolve(strict=False) == repo_relative_state_path()


def enforce_state_dir_startup_policy(argv: list[str]) -> None:
    if not argv or not state_dir_unset():
        return
    command = argv[0]
    if command in STATE_DIR_EXPLICIT_REQUIRED_COMMANDS:
        print(STATE_DIR_UNSET_REFUSAL_TOKEN, file=sys.stderr)
        sys.exit(2)
    if command in STATE_DIR_UNSET_INTERACTIVE_COMMANDS:
        print(f"warning: AORG_STATE_DIR unset; using canonical state dir {STATE}", file=sys.stderr)


def should_mirror_vps_state() -> bool:
    env_value = os.environ.get("AORG_VPS_MIRROR")
    if on_canonical_host():
        return False
    if env_truthy(env_value):
        return True
    try:
        if STATE.expanduser().resolve(strict=False) == default_state_path():
            return True
    except OSError:
        return False
    if env_falsey(env_value):
        return False
    return False


def mirror_owed_payload() -> dict | None:
    if not MIRROR_OWED.exists():
        return None
    try:
        payload = json.loads(MIRROR_OWED.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return {"created_at": None, "error": f"unreadable marker: {exc}", "path": str(MIRROR_OWED)}
    if isinstance(payload, dict):
        payload.setdefault("path", str(MIRROR_OWED))
        return payload
    return {"created_at": None, "error": "invalid marker payload", "path": str(MIRROR_OWED)}


def task_line_count() -> int:
    if not TASKS.exists():
        return 0
    return sum(1 for line in TASKS.read_text(encoding="utf-8").splitlines() if line.strip())


def write_mirror_owed(result: dict | None, *, task_count: int | None = None) -> None:
    MIRROR_OWED.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "created_at": now(),
        "task_count": task_count if task_count is not None else task_line_count(),
        "status": (result or {}).get("status", "failed"),
        "stage": (result or {}).get("stage"),
        "error": (result or {}).get("error", "mirror result missing"),
    }
    MIRROR_OWED.write_text(json.dumps(payload, separators=(",", ":")) + "\n", encoding="utf-8")
    chmod_best_effort(MIRROR_OWED, 0o664)


def clear_mirror_owed() -> None:
    try:
        MIRROR_OWED.unlink()
    except FileNotFoundError:
        pass


def handle_mirror_result(result: dict | None, *, task_count: int | None = None) -> None:
    if result and result.get("ok") and result.get("status") == "mirrored":
        clear_mirror_owed()
        return
    if result and result.get("ok") and result.get("status") == "skipped":
        return
    write_mirror_owed(result, task_count=task_count)


def ssh_base_command(connect_timeout: int | None = 10) -> list[str]:
    custom = os.environ.get("AORG_SSH_COMMAND")
    if custom:
        return shlex.split(custom)
    command = ["ssh"]
    key_path = Path(os.environ.get("AORG_SSH_KEY", "~/.ssh/id_ed25519")).expanduser()
    try:
        key_present = key_path.exists()
    except OSError:
        key_present = False
    if key_present:
        command.extend(["-F", "/dev/null", "-i", str(key_path), "-o", "IdentitiesOnly=yes"])
    command.extend(["-o", "BatchMode=yes"])
    if connect_timeout is not None:
        command.extend(["-o", f"ConnectTimeout={connect_timeout}"])
    return command


def broker_socket_path() -> Path:
    return Path(os.environ.get("AORG_BROKER_SOCKET") or DEFAULT_AORG_BROKER_SOCKET).expanduser()


def broker_socket_security(path: Path) -> bool | None:
    try:
        info = path.stat()
    except PermissionError:
        return None
    except OSError:
        return False
    mode = stat.S_IMODE(info.st_mode)
    return stat.S_ISSOCK(info.st_mode) and info.st_uid == os.getuid() and mode & 0o077 == 0


def broker_transport_available() -> bool:
    if env_truthy(os.environ.get("AORG_BROKER_DISABLE")):
        return False
    if env_falsey(os.environ.get("AORG_BROKER_SOCKET")):
        return False
    path = broker_socket_path()
    security = broker_socket_security(path)
    if security is False:
        return False
    # Claude's sandbox can allow connecting to this Unix socket while denying stat.
    # Only the built-in per-user socket may use ping-only discovery.
    if security is None and os.environ.get("AORG_BROKER_SOCKET"):
        return False
    try:
        timeout = float(os.environ.get("AORG_BROKER_PING_TIMEOUT", "5.0"))
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(timeout)
            client.connect(str(path))
            client.sendall(b'{"ping":true}\n')
            response = json.loads(client.recv(1024).decode("utf-8"))
    except OSError:
        return False
    except (UnicodeDecodeError, json.JSONDecodeError):
        return False
    return int(response.get("exit_code", 1)) == 0


def proxy_to_broker(argv: list[str]) -> int:
    payload = {
        "argv": argv,
        "env": {
            "APEX_AGENT_IDENTITY": os.environ.get("APEX_AGENT_IDENTITY", ""),
            "APEX_AGENT_HOST": current_host(),
            "APEX_AGENT_PID": str(current_agent_pid() or ""),
        },
    }
    timeout = int(os.environ.get("AORG_BROKER_TIMEOUT", "1200"))
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(timeout)
            client.connect(str(broker_socket_path()))
            client.sendall((json.dumps(payload, separators=(",", ":")) + "\n").encode("utf-8"))
            chunks: list[bytes] = []
            while True:
                chunk = client.recv(65536)
                if not chunk:
                    break
                chunks.append(chunk)
    except OSError as exc:
        print(f"aorg broker unavailable: {exc}", file=sys.stderr)
        return 2
    try:
        response = json.loads(b"".join(chunks).decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        print(f"aorg broker invalid response: {exc}", file=sys.stderr)
        return 2
    stdout = str(response.get("stdout") or "")
    stderr = str(response.get("stderr") or "")
    if stdout:
        sys.stdout.write(stdout)
    if stderr:
        sys.stderr.write(stderr)
    try:
        return int(response.get("exit_code", 2))
    except (TypeError, ValueError):
        return 2


def rsync_base_command(connect_timeout: int | None = 10) -> list[str]:
    return [
        "rsync",
        "-az",
        "--no-owner",
        "--no-group",
        "--chmod=Du=rwx,Dg=rwx,Do=rx,Fu=rw,Fg=rw,Fo=r",
        "-e",
        " ".join(shlex.quote(part) for part in ssh_base_command(connect_timeout)),
    ]


def mirror_vps_state(*, force: bool = False, timeout: int | None = None) -> dict | None:
    if not force and not should_mirror_vps_state():
        return {"ok": True, "status": "skipped", "reason": "mirror_disabled_or_noncanonical_state"}
    if not TASKS.exists():
        return {"ok": True, "status": "skipped", "reason": "tasks_missing"}
    if not shutil.which("ssh"):
        return {"ok": False, "status": "failed", "error": "ssh_missing"}
    if not shutil.which("rsync"):
        return {"ok": False, "status": "failed", "error": "rsync_missing"}

    remote_dir = VPS_MIRROR_STATE_DIR.rstrip("/")
    mirror_timeout = timeout if timeout is not None else VPS_MIRROR_TIMEOUT
    connect_timeout = max(1, min(10, mirror_timeout))
    mkdir_command = "mkdir -p " + " ".join(
        shlex.quote(path) for path in [remote_dir, f"{remote_dir}/inbox", f"{remote_dir}/reports"]
    )
    try:
        mkdir_proc = subprocess.run(
            [*ssh_base_command(connect_timeout), VPS_MIRROR_HOST, mkdir_command],
            text=True,
            capture_output=True,
            timeout=mirror_timeout,
        )
        if mkdir_proc.returncode != 0:
            return {
                "ok": False,
                "status": "failed",
                "stage": "mkdir",
                "error": (mkdir_proc.stderr or mkdir_proc.stdout).strip()[:500],
            }

        state_files = [TASKS]
        for optional_name in ["halt.json", "escalations.jsonl", "approvals.jsonl", "halts.jsonl"]:
            optional_path = STATE / optional_name
            if optional_path.exists():
                state_files.append(optional_path)
        rsync_state = subprocess.run(
            [*rsync_base_command(connect_timeout), *(str(path) for path in state_files), f"{VPS_MIRROR_HOST}:{remote_dir}/"],
            text=True,
            capture_output=True,
            timeout=mirror_timeout,
        )
        if rsync_state.returncode != 0:
            return {
                "ok": False,
                "status": "failed",
                "stage": "state_files",
                "error": (rsync_state.stderr or rsync_state.stdout).strip()[:500],
            }
        if INBOX.exists():
            rsync_inbox = subprocess.run(
                [*rsync_base_command(connect_timeout), f"{INBOX}/", f"{VPS_MIRROR_HOST}:{remote_dir}/inbox/"],
                text=True,
                capture_output=True,
                timeout=mirror_timeout,
            )
            if rsync_inbox.returncode != 0:
                return {
                    "ok": False,
                    "status": "failed",
                    "stage": "inbox",
                    "error": (rsync_inbox.stderr or rsync_inbox.stdout).strip()[:500],
                }
    except subprocess.TimeoutExpired as exc:
        return {"ok": False, "status": "failed", "stage": "timeout", "error": str(exc)}
    except OSError as exc:
        return {"ok": False, "status": "failed", "stage": "transport", "error": str(exc)}

    return {
        "ok": True,
        "status": "mirrored",
        "host": VPS_MIRROR_HOST,
        "remote_state_dir": remote_dir,
        "task_count": sum(1 for line in TASKS.read_text(encoding="utf-8").splitlines() if line.strip()),
        "mirrored_at": now(),
    }


def canonical_vps_mode_enabled(argv: list[str]) -> bool:
