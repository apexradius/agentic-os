def now() -> str:
    return current_datetime().strftime("%Y-%m-%dT%H:%M:%SZ")


def current_datetime() -> datetime:
    override = os.environ.get("AORG_NOW")
    if override:
        normalized = override.replace("Z", "+00:00")
        parsed = datetime.fromisoformat(normalized)
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=timezone.utc)
        return parsed.astimezone(timezone.utc)
    return datetime.now(timezone.utc)


def current_host() -> str:
    return os.environ.get("APEX_AGENT_HOST") or socket.gethostname()


def current_pid() -> int:
    return normalize_pid(os.environ.get("APEX_AGENT_PID")) or os.getpid()


def normalize_pid(value: str | int | None) -> int | None:
    if value in {None, ""}:
        return None
    try:
        pid = int(value)
    except (TypeError, ValueError):
        return None
    return pid if pid > 0 else None


def current_agent_pid() -> int | None:
    return normalize_pid(os.environ.get("APEX_AGENT_PID") or os.environ.get("APEX_AGENT_SHELL_PID"))


def task_liveness_metadata(args: argparse.Namespace) -> dict:
    host = getattr(args, "agent_host", None) or current_host()
    pid = normalize_pid(getattr(args, "agent_pid", None)) or current_agent_pid()
    payload = {"host": host}
    if pid:
        payload["pid"] = pid
    return payload


def session_host_matches(left: str | None, right: str | None) -> bool:
    if not left or not right:
        return False
    left_values = {left, left.split(".", 1)[0]}
    right_values = {right, right.split(".", 1)[0]}
    return bool(left_values.intersection(right_values))


def is_local_session_host(host: str | None) -> bool:
    if not host:
        return False
    return any(
        session_host_matches(host, candidate)
        for candidate in {current_host(), socket.gethostname(), socket.getfqdn(), "localhost", "127.0.0.1"}
    )


def pid_is_alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def task_session_label(task: dict) -> str:
    host = task.get("claimed_by_host") or task.get("last_heartbeat_host") or "unknown-host"
    pid = normalize_pid(task.get("claimed_by_pid") or task.get("last_heartbeat_pid"))
    return f"{host}:{pid or 'unknown-pid'}"


def task_claim_is_live(task: dict) -> bool:
    if task.get("status") != "claimed":
        return False
    last_seen = parse_ts(task.get("last_heartbeat_at")) or parse_ts(task.get("claimed_at"))
    if not last_seen:
        return False
    if current_datetime() - last_seen > timedelta(minutes=SESSION_LOCK_STALE_MINUTES):
        return False
    host = task.get("claimed_by_host") or task.get("last_heartbeat_host")
    pid = normalize_pid(task.get("claimed_by_pid") or task.get("last_heartbeat_pid"))
    if not pid:
        return True
    if is_local_session_host(host):
        return pid_is_alive(pid)
    return True


def task_session_matches(task: dict, args: argparse.Namespace) -> bool:
    claimed_host = task.get("claimed_by_host")
    claimed_pid = normalize_pid(task.get("claimed_by_pid"))
    if not claimed_host or not claimed_pid:
        return True
    liveness = task_liveness_metadata(args)
    current_pid = normalize_pid(liveness.get("pid"))
    if not current_pid:
        return False
    return session_host_matches(claimed_host, liveness["host"]) and claimed_pid == current_pid


def live_claim_denial(task: dict, args: argparse.Namespace) -> str | None:
    if task.get("status") != "claimed":
        return None
    if not task_claim_is_live(task):
        return None
    if task_session_matches(task, args):
        return None
    return f"task held by live session {task_session_label(task)}"


def stamp_task_session(task: dict, args: argparse.Namespace, role: str, *, claimed: bool, stamped_at: str | None = None) -> str:
    stamped_at = stamped_at or now()
    liveness = task_liveness_metadata(args)
    if claimed:
        task["claimed_at"] = stamped_at
        task["claimed_by"] = role
        task["claimed_by_host"] = liveness["host"]
        if liveness.get("pid"):
            task["claimed_by_pid"] = liveness["pid"]
        else:
            task.pop("claimed_by_pid", None)
    task["last_heartbeat_at"] = stamped_at
    task["last_heartbeat_by"] = role
    task["last_heartbeat_host"] = liveness["host"]
    if liveness.get("pid"):
        task["last_heartbeat_pid"] = liveness["pid"]
        task.setdefault("claimed_by_pid", liveness["pid"])
    else:
        task.pop("last_heartbeat_pid", None)
    task.setdefault("claimed_by_host", liveness["host"])
    return stamped_at


def parse_ts(value: str | None) -> datetime | None:
    if not value:
        return None
    try:
        return datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except ValueError:
        return None


def parse_filter_ts(value: str | None) -> datetime | None:
    if not value:
        return None
    parsed = parse_ts(value)
    if parsed:
        return parsed
    try:
        return datetime.strptime(value, "%Y-%m-%d").replace(tzinfo=timezone.utc)
    except ValueError:
        pass
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def redact_text(value: object, *, max_chars: int = 1200) -> str:
    if value is None:
        text = ""
    elif isinstance(value, str):
        text = value
    else:
        text = json.dumps(value, ensure_ascii=True, sort_keys=True)
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    if len(text) > max_chars:
        text = text[:max_chars].rstrip() + "..."
    for pattern, replacement in SECRETISH_PATTERNS:
        text = pattern.sub(replacement, text)
    return text


def safe_output_path(raw_path: str) -> Path:
    path = Path(raw_path).expanduser()
    if not path.is_absolute():
        path = Path.cwd() / path
    resolved = path.resolve(strict=False)
    if not str(resolved).startswith(SAFE_PATH_PREFIXES):
        print(f"refusing output outside safe path prefixes: {resolved}", file=sys.stderr)
        sys.exit(2)
    return resolved


def ensure_state() -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    INBOX.mkdir(parents=True, exist_ok=True)
    chmod_best_effort(STATE, 0o2775)
    chmod_best_effort(INBOX, 0o2775)
    REPORTS.mkdir(parents=True, exist_ok=True)
    TASKS.parent.mkdir(parents=True, exist_ok=True)
    if not TASKS.exists():
        TASKS.write_text("", encoding="utf-8")
    chmod_best_effort(TASKS, 0o664)
    if not TASKS_LOCK.exists():
        TASKS_LOCK.touch()
    chmod_best_effort(TASKS_LOCK, 0o664)
    for path in [STATE, INBOX, REPORTS, TASKS, TASKS_LOCK]:
        if path.exists():
            assert_expected_state_owner(path)


@contextlib.contextmanager
def task_write_lock():
    STATE.mkdir(parents=True, exist_ok=True)
    with TASKS_LOCK.open("a", encoding="utf-8") as lock_file:
        chmod_best_effort(TASKS_LOCK, 0o664)
        assert_expected_state_owner(TASKS_LOCK)
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_file, fcntl.LOCK_UN)


@contextlib.contextmanager
def task_read_lock():
    STATE.mkdir(parents=True, exist_ok=True)
    with TASKS_LOCK.open("a", encoding="utf-8") as lock_file:
        chmod_best_effort(TASKS_LOCK, 0o664)
        assert_expected_state_owner(TASKS_LOCK)
        fcntl.flock(lock_file, fcntl.LOCK_SH)
        try:
            yield
        finally:
            fcntl.flock(lock_file, fcntl.LOCK_UN)


def jsonl_needs_file_lock(path: Path) -> bool:
    return path.name in LOCKED_SIDECAR_NAMES


@contextlib.contextmanager
def jsonl_file_lock(path: Path, *, exclusive: bool):
    path.parent.mkdir(parents=True, exist_ok=True)
    chmod_best_effort(path.parent, 0o2775)
    assert_expected_state_owner(path.parent)
    lock_path = path.with_name(f"{path.name}.lock")
    with lock_path.open("a", encoding="utf-8") as lock_file:
        chmod_best_effort(lock_path, 0o664)
        assert_expected_state_owner(lock_path)
        fcntl.flock(lock_file, fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
        try:
            yield
        finally:
            fcntl.flock(lock_file, fcntl.LOCK_UN)


