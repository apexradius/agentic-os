def cmd_complete(args: argparse.Namespace) -> None:
    role_or_die(args.role)
    with task_write_lock():
        tasks = read_tasks_unlocked()
        task = task_by_id(tasks, args.task_id)
        if not task:
            print(f"task not found: {args.task_id}", file=sys.stderr)
            sys.exit(2)
        if task.get("assignee") != args.role:
            print(f"task assigned to {task.get('assignee')}, not {args.role}", file=sys.stderr)
            sys.exit(2)
        if task.get("status") in {"complete", "cancelled", "failed"}:
            print(f"task is {task.get('status')}; refusing complete", file=sys.stderr)
            sys.exit(2)
        if not task.get("claimed_at") and task.get("mode") != "bootstrap":
            if task_is_approval_gate(task):
                task["completed_without_claim_reason"] = "approval_gate_with_recorded_approval"
            else:
                print("task has no claimed_at; refusing complete because it never ran", file=sys.stderr)
                sys.exit(2)
        denial = live_claim_denial(task, args)
        if denial:
            print(denial, file=sys.stderr)
            sys.exit(2)
        errors = completion_errors(task, args, tasks)
        if errors:
            print("completion objective gate failed: " + "; ".join(errors), file=sys.stderr)
            sys.exit(2)

        completed_at = now()
        task["completed_at"] = completed_at
        task["summary"] = args.summary
        task["evidence"] = args.evidence or []
        task["files_touched"] = args.files or []
        task["risk"] = args.risk
        task["vna"] = args.vna
        task["acceptance_met"] = args.acceptance_met or []
        if getattr(args, "pr_url", None):
            task["pr_url"] = args.pr_url
        task["completion_candidate_at"] = completed_at
        actor_identity = os.environ.get("APEX_AGENT_IDENTITY")
        if actor_identity:
            task["completion_actor_identity"] = actor_identity
        # Optional cost/token telemetry — additive, backward compatible.
        # Populated by --cost-usd / --tokens-in / --tokens-out / --model flags,
        # or left absent when the executing engine cannot report them.
        cost_usd = getattr(args, "cost_usd", None)
        tokens_in = getattr(args, "tokens_in", None)
        tokens_out = getattr(args, "tokens_out", None)
        cost_model = getattr(args, "model", None)
        if cost_usd is not None:
            task["cost_usd"] = cost_usd
        if tokens_in is not None:
            task["tokens_in"] = tokens_in
        if tokens_out is not None:
            task["tokens_out"] = tokens_out
        if cost_model:
            task["cost_model"] = cost_model

        review_task = None
        path_review_required = completion_requires_path_review(task, args.files or [])
        if (task.get("review_required") or path_review_required) and not task.get("review_passed") and not task_is_approval_gate(task):
            # Council v2: the cross-reviewer is the OTHER frontier agent than the executor.
            if path_review_required:
                reviewer = other_frontier(task.get("assignee", ""))
            else:
                reviewer = task.get("reviewer") or other_frontier(task.get("assignee", ""))
            role_or_die(reviewer)
            task["review_required"] = True
            task["reviewer"] = reviewer
            task["status"] = "review-pending"
            task["blocked_reason"] = f"completion_review_required:{reviewer}"
            review_task = create_review_task(tasks, task, reviewer)
        else:
            task["status"] = "complete"
            task["blocked_reason"] = None
        task = dict(task)
        write_tasks_unlocked(tasks)
    report = REPORTS / f"{args.task_id}-{args.role}.md"
    report.write_text(
        "\n".join(
            [
                f"# {task.get('title')}",
                "",
                f"Task: `{args.task_id}`",
                f"Role: `{args.role}`",
                f"Completed: {task['completed_at']}",
                f"Status: `{task['status']}`",
                "",
                "## Result",
                args.summary,
                "",
                "## Acceptance Criteria Met",
                "\n".join(f"- {p}" for p in (args.acceptance_met or [])) or "- None recorded",
                "",
                "## Files Touched",
                "\n".join(f"- {p}" for p in (args.files or [])) or "- None recorded",
                "",
                "## Verification / Evidence",
                "\n".join(f"- {p}" for p in (args.evidence or [])) or "- None recorded",
                "",
                "## Risk",
                args.risk,
                "",
                "## VNA",
