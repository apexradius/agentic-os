    if not reviewed_fail_companion or reviewed_fail_companion.get("status") != "complete":
        print(f"FAIL: companion fail did not close companion: {reviewed_fail_companion}", file=sys.stderr)
        sys.exit(1)
    rehanded = [
        t for t in reviewed_fail_tasks
        if t.get("reviews_task") == companion_fail_parent["id"]
        and t.get("status") == "pending"
        and t.get("reviewer") == "claude"
    ]
    if len(rehanded) != 1 or rehanded[0].get("review_round") != 2:
        print(f"FAIL: round-2 review task not spawned for claude: {rehanded}", file=sys.stderr)
        sys.exit(1)

    # Council v2 CAP: round-2 fail freezes and escalates to Ayo (no infinite loop).
    cmd_review(
        argparse.Namespace(
            role="claude",
            task_id=rehanded[0]["id"],
            decision="fail",
            summary="still wrong",
            evidence=[str(review_evidence)],
        )
    )
    capped_tasks = read_tasks()
    capped_parent = task_by_id(capped_tasks, companion_fail_parent["id"])
    if (
        not capped_parent
        or capped_parent.get("status") != "pending-human"
        or capped_parent.get("escalation_to") != "ayo"
        or not str(capped_parent.get("blocked_reason", "")).startswith("council_review_cap_reached")
    ):
        print(f"FAIL: round-2 fail did not escalate to Ayo: {capped_parent}", file=sys.stderr)
        sys.exit(1)

    parent_review_task = {
        **task_a,
        "id": "smoke-review-parent-direct",
        "status": "review-pending",
        "review_required": True,
        "reviewer": "claude",
        "blocked_reason": "completion_review_required:claude",
    }
    parent_review_tasks = [parent_review_task]
    parent_review_companion = create_review_task(parent_review_tasks, parent_review_task, "claude")
    write_tasks(parent_review_tasks)
    cmd_review(
        argparse.Namespace(
            role="claude",
            task_id=parent_review_task["id"],
            decision="pass",
            summary="parent path still works",
            evidence=[str(review_evidence)],
        )
    )
    reviewed_parent_tasks = read_tasks()
    reviewed_parent = task_by_id(reviewed_parent_tasks, parent_review_task["id"])
    reviewed_parent_companion = task_by_id(reviewed_parent_tasks, parent_review_companion["id"])
    if not reviewed_parent or reviewed_parent.get("status") != "complete" or reviewed_parent.get("review_passed") is not True:
        print(f"FAIL: parent review path did not complete parent: {reviewed_parent}", file=sys.stderr)
        sys.exit(1)
    if not reviewed_parent_companion or reviewed_parent_companion.get("status") != "complete":
        print(f"FAIL: parent review path did not close companion: {reviewed_parent_companion}", file=sys.stderr)
        sys.exit(1)

    trajectory_task = {
        **task_a,
        "id": "smoke-trajectory",
        "title": "Sandbox trajectory smoke",
        "task": "Record a reusable sandbox learning",
        "status": "complete",
        "completed_at": "2026-05-23T00:00:00Z",
        "summary": "Implemented sandbox guard with api_key=supersecretvalue123",
        "acceptance_met": ["Context pack includes this task"],
        "files_touched": [str(ROOT / "bin" / "aorg")],
        "evidence": [str(REPORTS / "smoke.md")],
        "risk": "No runtime changes",
        "vna": "Promote to skill candidate",
        "sandbox_profile": "local-workspace",
    }
    trajectory_args = argparse.Namespace(
        since="2026-05-22",
        assignee=["codex"],
        priority=None,
        contains=["sandbox"],
        limit=5,
    )
    trajectory_payload = build_trajectory_payload([trajectory_task], trajectory_args, parse_filter_ts(trajectory_args.since))
    if trajectory_payload.get("task_count") != 1:
        print(f"FAIL: trajectory payload task count wrong: {trajectory_payload.get('task_count')}", file=sys.stderr)
        sys.exit(1)
    rendered_trajectory = render_trajectory_markdown(trajectory_payload)
    if "supersecretvalue123" in rendered_trajectory or "Report content included: `false`" not in rendered_trajectory:
        print("FAIL: trajectory pack redaction/report-content guard failed", file=sys.stderr)
        sys.exit(1)

    print("aorg_hardening_smoke_pass")


def tmux(*args: str) -> None:
    subprocess.run(["tmux", *args], check=True)


def cmd_start(args: argparse.Namespace) -> None:
    session = args.session
    if not shutil.which("tmux"):
        print("tmux is missing", file=sys.stderr)
        sys.exit(1)
    exists = subprocess.run(["tmux", "has-session", "-t", session], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if exists.returncode == 0:
        print(f"tmux session already exists: {session}")
        print(f"attach: tmux attach -t {session}")
        return
    canonical_prefix = ""
    if local_start_uses_vps_canonical():
        launcher = str(Path(__file__).resolve())
        sync_proc = subprocess.run([launcher, "sync-from-vps"], text=True)
        if sync_proc.returncode != 0:
            print("refusing start: sync-from-vps failed; set AORG_CANONICAL_MODE=0 only for deliberate offline/local mode", file=sys.stderr)
            sys.exit(sync_proc.returncode)
        health_proc = subprocess.run([launcher, "canonical-health"], text=True)
        if health_proc.returncode != 0:
            print("refusing start: canonical-health failed; set AORG_CANONICAL_MODE=0 only for deliberate offline/local mode", file=sys.stderr)
            sys.exit(health_proc.returncode)
        canonical_prefix = "export AORG_CANONICAL_MODE=${AORG_CANONICAL_MODE:-vps}; "
    agent_prefix = "export APEX_AGENT_HOST=${APEX_AGENT_HOST:-$(hostname)}; export APEX_AGENT_PID=${APEX_AGENT_PID:-$$}; "
    # CLEANUP C4: agent-launch-window instance specifics externalized to env (neutral default = none).
    # extra_add_dirs: os.pathsep-separated EXTRA --add-dir entries; codex_home: CODEX_HOME for the
    # codex window (neutral default {WORKSPACE}/.codex). An adopter restores the live values via env.
    extra_add_dirs = "".join(f" --add-dir {d}" for d in os.environ.get("AORG_AGENT_ADD_DIRS", "").split(os.pathsep) if d)
    codex_home = os.environ.get("AORG_CODEX_HOME") or f"{WORKSPACE}/.codex"
    tmux("new-session", "-d", "-s", session, "-c", str(WORKSPACE), "zsh", "-lic", f"{canonical_prefix}aorg status --open; exec zsh")
    windows = {
        "codex": f"export APEX_AGENT_IDENTITY=codex-local; export CODEX_HOME={codex_home}; {agent_prefix}{canonical_prefix}aorg brief codex; codex -C {WORKSPACE} --dangerously-bypass-approvals-and-sandbox --search",
        "claude": f"export APEX_AGENT_IDENTITY=claude-local; {agent_prefix}{canonical_prefix}aorg brief claude; claude --dangerously-skip-permissions --add-dir {WORKSPACE} --add-dir /private/tmp --add-dir /tmp{extra_add_dirs}",
    }
    if args.with_antigravity:
        windows["antigravity"] = f"export APEX_AGENT_IDENTITY=aorg-antigravity-local; {agent_prefix}{canonical_prefix}aorg brief antigravity; agy --dangerously-skip-permissions --add-dir {WORKSPACE} --add-dir /private/tmp{extra_add_dirs}"
    if args.with_gemma:
        windows["gemma"] = f"export APEX_AGENT_IDENTITY=gemma-local; {agent_prefix}{canonical_prefix}aorg brief gemma; ollama list; exec zsh"
    for name, command in windows.items():
        tmux("new-window", "-t", session, "-n", name, "-c", str(WORKSPACE), "zsh", "-lic", command)
    print(f"started {session}")
    print(f"attach: tmux attach -t {session}")


def cmd_attach(args: argparse.Namespace) -> None:
    os.execvp("tmux", ["tmux", "attach", "-t", args.session])


