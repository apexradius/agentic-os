def cmd_backup_state(args: argparse.Namespace) -> None:
    ensure_state()
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    safe_label = re.sub(r"[^A-Za-z0-9_.-]+", "-", args.label).strip("-") or "manual"
    backup_root = args.output_dir.expanduser() if args.output_dir else STATE / "backups" / safe_label
    backup_dir = backup_root / stamp
    backup_dir.mkdir(parents=True, exist_ok=True)
    copied: list[str] = []
    for path in [TASKS, HALT_FILE, STATE / "escalations.jsonl", STATE / "approvals.jsonl", STATE / "cancellations.jsonl"]:
        if path.exists():
            shutil.copy2(path, backup_dir / path.name)
            copied.append(path.name)
    for name in ["inbox", "reports", "council"]:
        src = STATE / name
        if src.exists():
            shutil.copytree(src, backup_dir / name, dirs_exist_ok=True)
            copied.append(name + "/")
    manifest = {
        "ok": bool(copied),
        "label": safe_label,
        "created_at": now(),
        "state_dir": str(STATE),
        "backup_dir": str(backup_dir),
        "copied": copied,
    }
    (backup_dir / "manifest.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(manifest, indent=2, sort_keys=True))
    if not copied:
        sys.exit(2)


def name_for_uid(uid: int) -> str:
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        return f"UNKNOWN:{uid}"


def name_for_gid(gid: int) -> str:
    try:
        return grp.getgrgid(gid).gr_name
    except KeyError:
        return f"UNKNOWN:{gid}"


def ownership_entry(path: Path, expected_owner: str | None, expected_group: str | None) -> dict:
    item = {
        "path": str(path),
        "exists": path.exists(),
        "issues": [],
    }
    if not path.exists():
        item["issues"].append("missing")
        return item

    st = path.stat()
    mode = stat.S_IMODE(st.st_mode)
    owner = name_for_uid(st.st_uid)
    group = name_for_gid(st.st_gid)
    item.update(
        {
            "owner": owner,
            "group": group,
            "mode": oct(mode),
            "type": "directory" if path.is_dir() else "file",
        }
    )
    if expected_owner and owner != expected_owner:
        item["issues"].append(f"owner:{owner}!=expected:{expected_owner}")
    if expected_group and group != expected_group:
        item["issues"].append(f"group:{group}!=expected:{expected_group}")
    if path.parent == INBOX and path.name.endswith(".jsonl") and not path.is_file():
        item["issues"].append("inbox_jsonl_not_file")
    if path.is_dir():
        if not (mode & stat.S_IWUSR):
            item["issues"].append("owner_not_writable")
        if not (mode & stat.S_IXUSR):
            item["issues"].append("owner_not_searchable")
    else:
        if not (mode & stat.S_IWUSR):
            item["issues"].append("owner_not_writable")
    return item


def state_ownership_audit_paths() -> list[Path]:
    paths = [STATE, TASKS, TASKS_LOCK, INBOX, REPORTS]
    if STATE.exists():
        for path in sorted(STATE.iterdir()):
            if path.is_file() and path not in paths:
                paths.append(path)
    if INBOX.exists():
        paths.extend(path for path in sorted(INBOX.iterdir()) if path not in paths)
    return paths


def cmd_state_ownership_audit(args: argparse.Namespace) -> None:
    paths = state_ownership_audit_paths()
    entries = [ownership_entry(path, args.expected_owner, args.expected_group) for path in paths]
    issues = [entry for entry in entries if entry["issues"]]
    payload = {
        "ok": not issues,
        "state_dir": str(STATE),
        "expected_owner": args.expected_owner,
        "expected_group": args.expected_group,
        "entries": entries,
        "issue_count": len(issues),
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        for entry in entries:
            status = "ok" if not entry["issues"] else ",".join(entry["issues"])
            owner = entry.get("owner", "-")
            group = entry.get("group", "-")
            mode = entry.get("mode", "-")
            print(f"{status}\t{owner}:{group}\t{mode}\t{entry['path']}")
        print(f"state_ownership_audit: {'ok' if payload['ok'] else 'failed'} issues={len(issues)}")
    if issues:
        sys.exit(2)


