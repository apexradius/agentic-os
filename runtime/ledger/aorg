def cmd_review(args: argparse.Namespace) -> None:
    role_or_die(args.role)
    evidence = args.evidence or []
    if args.decision == "fail" and not args.defect_type:
        print(
            "--defect-type is required when --decision fail "
            f"(choose one of: {', '.join(sorted(REVIEW_DEFECT_TYPES))})",
            file=sys.stderr,
        )
        sys.exit(2)
    if not evidence:
        print("review evidence is required", file=sys.stderr)
        sys.exit(2)
    missing = [item for item in evidence if not evidence_path_exists(item)]
    if missing:
        print("missing review evidence path: " + ", ".join(missing), file=sys.stderr)
        sys.exit(2)

    with task_write_lock():
        tasks = read_tasks_unlocked()
        task = task_by_id(tasks, args.task_id)
        if not task:
            print(f"task not found: {args.task_id}", file=sys.stderr)
            sys.exit(2)
        reviewer = task.get("reviewer") or other_frontier(task.get("assignee", ""))
        # Council v2: either frontier peer may register a review/challenge (the other
        # frontier is the appeals path now that Gemini is decommissioned), plus Ayo.
        allowed_reviewers = {reviewer, "ayo", *FRONTIER_AGENTS}
        if args.role not in allowed_reviewers:
            print(f"task reviewer is {reviewer}, not {args.role}", file=sys.stderr)
            sys.exit(2)
        review_parent = None
        if task.get("mode") == "completion-review" and task.get("reviews_task"):
            review_parent = task_by_id(tasks, task.get("reviews_task"))
        denial = review_self_denial(task, review_parent, args)
        if denial:
            print(denial, file=sys.stderr)
            sys.exit(2)
        if task.get("status") == "claimed":
            denial = live_claim_denial(task, args)
            if denial:
                print(denial, file=sys.stderr)
                sys.exit(2)
            stamp_task_session(task, args, args.role, claimed=not task_session_matches(task, args))
        elif task.get("mode") == "completion-review" and task.get("status") in {"pending", "blocked"}:
            task["status"] = "claimed"
            stamp_task_session(task, args, args.role, claimed=True)

        review = {
            "reviewer": args.role,
            "decision": args.decision,
            "summary": args.summary,
            "evidence": evidence,
            "reviewed_at": now(),
            "challenge": bool(getattr(args, "challenge", False)),
        }
        if getattr(args, "blind", False):
            _blind_round = str(task.get("reviews_task") or task.get("id"))
            _reg = alias_registry(_blind_round, list(FRONTIER_REVIEW_POOL))
            review["blinded"] = True
            review["reviewer_alias"] = _reg["alias_map"].get(args.role, "Reviewer-?")
        if args.defect_type:
            review["defect_type"] = args.defect_type
            task["defect_type"] = args.defect_type
        task.setdefault("reviews", []).append(review)
        review_target = task
        if task.get("mode") == "completion-review" and task.get("reviews_task"):
            parent = review_parent
            if not parent:
                print(f"review parent not found: {task['reviews_task']}", file=sys.stderr)
                sys.exit(2)
            parent.setdefault("reviews", []).append(review)
            review_target = parent
            task["status"] = "complete"
            task["completed_at"] = review["reviewed_at"]
            task["summary"] = f"Review {args.decision}: {args.summary}"
            task["evidence"] = evidence
            task["files_touched"] = []
            task["risk"] = "Review task"
            task["vna"] = "On pass, parent closes. On fail, the reviewer's repairs re-hand to the other frontier agent for re-review, capped at 2 rounds then escalated to Ayo."
            task["review_passed"] = args.decision == "pass"
            task["reviewed_at"] = review["reviewed_at"]
            task["blocked_reason"] = None
        # User Challenge gate: when 2+ DISTINCT reviewers flag (--challenge) that the
        # user's STATED direction should change, the task must never auto-decide on the
        # reviewers' say-so. It escalates to the human (Ayo), regardless of pass/fail.
        # A single challenge is recorded but does not block (one model can't derail).
        challengers = sorted({
            r["reviewer"] for r in review_target.get("reviews", []) if r.get("challenge")
        })
        if len(challengers) >= 2:
            review_target["status"] = "pending-human"
            review_target["review_passed"] = False
            review_target["reviewed_at"] = review["reviewed_at"]
            review_target["escalated_at"] = review["reviewed_at"]
            review_target["escalation_to"] = "ayo"
            review_target["escalation_priority"] = "P1"
            review_target["blocked_reason"] = (
                "user_challenge:" + ",".join(challengers)
                + " agree the stated direction should change"
            )
            review_target["user_challenge"] = {
                "challengers": challengers,
                "detected_at": review["reviewed_at"],
                "reasons": [
                    {"reviewer": r["reviewer"], "decision": r.get("decision"), "summary": r.get("summary", "")}
                    for r in review_target.get("reviews", []) if r.get("challenge")
                ],
            }
            append_jsonl(STATE / "escalations.jsonl", {
                "task_id": review_target.get("id"),
                "reason": review_target["blocked_reason"],
                "evidence": evidence,
                "priority": "P1",
                "escalation_to": "ayo",
                "requesting_identity": f"aorg-review-gate:{args.role}",
                "timestamp": review["reviewed_at"],
                "kind": "user_challenge",
                **sidecar_owner_fields(f"aorg-review-gate:{args.role}"),
            })
        elif args.decision == "pass":
            review_target["status"] = "complete"
            review_target["review_passed"] = True
            review_target["reviewed_at"] = review["reviewed_at"]
            review_target["blocked_reason"] = None
        elif task.get("mode") == "completion-review":
            # Council v2 capped ping-pong: the reviewer has repaired the defects it
            # found; re-hand to the OTHER frontier agent to re-review the repairs.
            # After COUNCIL_REVIEW_ROUND_CAP rounds without convergence, freeze and
            # escalate to Ayo with the disputed state — never loop forever.
            current_round = int(task.get("review_round", 1))
            review_target["review_passed"] = False
            review_target["reviewed_at"] = review["reviewed_at"]
            review_target["review_round"] = current_round
            if current_round >= COUNCIL_REVIEW_ROUND_CAP:
                review_target["status"] = "pending-human"
                review_target["escalation_to"] = "ayo"
                review_target["escalation_priority"] = "P1"
                review_target["escalated_at"] = review["reviewed_at"]
                review_target["blocked_reason"] = (
                    f"council_review_cap_reached:{current_round}_rounds:{args.summary}"
                )
                append_jsonl(STATE / "escalations.jsonl", {
                    "task_id": review_target.get("id"),
                    "reason": review_target["blocked_reason"],
                    "evidence": evidence,
                    "priority": "P1",
                    "escalation_to": "ayo",
                    "requesting_identity": f"aorg-review-gate:{args.role}",
                    "timestamp": review["reviewed_at"],
                    "kind": "council_review_cap",
                    **sidecar_owner_fields(f"aorg-review-gate:{args.role}"),
                })
            else:
                next_reviewer = other_frontier(args.role)
                review_target["status"] = "review-pending"
                review_target["reviewer"] = next_reviewer
                review_target["blocked_reason"] = f"completion_review_rehanded:{next_reviewer}"
                create_review_task(tasks, review_target, next_reviewer)
        else:
            review_target["status"] = "blocked"
            review_target["review_passed"] = False
            review_target["blocked_reason"] = f"completion_review_failed:{args.summary}"

        for candidate in tasks:
            if candidate.get("reviews_task") == args.task_id and candidate.get("assignee") == args.role and candidate.get("status") not in {"complete", "cancelled", "failed"}:
                candidate["status"] = "complete"
                candidate["completed_at"] = review["reviewed_at"]
                candidate["summary"] = f"Review {args.decision}: {args.summary}"
                candidate["evidence"] = evidence
                candidate["files_touched"] = []
                candidate["risk"] = "Review task"
                candidate["vna"] = "On pass, parent closes. On fail, the reviewer's repairs re-hand to the other frontier agent for re-review, capped at 2 rounds then escalated to Ayo."
        report_title = task.get("title")
        write_tasks_unlocked(tasks)

    report = REPORTS / f"{args.task_id}-review-{args.role}.md"
    report.write_text(
        "\n".join(
            [
                f"# Review: {report_title}",
                "",
                f"Task: `{args.task_id}`",
                f"Reviewer: `{args.role}`",
                f"Decision: `{args.decision}`",
                *([f"Defect type: `{args.defect_type}`"] if args.defect_type else []),
                f"Reviewed: {review['reviewed_at']}",
                "",
                "## Summary",
                args.summary,
                "",
                "## Evidence",
                "\n".join(f"- {p}" for p in evidence),
                "",
            ]
        ),
        encoding="utf-8",
    )
    print(f"review {args.decision} {args.task_id}")
    print(report)


def cmd_cancel(args: argparse.Namespace) -> None:
    if args.by in load_roles():
        role_or_die(args.by)
    tasks, task = find_task(args.task_id)
    previous_status = args.previous_status or task.get("previous_status") or task.get("status")
    if task.get("status") == "complete" and not args.force:
        print("task is complete; use --force only for audit repair", file=sys.stderr)
        sys.exit(2)
    if task.get("status") == "cancelled" and not args.force:
        print(f"already cancelled {args.task_id}")
        return
    task["status"] = "cancelled"
    task["cancelled_at"] = now()
    task["cancelled_by"] = args.by
    task["cancelled_reason"] = args.reason
    task["previous_status"] = previous_status
    if args.superseded_by:
        task["superseded_by"] = args.superseded_by
    for field in ("completed_at", "summary", "evidence", "files_touched", "risk", "vna"):
        task.pop(field, None)
    write_tasks(tasks)
    append_jsonl(
        STATE / "cancellations.jsonl",
        {
            "task_id": args.task_id,
            "reason": args.reason,
            "cancelled_by": args.by,
            "superseded_by": args.superseded_by,
            "forced": args.force,
            "timestamp": task["cancelled_at"],
        },
    )
    print(f"cancelled {args.task_id}: {args.reason}")


