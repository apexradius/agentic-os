def task_has_actionable_vna(task: dict) -> bool:
    if task.get("status") not in OPEN_STATUSES or not task.get("vna"):
        return False
    if task.get("review_passed") is False:
        return False
    blocked_reason = str(task.get("blocked_reason") or "")
    if blocked_reason.startswith("completion_review_failed:"):
        return False
    return True


def task_feed_record(task: dict, *, include_task: bool = False) -> dict:
    record = {
        "id": task.get("id"),
        "title": redact_text(task.get("title"), max_chars=240),
        "assignee": task.get("assignee"),
        "priority": task.get("priority"),
        "status": task.get("status"),
        "mode": task.get("mode"),
        "risk_level": task.get("risk_level"),
        "repo": redact_text(task.get("repo"), max_chars=300),
        "created_at": task.get("created_at"),
        "claimed_at": task.get("claimed_at"),
        "claimed_by": task.get("claimed_by"),
        "last_heartbeat_at": task.get("last_heartbeat_at"),
        "last_heartbeat_by": task.get("last_heartbeat_by"),
        "completed_at": task.get("completed_at"),
        "cancelled_at": task.get("cancelled_at"),
        "review_required": bool(task.get("review_required")),
        "reviewer": task.get("reviewer"),
        "review_passed": task.get("review_passed"),
        "reviewed_at": task.get("reviewed_at"),
        "blocked_reason": redact_text(task.get("blocked_reason"), max_chars=500),
        "escalation_to": task.get("escalation_to"),
        "depends_on": task.get("depends_on") or [],
        "evidence": [redact_text(item, max_chars=300) for item in task.get("evidence", [])[-3:]],
        "vna": redact_text(task.get("vna"), max_chars=700),
    }
    if include_task:
        record["task"] = redact_text(task.get("task"), max_chars=1200)
    return record


def task_liveness_at(task: dict) -> datetime | None:
    return parse_ts(task.get("last_heartbeat_at")) or parse_ts(task.get("claimed_at")) or parse_ts(task.get("created_at"))


def feed_event(timestamp: str | None, kind: str, task: dict, **extra: object) -> dict | None:
    if not timestamp:
        return None
    return {
        "at": timestamp,
        "kind": kind,
        "task_id": task.get("id"),
        "assignee": task.get("assignee"),
        "status": task.get("status"),
        "priority": task.get("priority"),
        "title": redact_text(task.get("title"), max_chars=240),
        **extra,
    }


def task_events(task: dict) -> list[dict]:
    candidates = [
        feed_event(task.get("created_at"), "task_created", task),
        feed_event(task.get("claimed_at"), "task_claimed", task, actor=task.get("claimed_by")),
        feed_event(task.get("last_heartbeat_at"), "task_heartbeat", task, actor=task.get("last_heartbeat_by")),
        feed_event(task.get("completed_at"), "task_completed", task),
        feed_event(task.get("cancelled_at"), "task_cancelled", task, actor=task.get("cancelled_by")),
        feed_event(task.get("reviewed_at"), "task_reviewed", task, reviewer=task.get("reviewer"), review_passed=task.get("review_passed")),
        feed_event(task.get("completion_candidate_at"), "completion_candidate", task),
    ]
    return [event for event in candidates if event is not None]


def sidecar_event_record(path: Path, record: dict) -> dict:
    timestamp = (
        record.get("timestamp")
        or record.get("created_at")
        or record.get("approved_at")
        or record.get("cancelled_at")
        or record.get("paused_at")
        or record.get("resumed_at")
        or record.get("requeued_at")
        or now()
    )
    return {
        "at": timestamp,
        "kind": f"ledger_{path.stem}",
        "task_id": record.get("task_id"),
        "source": path.name,
        "summary": redact_text(record, max_chars=900),
    }


def build_event_feed_payload(args: argparse.Namespace) -> dict:
    tasks, parse_errors = read_tasks_readonly()
    generated_at = now()
    counts: dict[str, int] = {}
    queue_depth: dict[str, dict[str, int]] = {}
    for task in tasks:
        status = task.get("status", "unknown")
        assignee = task.get("assignee") or "unassigned"
        counts[status] = counts.get(status, 0) + 1
        if status in OPEN_STATUSES:
            queue_depth.setdefault(assignee, {})
            queue_depth[assignee][status] = queue_depth[assignee].get(status, 0) + 1

    cutoff = current_datetime() - timedelta(hours=args.stale_hours)
    stale_claimed = [
        task_feed_record(task, include_task=False)
        for task in tasks
        if task.get("status") == "claimed" and task_liveness_at(task) and task_liveness_at(task) < cutoff
    ]
    pending_human = [
        task_feed_record(task, include_task=args.include_task)
        for task in tasks
        if task.get("status") == "pending-human"
    ][: args.open_limit]
    pending_reviews = [
        task_feed_record(task, include_task=args.include_task)
        for task in tasks
        if task.get("status") == "review-pending"
        or (task.get("status") in OPEN_STATUSES and task.get("review_required") and task.get("review_passed") is not True)
    ][: args.open_limit]
    open_tasks = [
        task_feed_record(task, include_task=args.include_task)
        for task in tasks
        if task.get("status") in OPEN_STATUSES
        and (not args.assignee or task.get("assignee") in set(args.assignee))
        and (not args.status or task.get("status") in set(args.status))
    ]

    events: list[dict] = []
    for task in tasks:
        if args.assignee and task.get("assignee") not in set(args.assignee):
            continue
        if args.status and task.get("status") not in set(args.status):
            continue
        events.extend(task_events(task))

    for name in ("approvals.jsonl", "cancellations.jsonl", "escalations.jsonl", "halts.jsonl", "stale_claims.jsonl"):
        records, errors = read_jsonl_readonly(STATE / name, limit=args.sidecar_limit)
        parse_errors.extend(errors)
        events.extend(sidecar_event_record(STATE / name, record) for record in records)

    since = parse_filter_ts(args.since)
    if since:
        events = [event for event in events if parse_filter_ts(str(event.get("at") or "")) and parse_filter_ts(str(event.get("at") or "")) >= since]
    events.sort(key=lambda event: (event.get("at") or "", event.get("task_id") or "", event.get("kind") or ""), reverse=True)
    events = events[: args.limit]

    halt = None
    if HALT_FILE.exists():
        try:
            halt = json.loads(HALT_FILE.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            parse_errors.append({"path": str(HALT_FILE), "line": 1, "error": f"{exc.msg} at column {exc.colno}"})

    source_sha256 = hashlib.sha256(TASKS.read_bytes()).hexdigest() if TASKS.exists() else None
    return {
        "schema": "aorg.event-feed.v1",
        "generated_at": generated_at,
        "source": str(TASKS),
        "source_sha256": source_sha256,
        "read_only": True,
        "ok": not parse_errors,
        "parse_errors": parse_errors,
        "halt": halt if halt and halt.get("active") else None,
        "counts": counts,
        "queue_depth": queue_depth,
        "stale_claimed": stale_claimed,
        "pending_human": pending_human,
        "pending_reviews": pending_reviews,
        "open_tasks": open_tasks[: args.open_limit],
        "events": events,
    }


def render_event_feed_text(payload: dict) -> str:
    lines = [
        "Apex AI Org Event Feed",
        f"generated: {payload.get('generated_at')}",
        f"source_sha256: {payload.get('source_sha256')}",
        f"ok: {payload.get('ok')}",
        "counts:",
    ]
    for status, count in sorted((payload.get("counts") or {}).items()):
        lines.append(f"- {status}: {count}")
    lines.append("queue_depth:")
    for assignee, counts in sorted((payload.get("queue_depth") or {}).items()):
        rendered = ", ".join(f"{status}={count}" for status, count in sorted(counts.items()))
        lines.append(f"- {assignee}: {rendered}")
    lines.append("events:")
    for event in payload.get("events", [])[:20]:
        lines.append(f"- {event.get('at')} {event.get('kind')} {event.get('task_id') or ''} {event.get('title') or ''}".rstrip())
    return "\n".join(lines) + "\n"


def cmd_event_feed(args: argparse.Namespace) -> None:
    payload = build_event_feed_payload(args)
    if args.json:
        print(json.dumps(payload, indent=2 if args.pretty else None, sort_keys=True))
    else:
        print(render_event_feed_text(payload), end="")


