def load_playbook() -> dict:
    """Operational playbook (VPS service/probe/billing-scan inventory) from AORG_PLAYBOOK (JSON).
    Empty/unset => empty playbook (no known services/probes/scan roots) — correct neutral default."""
    path = os.environ.get("AORG_PLAYBOOK")
    if not path:
        return {}
    try:
        with open(Path(path).expanduser(), encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


