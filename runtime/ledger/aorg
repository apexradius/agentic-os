def workspace_rel(path: Path) -> str:
    try:
        return str(path.resolve().relative_to(WORKSPACE.resolve()))
    except OSError:
        return str(path)
    except ValueError:
        return str(path)


def iter_doctor_files(match: callable) -> list[Path]:
    found: list[Path] = []
    for root in DOCTOR_SCAN_ROOTS:
        if not root.exists():
            continue
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [name for name in dirnames if name not in DOCTOR_PRUNE_DIRS]
            current = Path(dirpath)
            for filename in filenames:
                path = current / filename
                if match(path):
                    found.append(path)
    return found


def run_biome_doctor(results: list[tuple[str, str, str]]) -> None:
    def ancestor_has_biome(directory: Path) -> bool:
        current = directory
        workspace_root = WORKSPACE.resolve()
        while True:
            if (current / "biome.json").exists() or (current / "biome.jsonc").exists():
                return True
            package = current / "package.json"
            if package.exists():
                try:
                    data = json.loads(package.read_text(encoding="utf-8"))
                except Exception:
                    data = {}
                dependencies = {}
                for key in ("dependencies", "devDependencies", "peerDependencies", "optionalDependencies"):
                    value = data.get(key) if isinstance(data, dict) else None
                    if isinstance(value, dict):
                        dependencies.update(value)
                if "@biomejs/biome" in dependencies:
                    return True
            if current == workspace_root or current.parent == current:
                return False
            try:
                current = current.parent
            except Exception:
                return False

    packages = []
    for path in iter_doctor_files(lambda candidate: candidate.name == "package.json"):
        parts = {part.lower() for part in path.parts}
        if parts & {"skills", "test-project", "fixtures", "examples", "github-green"}:
            continue
        packages.append(path)
    biome_ready = 0
    legacy_candidates: list[str] = []
    for package in packages:
        try:
            data = json.loads(package.read_text(encoding="utf-8"))
        except Exception:
            continue
        dependencies = {}
        for key in ("dependencies", "devDependencies", "peerDependencies", "optionalDependencies"):
            value = data.get(key)
            if isinstance(value, dict):
                dependencies.update(value)
        directory = package.parent
        scripts = data.get("scripts") if isinstance(data.get("scripts"), dict) else {}
        uses_biome_script = any(
            isinstance(command, str) and re.search(r"(^|[\s:])biome(\s|$)", command)
            for command in scripts.values()
        )
        has_biome = "@biomejs/biome" in dependencies or any(
            (directory / name).exists() for name in ("biome.json", "biome.jsonc")
        ) or (uses_biome_script and ancestor_has_biome(directory))
        has_legacy = any(name in dependencies for name in ("eslint", "prettier")) or any(
            (directory / name).exists()
            for name in (
                ".eslintrc",
                ".eslintrc.js",
                ".eslintrc.cjs",
                ".prettierrc",
                ".prettierrc.json",
                ".prettierrc.js",
                "eslint.config.js",
                "eslint.config.mjs",
                "eslint.config.cjs",
            )
        )
        if has_biome:
            biome_ready += 1
        elif has_legacy:
            legacy_candidates.append(workspace_rel(directory))
    detail = f"packages={len(packages)} biome_ready={biome_ready} legacy_candidates={len(legacy_candidates)}"
    if legacy_candidates:
        detail += " sample=" + ", ".join(legacy_candidates[:4])
        doctor_report(results, "WARN", "Biome standard", detail)
    else:
        doctor_report(results, "PASS", "Biome standard", detail)


