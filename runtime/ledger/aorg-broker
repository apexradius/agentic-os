class BrokerError(Exception):
    pass


def socket_path(args: argparse.Namespace) -> Path:
    return Path(args.socket or DEFAULT_SOCKET).expanduser()


def pid_path(args: argparse.Namespace) -> Path:
    return Path(args.pid_file or DEFAULT_PID).expanduser()


def log_path(args: argparse.Namespace) -> Path:
    return Path(args.log_file or DEFAULT_LOG).expanduser()


def write_response(conn: socket.socket, *, exit_code: int, stdout: str = "", stderr: str = "") -> None:
    payload = json.dumps({"exit_code": exit_code, "stdout": stdout, "stderr": stderr}, separators=(",", ":"))
    conn.sendall(payload.encode("utf-8"))


def read_request(conn: socket.socket) -> dict:
    data = bytearray()
    while b"\n" not in data:
        chunk = conn.recv(65536)
        if not chunk:
            break
        data.extend(chunk)
        if len(data) > MAX_REQUEST_BYTES:
            raise BrokerError("request_too_large")
    if not data:
        raise BrokerError("empty_request")
    line = bytes(data).split(b"\n", 1)[0]
    try:
        request = json.loads(line.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise BrokerError(f"invalid_json:{exc}") from exc
    if not isinstance(request, dict):
        raise BrokerError("request_must_be_object")
    return request


def validate_env(raw: object) -> dict[str, str]:
    if not isinstance(raw, dict):
        return {}
    allowed: dict[str, str] = {}
    for key in ("APEX_AGENT_IDENTITY", "APEX_AGENT_HOST", "APEX_AGENT_PID"):
        value = raw.get(key)
        if value is None:
            continue
        if not isinstance(value, str) or "\x00" in value or len(value) > 512:
            raise BrokerError(f"invalid_env:{key}")
        allowed[key] = value
    return allowed


def tailnet_host_rows() -> list[dict[str, str]]:
    rows: list[dict[str, str]] = []
    seen: set[str] = set()
    for alias, target in TAILNET_HOSTS.items():
        if alias in seen:
            continue
        seen.add(alias)
        rows.append({"alias": alias, "target": target})
    for user in sorted(VPS_USERS):
        alias = f"{user}@vps"
        if alias not in seen:
            rows.append({"alias": alias, "target": f"{user}@{VPS_CANONICAL_TARGET}"})
    return rows


def resolve_tailnet_host(raw_host: str) -> tuple[str, str | None]:
    host = raw_host.strip().casefold()
    target = TAILNET_HOSTS.get(host)
    if target:
        return target, None
    if "@" in host:
        user, alias = host.split("@", 1)
        if user in VPS_USERS and alias in VPS_ALIASES:
            if user in DIRECT_LOGIN_USERS:
                return f"{user}@{VPS_CANONICAL_TARGET}", None
            return f"root@{VPS_CANONICAL_TARGET}", user
    raise BrokerError("tailnet_host_denied")


def validate_tailnet_token(token: str) -> str:
    if not isinstance(token, str) or "\x00" in token or "\n" in token or "\r" in token:
        raise BrokerError("invalid_remote_token")
    if len(token.encode("utf-8")) > 2048:
        raise BrokerError("remote_token_too_large")
    if token in TAILNET_DENIED_ARGS or any(value in token for value in ("\n", "\r", "\x00")):
        raise BrokerError("remote_shell_control_denied")
    if REMOTE_SECRET_PATH_RE.search(token):
        raise BrokerError("remote_secret_path_denied")
    return token


def validate_tailnet_command(raw: object) -> list[str]:
    if not isinstance(raw, list) or not raw:
        raise BrokerError("remote_command_must_be_nonempty_list")
    if len(raw) > 32:
        raise BrokerError("remote_command_too_many_args")
    argv = [validate_tailnet_token(item) for item in raw]
    executable = Path(argv[0]).name.casefold()
    if executable in TAILNET_DENIED_EXECUTABLES:
        raise BrokerError("remote_executable_denied")
    folded = tuple(item.casefold() for item in argv)
    if not any(folded[: len(prefix)] == prefix for prefix in TAILNET_ALLOWED_PREFIXES):
        raise BrokerError("remote_command_not_allowlisted")
    if executable == "curl":
        validate_tailnet_curl(argv)
    return argv


def validate_tailnet_curl(argv: list[str]) -> None:
    denied_flags = {"-d", "--data", "--data-raw", "--data-binary", "-F", "--form", "-o", "--output", "-O", "-T", "--upload-file"}
    for item in argv[1:]:
        lowered = item.casefold()
        if lowered in denied_flags or lowered.startswith("-x") or lowered in {"-X", "--request"}:
            raise BrokerError("remote_curl_write_denied")
    urls = [item for item in argv[1:] if item.startswith(("http://", "https://"))]
    if not urls:
        raise BrokerError("remote_curl_missing_url")
    for url in urls:
        if not url.startswith(("http://localhost", "http://127.0.0.1", "https://localhost", "https://127.0.0.1")):
            raise BrokerError("remote_curl_nonlocal_url_denied")


def validate_tailnet_request(request: dict) -> tuple[str, list[str], int]:
    raw_host = request.get("host")
    if not isinstance(raw_host, str):
        raise BrokerError("tailnet_host_missing")
    target, run_as = resolve_tailnet_host(raw_host)
    argv = validate_tailnet_command(request.get("command"))
    timeout_raw = request.get("timeout", 30)
    try:
        timeout = int(timeout_raw)
    except (TypeError, ValueError) as exc:
        raise BrokerError("tailnet_timeout_invalid") from exc
    if timeout < 1 or timeout > 120:
        raise BrokerError("tailnet_timeout_out_of_range")
    return target, argv, timeout, run_as


def ssh_command(timeout: int) -> list[str]:
    command = ["ssh", "-T", "-o", "BatchMode=yes", "-o", f"ConnectTimeout={min(timeout, 30)}"]
    key_path = Path(os.environ.get("AORG_SSH_KEY", "~/.ssh/id_ed25519")).expanduser()
    try:
        key_present = key_path.exists()
    except OSError:
        key_present = False
    if key_present:
        command.extend(["-F", "/dev/null", "-i", str(key_path), "-o", "IdentitiesOnly=yes"])
    return command


def run_tailnet_ssh(request: dict) -> dict:
    target, argv, timeout, run_as = validate_tailnet_request(request)
    remote_command = " ".join(shlex.quote(part) for part in argv)
    if run_as:
        remote_home = VPS_USER_HOMES.get(run_as, f"/home/{run_as}")
        remote_command = (
            "cd "
            + shlex.quote(remote_home)
            + " && sudo -H -n -u "
            + shlex.quote(run_as)
            + " -- "
            + remote_command
        )
    proc = subprocess.run(
        [*ssh_command(timeout), target, remote_command],
        cwd=str(WORKSPACE),
        text=True,
        capture_output=True,
        timeout=timeout + 5,
    )
    return {"exit_code": proc.returncode, "stdout": proc.stdout, "stderr": proc.stderr}


def validate_path(value: str) -> None:
    expanded_path = Path(value).expanduser()
    if not expanded_path.is_absolute():
        expanded_path = WORKSPACE / expanded_path
    resolved_path = expanded_path.resolve(strict=False)
    expanded = str(expanded_path)
    resolved = str(resolved_path)
    if SECRET_PATH_RE.search(expanded) or SECRET_PATH_RE.search(resolved):
        raise BrokerError("secret_path_denied")
    if not any(resolved_path == root or root in resolved_path.parents for root in SAFE_PATH_ROOTS):
        raise BrokerError("path_outside_safe_prefix")


def validate_argv(raw: object) -> list[str]:
    if not isinstance(raw, list) or not raw:
        raise BrokerError("argv_must_be_nonempty_list")
    if len(raw) > MAX_ARG_COUNT:
        raise BrokerError("too_many_args")
    argv: list[str] = []
    for item in raw:
        if not isinstance(item, str) or "\x00" in item:
            raise BrokerError("invalid_arg")
        if len(item.encode("utf-8")) > MAX_ARG_BYTES:
            raise BrokerError("arg_too_large")
        argv.append(item)
    verb = argv[0]
    if verb not in ALLOWED_VERBS:
        raise BrokerError("verb_denied")
    if len(argv) == 2 and argv[1] in HELP_FLAGS:
        return argv
    validate_basic_shape(argv)
    validate_path_flags(argv)
    return argv


def validate_basic_shape(argv: list[str]) -> None:
    verb = argv[0]
    positional_count = POSITIONAL_COUNTS[verb]
    if len(argv) < 1 + positional_count:
        raise BrokerError("missing_required_positionals")
    positionals = argv[1 : 1 + positional_count]
    extras = argv[1 + positional_count :]

    if verb in {"brief", "assign", "inbox"} and not ROLE_RE.match(positionals[0]):
        raise BrokerError("invalid_role")
    if verb in {"claim", "heartbeat", "verify", "record-verification", "complete", "block", "review"}:
        if not ROLE_RE.match(positionals[0]):
            raise BrokerError("invalid_role")
        if not TASK_RE.match(positionals[1]):
            raise BrokerError("invalid_task_id")
    if verb in {"cancel", "escalate"} and not TASK_RE.match(positionals[0]):
        raise BrokerError("invalid_task_id")

    flags = validate_allowed_flags(verb, extras)
    validate_required_flags(verb, flags)
    validate_flag_values(verb, flags)


def validate_allowed_flags(verb: str, args: list[str]) -> dict[str, list[str]]:
    spec = FLAG_SPECS[verb]
    flags: dict[str, list[str]] = {}
    idx = 0
    while idx < len(args):
        token = args[idx]
        if token in spec["bool"]:
            flags.setdefault(token, [])
            idx += 1
            continue
        if token in spec["single"]:
            idx += 1
            if idx >= len(args) or args[idx].startswith("--"):
                raise BrokerError(f"flag_missing_value:{token}")
            validate_flag_arg(token, args[idx])
            flags.setdefault(token, []).append(args[idx])
            idx += 1
            continue
        if token in spec["multi"]:
            values: list[str] = []
            idx += 1
            while idx < len(args) and not args[idx].startswith("--"):
                validate_flag_arg(token, args[idx])
                values.append(args[idx])
                idx += 1
            flags.setdefault(token, []).extend(values)
            continue
        raise BrokerError(f"flag_denied:{token}")
    return flags


def validate_required_flags(verb: str, flags: dict[str, list[str]]) -> None:
    for flag in REQUIRED_FLAGS.get(verb, set()):
        if flag not in flags:
            raise BrokerError(f"required_flag_missing:{flag}")


def validate_flag_arg(flag: str, value: str) -> None:
    if flag in PATH_FLAGS:
        validate_path(value)
    if flag in {"--agent-pid", "--timeout", "--exit-code", "--limit", "--open-limit", "--sidecar-limit"}:
        try:
            int(value)
        except ValueError as exc:
            raise BrokerError(f"invalid_integer:{flag}") from exc
    if flag == "--stale-hours":
        try:
            float(value)
        except ValueError as exc:
            raise BrokerError(f"invalid_float:{flag}") from exc


def validate_flag_values(verb: str, flags: dict[str, list[str]]) -> None:
    role_flags = {"--reviewer", "--escalation-to", "--to", "--by"}
    for flag in role_flags:
        for value in flags.get(flag, []):
            if not ROLE_RE.match(value):
                raise BrokerError(f"invalid_role:{flag}")
    for flag in {"--superseded-by"}:
        for value in flags.get(flag, []):
            if not TASK_RE.match(value):
                raise BrokerError(f"invalid_task_id:{flag}")
    for value in flags.get("--priority", []):
        if not PRIORITY_RE.match(value):
            raise BrokerError("invalid_priority")
    for value in flags.get("--risk-level", []):
        if value not in RISK_LEVELS:
            raise BrokerError("invalid_risk_level")
    for value in flags.get("--decision", []):
        if value not in REVIEW_DECISIONS:
            raise BrokerError("invalid_review_decision")
    for flag in {"--created-by", "--allowlist-identity", "--requesting-identity", "--sandbox-profile", "--mode"}:
        for value in flags.get(flag, []):
            if not SAFE_VALUE_RE.match(value):
                raise BrokerError(f"invalid_value:{flag}")
    for flag in {"--started-at", "--completed-at"}:
        for value in flags.get(flag, []):
            if not ISOISH_RE.match(value):
                raise BrokerError(f"invalid_timestamp:{flag}")
    for value in flags.get("--since", []):
        if not ISOISH_RE.match(value):
            raise BrokerError("invalid_timestamp:--since")
    for value in flags.get("--assignee", []):
        if not ROLE_RE.match(value):
            raise BrokerError("invalid_role:--assignee")
    for value in flags.get("--status", []):
        if value not in STATUS_VALUES:
            raise BrokerError("invalid_status")
    for flag in {"--limit", "--open-limit", "--sidecar-limit"}:
        for value in flags.get(flag, []):
            numeric_value = int(value)
            if numeric_value < 0 or numeric_value > 500:
                raise BrokerError(f"integer_out_of_range:{flag}")
    for value in flags.get("--stale-hours", []):
        numeric_value = float(value)
        if numeric_value < 0 or numeric_value > 168:
            raise BrokerError("float_out_of_range:--stale-hours")
    if verb == "review" and flags.get("--decision") and flags["--decision"][-1] not in REVIEW_DECISIONS:
        raise BrokerError("invalid_review_decision")


def validate_path_flags(argv: list[str]) -> None:
    idx = 0
    while idx < len(argv):
        token = argv[idx]
        if token not in PATH_FLAGS:
            idx += 1
            continue
        idx += 1
        if idx >= len(argv) or argv[idx].startswith("--"):
            raise BrokerError("path_flag_missing_value")
        while idx < len(argv) and not argv[idx].startswith("--"):
            validate_path(argv[idx])
            idx += 1


def run_aorg(argv: list[str], forwarded_env: dict[str, str]) -> dict:
    env = os.environ.copy()
    env["AORG_BROKER_DISABLE"] = "1"
    env["AORG_CANONICAL_MODE"] = "vps"
    for key, value in forwarded_env.items():
        if value:
            env[key] = value
    timeout = int(os.environ.get("AORG_BROKER_SUBPROCESS_TIMEOUT", "1200"))
    proc = subprocess.run(
        [sys.executable, str(AORG_BIN), *argv],
        cwd=str(WORKSPACE),
        env=env,
        text=True,
        capture_output=True,
        timeout=timeout,
    )
    return {"exit_code": proc.returncode, "stdout": proc.stdout, "stderr": proc.stderr}


def handle_client(conn: socket.socket) -> None:
    try:
        request = read_request(conn)
        if request.get("ping") is True:
            write_response(conn, exit_code=0, stdout="pong\n")
            return
        if request.get("tailnet_hosts") is True:
            write_response(conn, exit_code=0, stdout=json.dumps(tailnet_host_rows(), indent=2) + "\n")
            return
        if request.get("tailnet_ssh") is True:
            result = run_tailnet_ssh(request)
            write_response(conn, **result)
            return
        argv = validate_argv(request.get("argv"))
        forwarded_env = validate_env(request.get("env"))
        result = run_aorg(argv, forwarded_env)
        write_response(conn, **result)
    except subprocess.TimeoutExpired:
        write_response(conn, exit_code=124, stderr="aorg broker subprocess timeout\n")
    except BrokerError as exc:
        write_response(conn, exit_code=2, stderr=f"aorg broker rejected request: {exc}\n")
    except Exception as exc:  # defensive: never crash the broker on one client request
        with contextlib.suppress(OSError):
            write_response(conn, exit_code=2, stderr=f"aorg broker internal error: {type(exc).__name__}\n")


def secure_existing_socket(path: Path) -> bool:
    try:
        info = path.stat()
    except OSError:
        return False
    return stat.S_ISSOCK(info.st_mode) and info.st_uid == os.getuid() and stat.S_IMODE(info.st_mode) & 0o077 == 0


def remove_stale_socket(path: Path) -> None:
    if not path.exists():
        return
    if secure_existing_socket(path):
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
                client.settimeout(0.2)
                client.connect(str(path))
                raise BrokerError("broker_already_running")
        except (ConnectionRefusedError, TimeoutError, OSError):
            path.unlink()
            return
    raise BrokerError("unsafe_existing_socket")


def serve(args: argparse.Namespace) -> int:
    sock_path = socket_path(args)
    pid_file = pid_path(args)
    sock_path.parent.mkdir(parents=True, exist_ok=True)
    remove_stale_socket(sock_path)
    old_umask = os.umask(0o177)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        server.bind(str(sock_path))
    finally:
        os.umask(old_umask)
    os.chmod(sock_path, 0o600)
    pid_file.write_text(str(os.getpid()) + "\n", encoding="utf-8")
    os.chmod(pid_file, 0o600)
    stop = False

    def request_stop(_signum: int, _frame: object) -> None:
        nonlocal stop
        stop = True
        try:
            server.close()
        except OSError:
            pass

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    server.listen(16)
    server.settimeout(0.5)
    try:
        while not stop:
            try:
                conn, _ = server.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            with conn:
                handle_client(conn)
    finally:
        with contextlib.suppress(OSError):
            server.close()
        with contextlib.suppress(OSError):
            if sock_path.exists():
                sock_path.unlink()
        with contextlib.suppress(OSError):
            if pid_file.exists() and pid_file.read_text(encoding="utf-8").strip() == str(os.getpid()):
                pid_file.unlink()
    return 0


def broker_running(sock_path: Path) -> bool:
    if not secure_existing_socket(sock_path):
        return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(0.5)
            client.connect(str(sock_path))
            client.sendall(b'{"ping":true}\n')
            client.recv(128)
            return True
    except OSError:
        return False


def start(args: argparse.Namespace) -> int:
    sock_path = socket_path(args)
    if broker_running(sock_path):
        print(f"aorg-broker running socket={sock_path}")
        return 0
    log_file = log_path(args)
    log_file.parent.mkdir(parents=True, exist_ok=True)
    log_handle = log_file.open("a", encoding="utf-8")
    proc = subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "--socket", str(sock_path), "--pid-file", str(pid_path(args)), "serve"],
        cwd=str(ROOT),
        stdout=log_handle,
        stderr=log_handle,
        start_new_session=True,
    )
    deadline = time.time() + 5
    while time.time() < deadline:
        if broker_running(sock_path):
            print(f"aorg-broker started pid={proc.pid} socket={sock_path}")
            return 0
        if proc.poll() is not None:
            print(f"aorg-broker failed to start; see {log_file}", file=sys.stderr)
            return proc.returncode or 1
        time.sleep(0.1)
    print(f"aorg-broker start timed out; see {log_file}", file=sys.stderr)
    return 1


def status(args: argparse.Namespace) -> int:
    sock_path = socket_path(args)
    if broker_running(sock_path):
        print(f"aorg-broker running socket={sock_path}")
        return 0
    print(f"aorg-broker stopped socket={sock_path}")
    return 1


def stop(args: argparse.Namespace) -> int:
    pid_file = pid_path(args)
    if not pid_file.exists():
        print("aorg-broker stopped")
        return 0
    try:
        pid = int(pid_file.read_text(encoding="utf-8").strip())
    except ValueError:
        pid_file.unlink()
        print("aorg-broker stopped")
        return 0
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pid_file.unlink(missing_ok=True)
        print("aorg-broker stopped")
        return 0
    deadline = time.time() + 5
    while time.time() < deadline:
        if not pid_file.exists():
            print("aorg-broker stopped")
            return 0
        time.sleep(0.1)
    print("aorg-broker stop timed out", file=sys.stderr)
    return 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="aorg-broker", description="AORG verb-only Unix socket broker")
    parser.add_argument("--socket", default=str(DEFAULT_SOCKET))
    parser.add_argument("--pid-file", default=str(DEFAULT_PID))
    parser.add_argument("--log-file", default=str(DEFAULT_LOG))
    sub = parser.add_subparsers(required=True)
    sub.add_parser("serve").set_defaults(func=serve)
    sub.add_parser("start").set_defaults(func=start)
    sub.add_parser("status").set_defaults(func=status)
    sub.add_parser("stop").set_defaults(func=stop)
    return parser


def main() -> None:
    args = build_parser().parse_args()
    sys.exit(args.func(args))


if __name__ == "__main__":
    main()
