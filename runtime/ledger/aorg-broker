def load_ssh_targets() -> dict:
    """Load the fleet topology from AORG_SSH_TARGETS (JSON). Empty/unset => no known hosts."""
    path = os.environ.get("AORG_SSH_TARGETS")
    if not path:
        return {}
    try:
        with open(Path(path).expanduser(), encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


