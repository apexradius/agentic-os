#!/usr/bin/env bash
# aorg-broker-watchdog
# Keeps the aorg broker socket alive so Claude Code (running sandboxed) always has
# VPS access via tailnet-ssh. Plain launchd KeepAlive only restarts on process EXIT;
# it does NOT catch the "process alive but socket dead/unresponsive" wedge that has
# left the broker silently down. This watchdog pings the socket and forces a clean
# (launchd-spawned) restart when unhealthy.
#
# Run on a StartInterval via the watchdog launchd plist (every 60s)
# plus RunAtLoad, so it heals within <=60s of any wedge and at every login/reboot.
set -uo pipefail

UID_NUM="$(id -u)"
LABEL="${AORG_BROKER_LABEL:-aorg-broker}"
SOCK="${AORG_BROKER_SOCKET:-/private/tmp/aorg-broker-${UID_NUM}.sock}"
PLIST="${AORG_BROKER_PLIST:-$HOME/Library/LaunchAgents/${LABEL}.plist}"
PY="${AORG_PYTHON:-python3}"
BROKER="${AORG_BROKER_BIN:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/aorg-broker}"
LOG="${AORG_BROKER_WATCHDOG_LOG:-/private/tmp/aorg-broker-watchdog.log}"

stamp() { date '+%Y-%m-%dT%H:%M:%S%z'; }

healthy() {
  "$PY" "$BROKER" --socket "$SOCK" status 2>/dev/null | grep -q 'running'
}

# Fast path: broker answers the ping -> nothing to do.
if healthy; then
  exit 0
fi

echo "$(stamp) broker unhealthy (socket=$SOCK) — recovering" >> "$LOG"

# Ensure the job is registered + enabled, then force launchd to respawn it clean.
# kickstart spawns via launchd (parent = launchd), which binds the socket fine;
# spawning the broker directly here would inherit context that can EPERM on bind.
launchctl bootstrap "gui/${UID_NUM}" "$PLIST"                 >> "$LOG" 2>&1 || true
launchctl enable    "gui/${UID_NUM}/${LABEL}"                 >> "$LOG" 2>&1 || true
launchctl kickstart -k "gui/${UID_NUM}/${LABEL}"             >> "$LOG" 2>&1 || true

# Give launchd a moment to bind, then confirm.
sleep 3
if healthy; then
  echo "$(stamp) broker recovered" >> "$LOG"
  exit 0
fi
echo "$(stamp) broker STILL down after kickstart — needs manual attention" >> "$LOG"
exit 1
