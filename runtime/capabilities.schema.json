{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-os:framework:runtime:capabilities",
  "title": "Runtime Capability Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "purpose", "validator_finding_shape", "runtimes"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["stub", "active"] },
    "purpose": { "type": "string", "minLength": 1 },
    "validator_finding_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "path", "message", "fix"],
      "properties": {
        "severity": { "type": "string" },
        "path": { "type": "string" },
        "message": { "type": "string" },
        "fix": { "type": "string" }
      }
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "support"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "support": {
            "type": "object",
            "additionalProperties": {
              "enum": ["native", "adapter", "framework", "plugin", "partial", "none"]
            }
          }
        }
      }
    }
  }
}
