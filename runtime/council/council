        "Rules:\n"
        "- This is a live terminal subscription lane, not a headless API call.\n"
        "- Do not use or recommend Claude/Gemini headless billing-sensitive calls.\n"
        "- Read the task, deliberation, and state files before responding.\n"
        "- Your response should be concise and suitable to paste into deliberation.md.\n\n"
        f"Session: {state['session_id']}\n"
        f"State: {STATE_FILE}\n"
        f"Deliberation: {DELIBERATION}\n"
        f"State of Debate: {STATE_OF_DEBATE}\n\n"
        "Required contribution shape:\n"
        "## Director: [Name] - Round [N] - [ISO timestamp]\n"
        "**Lens:** [assigned lens]\n"
        "**Status:** APPROVED | CHANGES_REQUESTED | OBJECTING\n"
        "**Agreed with:** [specific items or none]\n"
        "**Disputed:** [specific items or none]\n"
        "**Proposed:** [specific changes or none]\n"
        "**Notes:** [observations or none]\n"
        "**Signature:** [name + model]\n"
    )
    role_lenses = {
        "claude-director.md": "Claude lens: architecture, cohesion, failure modes, review quality.",
        "codex-director.md": "Codex Director lens: implementation feasibility and verification.",
        "antigravity-director.md": "Antigravity lens: plan verification, correctness, security, and execution feasibility (plan + VERIFY only).",
        "chair.md": "Chair lens: enforce process, synthesize state, and certify only locked items.",
    }
    enabled_prompt_files = {f"{ROLE_TO_WINDOW[director]}.md" for director in active_directors(state)}
