    for filename, lens in role_lenses.items():
        if filename in enabled_prompt_files:
            write_text(PROMPTS / filename, f"{base}\n{enrich_lens_with_persona(filename, lens)}\n")


def find_item(state: dict, item_id: str) -> dict:
    for item in state["items"]:
        if item["id"] == item_id:
            return item
    raise SystemExit(f"unknown item: {item_id}")


def sealed_dir() -> Path:
    """Directory holding per-(item,director) sealed contributions for the current session."""
    return PROMPTS / "sealed"


def submit_sealed(args: argparse.Namespace) -> int:
    """Pillar 9: record a director's SEALED (blind) contribution for an item. The body is written to
    a per-(item,director) file hidden from the shared deliberation.md until `reveal-item`, so directors
    deliberate without anchoring on each other. Opt-in: the legacy paste-into-deliberation.md flow is
    unchanged. Source priority: --text, else --file, else stdin."""
    state = load_state()
    directors = active_directors(state)
    if args.director not in directors:
        raise SystemExit(f"director must be one of: {', '.join(directors)}")
    item = find_item(state, args.item_id)
    window = ROLE_TO_WINDOW.get(args.director)
    if not window:
        raise SystemExit(f"no prompt window mapped for director: {args.director}")
    if getattr(args, "text", None) is not None:
        body = args.text
    elif getattr(args, "file", None):
        body = read_text(Path(args.file).expanduser())
    else:
        body = sys.stdin.read()
    if not body.strip():
        raise SystemExit("refusing to submit an empty sealed contribution")
    write_text(sealed_dir() / f"{args.item_id}-{window}.md", body.rstrip() + "\n")
    item.setdefault("sealed", {})[args.director] = {"at": utc_now(), "window": window}
    item.setdefault("revealed_at", None)
    state["events"].append({"at": utc_now(), "event": "sealed_submitted", "item": args.item_id, "director": args.director})
    save_state(state)
    print(f"sealed {args.director} -> {args.item_id}")
    return 0


def reveal_item(args: argparse.Namespace) -> int:
    """Pillar 9: concatenate every sealed submission for an item into deliberation.md at once and
    stamp revealed_at — the reveal moment that ends the blind phase. Refuses partial reveals unless
    --force so no director's blind view is exposed before the others have committed theirs."""
    state = load_state()
    directors = active_directors(state)
    item = find_item(state, args.item_id)
    sealed = item.get("sealed") or {}
    missing = [d for d in directors if d not in sealed]
    if missing and not args.force:
        raise SystemExit(
            f"cannot reveal {args.item_id}: still sealed for {', '.join(missing)} "
            "(use --force to reveal a partial set)"
        )
    parts = []
    for director in directors:
        window = ROLE_TO_WINDOW.get(director)
        path = sealed_dir() / f"{args.item_id}-{window}.md" if window else None
        if path and path.exists():
            parts.append(f"### Sealed - {director} - {args.item_id}\n\n{read_text(path).strip()}\n")
    if not parts:
        raise SystemExit(f"no sealed submissions found for {args.item_id}")
    block = f"\n## Blind reveal - {args.item_id} - {utc_now()}\n\n" + "\n".join(parts)
    existing = read_text(DELIBERATION) if DELIBERATION.exists() else ""
    write_text(DELIBERATION, existing + block)
    item["revealed_at"] = utc_now()
    state["events"].append({"at": utc_now(), "event": "item_revealed", "item": args.item_id, "directors": sorted(sealed.keys())})
    save_state(state)
    print(f"revealed {args.item_id} -> {DELIBERATION}")
    return 0


def record_vote(args: argparse.Namespace) -> int:
    state = load_state()
    directors = active_directors(state)
    if args.director not in directors:
        raise SystemExit(f"director must be one of: {', '.join(directors)}")
    item = find_item(state, args.item_id)
    decision = args.decision.upper()
    if decision not in {"APPROVED", "CHANGES_REQUESTED", "OBJECTING"}:
        raise SystemExit("decision must be APPROVED, CHANGES_REQUESTED, or OBJECTING")
    item["approvals"][args.director] = {
        "decision": decision,
        "note": args.note or "",
        "at": utc_now(),
        "evidence": args.evidence or "",
    }
    if decision != "APPROVED":
        item["dissents"].append(
            {
                "director": args.director,
                "decision": decision,
                "note": args.note or "",
                "at": utc_now(),
            }
        )
    maybe_lock_item(item, directors)
    state["events"].append({"at": utc_now(), "event": "vote_recorded", "item": args.item_id, "director": args.director, "decision": decision})
    update_session_status(state)
    save_state(state)
    print(f"recorded {decision} from {args.director} on {args.item_id}")
    return 0


def maybe_lock_item(item: dict, directors: list[str]) -> None:
    decisions = {director: item["approvals"].get(director, {}).get("decision") for director in directors}
    if all(decisions.get(director) == "APPROVED" for director in directors):
        item["status"] = "locked"
        item["locked_at"] = item["locked_at"] or utc_now()
    else:
        item["status"] = "open"
        item["locked_at"] = None


def update_session_status(state: dict) -> None:
    if state.get("status") in {"archived", "cancelled", "complete"}:
        return
    state["status"] = "council_approved" if all(item["status"] == "locked" for item in state["items"]) else "deliberating"


def status(args: argparse.Namespace) -> int:
    state = load_state()
    update_session_status(state)
    save_state(state)
    print(f"session={state['session_id']}")
    print(f"status={state['status']}")
    print(f"directors={','.join(active_directors(state))}")
    print_pane_health(state, getattr(args, "session", "apex-council"))
    for item in state["items"]:
        approved = sorted(d for d, vote in item["approvals"].items() if vote.get("decision") == "APPROVED")
        blockers = sorted(d for d, vote in item["approvals"].items() if vote.get("decision") in {"CHANGES_REQUESTED", "OBJECTING"})
        print(f"{item['id']} [{item['status']}] {item['title']}")
        print(f"  approved={','.join(approved) if approved else '-'}")
        print(f"  blockers={','.join(blockers) if blockers else '-'}")
    return 0


def write_handoff(args: argparse.Namespace) -> int:
    state = load_state()
    update_session_status(state)
    if state["status"] != "council_approved" and not args.force:
        raise SystemExit("cannot write handoff: not all items are locked; use --force only for manual recovery")
    locked_items = [item for item in state["items"] if item["status"] == "locked"]
    text = (
        "# Council-Approved Handoff\n\n"
        f"**Session:** {state['session_id']}\n"
        f"**Generated:** {utc_now()}\n\n"
        "## Locked Items\n\n"
        + "\n".join(f"- `{item['id']}` {item['title']}" for item in locked_items)
        + "\n\n## Phases\n\n"
        "### Phase 1: Execute Locked Scope\n"
        "**Scope:** all locked items listed above.\n\n"
        "**Default executor:** Claude implements the locked handoff unless this handoff names a different single owner.\n\n"
        "**Finalizer:** Codex checks the result against this handoff, runs the strongest practical verification, fixes any defects directly, and records final evidence. Do not route routine defects back to the executor.\n\n"
        "**Completion criteria:** implementation complete, Codex finalization complete, verification commands recorded, evidence report written.\n\n"
        "**Escalation:** reopen Council only for a plan/scope change. Escalate to Ayo only for destructive, production-risk, billing, outbound, auth, legal, or irreversible decisions.\n\n"
        "## Recorded Dissents\n\n"
    )
    dissents = [d for item in state["items"] for d in item.get("dissents", [])]
    text += "\n".join(f"- {d['director']} {d['decision']}: {d['note'] or 'no note'}" for d in dissents) if dissents else "None"
    text += f"\n\nCouncil-Approved - {utc_now()} - Chair session {state['session_id']}\n"
    write_text(HANDOFF, text)
    aorg = state.get("aorg") or {}
    if aorg.get("task_id") and not args.no_aorg_complete:
        acceptance = [f"{item['id']} locked: {item['title']}" for item in locked_items]
        result = run_aorg(
            [
                "complete",
                aorg.get("role") or "codex",
                aorg["task_id"],
                "--summary",
                f"Council-approved handoff written for {state['session_id']}",
                "--evidence",
                str(HANDOFF),
                "--acceptance-met",
                *acceptance,
                "--vna",
                "Claude executes the locked handoff; Codex finalizes, verifies, and repairs directly without sending routine defects back.",
            ]
        )
        aorg["completion"] = result
        state["aorg"] = aorg
        state["events"].append({"at": utc_now(), "event": "aorg_complete_attempted", "task_id": aorg["task_id"], "ok": result["ok"]})
        save_state(state)
        if not result["ok"]:
            raise SystemExit(f"aorg complete failed for {aorg['task_id']}: {result['stderr'] or result['stdout']}")
    print(HANDOFF)
    return 0


def readiness(_: argparse.Namespace) -> int:
    errors: list[str] = []
    for binary in ["tmux", "codex", "claude"]:
        if shutil.which(binary) is None:
            errors.append(f"missing binary: {binary}")

    if "Antigravity" in configured_directors() and shutil.which("agy") is None:
        errors.append("Antigravity director enabled but 'agy' binary is missing")

    scan_paths = [ROOT / "council", ROOT / "bin"]
    for path in scan_paths:
        if path.exists():
            content = "\n".join(p.read_text(errors="ignore") for p in scan_files(path))
            for pattern in BILLING_SENSITIVE_PATTERNS:
                if re.search(pattern, content):
                    errors.append(f"billing-sensitive pattern found in {path}: {pattern}")

    if errors:
        print("readiness=blocked")
        for error in errors:
            print(f"- {error}")
        return 1
    print("readiness=pass")
    return 0


def tmux_has(session: str) -> bool:
    return subprocess.run(["tmux", "has-session", "-t", session], capture_output=True).returncode == 0


def tmux_new_window(session: str, name: str, command: str) -> None:
    subprocess.run(["tmux", "new-window", "-t", session, "-n", name, "-c", str(ROOT.parent.parent), command], check=True)


def tmux_list_windows(session: str) -> list[str]:
    return subprocess.run(
        ["tmux", "list-windows", "-t", session, "-F", "#W"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.splitlines()


def prompt_file_for_window(window_name: str) -> Path | None:
    prompt = PROMPTS / f"{window_name}.md"
    if prompt.exists():
        return prompt
    return None


def launch_window_plan(existing_windows: set[str], commands: dict[str, str], fresh: bool) -> dict[str, list[str]]:
    create: list[str] = []
    recreate: list[str] = []
    reuse: list[str] = []
    for name in commands:
        if name not in existing_windows:
            create.append(name)
        elif fresh and name not in COUNCIL_CONTROL_WINDOWS:
            recreate.append(name)
        else:
            reuse.append(name)
    return {"create": create, "recreate": recreate, "reuse": reuse}


def tmux_kill_window(session: str, name: str) -> None:
    subprocess.run(["tmux", "kill-window", "-t", f"{session}:{name}"], check=True)


def build_prompt_injection_text(state: dict, prompt_file: Path, max_chars: int = 12000) -> str:
    prompt_text = read_text(prompt_file)
    brief_path = Path(state.get("task_file") or "")
    brief_text = read_text(brief_path) if brief_path.exists() else ""
    body = (
        f"Council session {state.get('session_id', 'unknown')}\n"
        f"Prompt file: {prompt_file}\n"
        f"Task brief: {brief_path if brief_path else '(none)'}\n\n"
        "Rules: non-mutating review only. Do not send outbound messages. Do not use headless/API billing.\n"
        "Respond in the required Director block and include only grounded claims from the prompt and task brief.\n\n"
        "----- DIRECTOR PROMPT -----\n"
        f"{prompt_text.strip()}\n\n"
        "----- TASK BRIEF -----\n"
        f"{brief_text.strip()}\n"
    )
    if len(body) <= max_chars:
        return body
    keep = max_chars - 120
    return body[:keep] + "\n\n[truncated: task brief exceeded injection limit; request chair paste only the missing section if needed]\n"


def tmux_paste_text(session: str, window_name: str, text: str) -> None:
    buffer_name = f"apex-council-{window_name}"
    subprocess.run(["tmux", "load-buffer", "-b", buffer_name, "-"], input=text, text=True, check=True)
    subprocess.run(["tmux", "paste-buffer", "-t", f"{session}:{window_name}", "-b", buffer_name], check=True)
    subprocess.run(["tmux", "send-keys", "-t", f"{session}:{window_name}", "C-m"], check=True)


def inject_prompt_instruction(session: str, window_name: str, prompt_file: Path, state: dict) -> None:
    tmux_paste_text(session, window_name, build_prompt_injection_text(state, prompt_file))


SHELL_COMMANDS = {"zsh", "-zsh", "bash", "-bash", "sh", "fish", "login"}


def director_commands(with_antigravity: bool = False) -> dict[str, str]:
    _dirs = [str(WORKSPACE)] + [d for d in DIRECTOR_ADD_DIRS.split(os.pathsep) if d] + ["/private/tmp"]
    _flags = " ".join(f"--add-dir {d}" for d in _dirs)
    commands = {
        "claude-director": f"claude --permission-mode plan {_flags}",
        "codex-director": "codex",
        "chair": "zsh",
    }
    if with_antigravity or "Antigravity" in configured_directors():
        commands["antigravity-director"] = "agy -i"
    return commands


def resolve_window(member: str) -> str:
    key = member.strip().lower()
    aliases = {
        "claude": "claude-director",
        "claude-director": "claude-director",
        "codex": "codex-director",
        "codex director": "codex-director",
        "codex-director": "codex-director",
        "antigravity": "antigravity-director",
        "antigravity-director": "antigravity-director",
        "chair": "chair",
    }
    if key not in aliases:
        raise SystemExit(f"unknown member: {member}; choose Claude, Codex Director, Antigravity, or chair")
    return aliases[key]


def pane_health(session: str, window: str, expect_cli: bool) -> tuple[str, str]:
    res = subprocess.run(
        ["tmux", "list-panes", "-t", f"{session}:{window}", "-F", "#{pane_dead}|#{pane_current_command}"],
        capture_output=True,
        text=True,
    )
    if res.returncode != 0:
        return ("missing", "")
    lines = [ln for ln in res.stdout.splitlines() if ln.strip()]
    if not lines:
        return ("unknown", "")
    dead, _, cmd = lines[0].partition("|")
    cmd = cmd.strip()
    if dead.strip() == "1":
        return ("dead", cmd)
    if expect_cli and cmd in SHELL_COMMANDS:
        return ("idle(shell)", cmd)
    return ("alive", cmd)


def print_pane_health(state: dict, session: str) -> None:
    print(f"tmux_session={session}")
    if not tmux_has(session):
        print("  panes: no live tmux session")
        return
    live = set(tmux_list_windows(session))
    for window in [ROLE_TO_WINDOW[d] for d in active_directors(state) if d in ROLE_TO_WINDOW]:
        health, cmd = pane_health(session, window, expect_cli=True)
        print(f"  pane {window}: {health}" + (f" ({cmd})" if cmd else ""))
    for window in ("chair", "council-control"):
        if window in live:
            health, cmd = pane_health(session, window, expect_cli=False)
            print(f"  pane {window}: {health}" + (f" ({cmd})" if cmd else ""))


def restart_director(args: argparse.Namespace) -> int:
    session = args.session
    window = resolve_window(args.member)
    if not tmux_has(session):
        raise SystemExit(f"no live tmux session '{session}'; run: council launch --session {session}")
    commands = director_commands()
    if window not in commands:
        raise SystemExit(f"{window} is not an active pane; configured: {', '.join(sorted(commands))}")
    existing = set(tmux_list_windows(session))
    if window in existing:
        tmux_kill_window(session, window)
        action = "restarted"
    else:
        action = "created"
    tmux_new_window(session, window, commands[window])
    injected = False
    if not args.no_inject and window not in COUNCIL_CONTROL_WINDOWS:
        prompt_file = prompt_file_for_window(window)
        if prompt_file and STATE_FILE.exists():
            if args.inject_delay > 0:
                time.sleep(args.inject_delay)
            inject_prompt_instruction(session, window, prompt_file, load_state())
            injected = True
    print(f"{action} {window} in {session}" + (" (prompt re-injected)" if injected else ""))
    return 0


def attach(args: argparse.Namespace) -> int:
    session = args.session
    if not tmux_has(session):
        raise SystemExit(f"no live tmux session '{session}'; run: council launch --session {session}")
    verb = "switch-client" if os.environ.get("TMUX") else "attach-session"
    os.execvp("tmux", ["tmux", verb, "-t", session])


def launch(args: argparse.Namespace) -> int:
    ensure_dirs()
    session = args.session
    if not tmux_has(session):
        subprocess.run(["tmux", "new-session", "-d", "-s", session, "-n", "council-control", "-c", str(ROOT), "zsh"], check=True)
    windows = set(tmux_list_windows(session))
    commands = director_commands(args.with_antigravity)
    plan = launch_window_plan(windows, commands, args.fresh)
    for name in plan["recreate"]:
        tmux_kill_window(session, name)
        tmux_new_window(session, name, commands[name])
    for name in plan["create"]:
        tmux_new_window(session, name, commands[name])
    injected: list[str] = []
    if args.inject_prompts:
        if (plan["create"] or plan["recreate"]) and args.inject_delay > 0:
            time.sleep(args.inject_delay)
        state = load_state()
        for name in commands:
            if name in COUNCIL_CONTROL_WINDOWS:
                continue
            prompt_file = prompt_file_for_window(name)
            if not prompt_file:
                continue
            inject_prompt_instruction(session, name, prompt_file, state)
            injected.append(name)
    print(f"launched tmux session {session}")
    reused_directors = [name for name in plan["reuse"] if name not in COUNCIL_CONTROL_WINDOWS]
    reused_control = [name for name in plan["reuse"] if name in COUNCIL_CONTROL_WINDOWS]
    if reused_directors:
        print("reused existing director windows:")
        for name in reused_directors:
            print(f"- {name}")
        print("warning: reused director windows may contain stale conversations; rerun with --fresh to recreate council-owned director panes")
    if reused_control:
        print("reused control windows:")
        for name in reused_control:
            print(f"- {name}")
    if plan["recreate"]:
        print("recreated windows:")
        for name in plan["recreate"]:
            print(f"- {name}")
    if plan["create"]:
        print("created windows:")
        for name in plan["create"]:
            print(f"- {name}")
    if injected:
        print("injected prompt instructions:")
        for name in injected:
            print(f"- {name}")
    print("prompt files:")
    for path in sorted(PROMPTS.glob("*.md")):
        print(f"- {path}")
    return 0


def self_test(_: argparse.Namespace) -> int:
