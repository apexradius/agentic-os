def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def ensure_dirs() -> None:
    for path in [CURRENT, ARCHIVE, REPORTS, REVIEWS, STUCK, CHECKPOINTS, PROMPTS]:
        path.mkdir(parents=True, exist_ok=True)


@contextlib.contextmanager
def council_lock():
    STATE_ROOT.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("a+", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def configured_directors() -> list[str]:
    raw = os.environ.get("APEX_COUNCIL_DIRECTORS")
    if raw:
        directors = [item.strip() for item in raw.split(",") if item.strip()]
    else:
        directors = list(DEFAULT_DIRECTORS)

    unknown = [director for director in directors if director not in KNOWN_DIRECTORS]
    if unknown:
        raise SystemExit(f"unknown council director(s): {', '.join(unknown)}")
    if not directors:
        raise SystemExit("at least one council director is required")
    return directors


def active_directors(state: dict | None = None) -> list[str]:
    if state and state.get("directors"):
        return list(state["directors"])
    return configured_directors()


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def write_text(path: Path, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(value, encoding="utf-8")


def scan_files(path: Path) -> list[Path]:
    if path.is_file():
        return [path]
    ignored_dirs = {"__pycache__", ".git", ".DS_Store"}
    allowed_suffixes = {".py", ".sh", ".md", ".json", ".jsonl", ".toml", ".yaml", ".yml", ""}
    files: list[Path] = []
    for item in path.rglob("*"):
        if any(part in ignored_dirs for part in item.parts):
            continue
        if item.name == "aorg":
            continue
        if item.is_file() and item.suffix in allowed_suffixes:
            files.append(item)
    return files


def load_state() -> dict:
    if not STATE_FILE.exists():
        raise SystemExit(f"no council session initialized at {STATE_FILE}")
    return json.loads(read_text(STATE_FILE))


def save_state(state: dict) -> None:
    write_text(STATE_FILE, json.dumps(state, indent=2, sort_keys=True) + "\n")


def run_aorg(args: list[str]) -> dict:
    if not AORG_BIN.exists():
        return {"ok": False, "returncode": 127, "stdout": "", "stderr": f"aorg not found: {AORG_BIN}"}
    proc = subprocess.run([str(AORG_BIN), *args], cwd=str(ROOT), capture_output=True, text=True, timeout=30)
    return {"ok": proc.returncode == 0, "returncode": proc.returncode, "stdout": proc.stdout.strip(), "stderr": proc.stderr.strip()}


def archive_current() -> None:
    if not STATE_FILE.exists():
        return
    session_id = json.loads(read_text(STATE_FILE)).get("session_id", "unknown")
    target = ARCHIVE / f"{datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S')}-{session_id}"
    target.mkdir(parents=True, exist_ok=True)
    for child in CURRENT.iterdir():
        shutil.move(str(child), str(target / child.name))


def derive_items(task_text: str, explicit_items: list[str]) -> list[dict]:
    titles: list[str] = []
    if explicit_items:
        titles = explicit_items
    else:
        for line in task_text.splitlines():
            stripped = line.strip()
            if stripped.startswith("- [ ] "):
                titles.append(stripped[6:].strip())
            elif stripped.startswith("- ") and len(titles) < 12:
                titles.append(stripped[2:].strip())
            elif stripped.startswith("## ") and stripped.lower() not in {"## task brief", "## constraints", "## out of scope"}:
                titles.append(stripped[3:].strip())
    if not titles:
        titles = ["Approve execution plan for submitted task brief"]

    items = []
    seen = set()
    for title in titles:
        title = re.sub(r"\s+", " ", title).strip()
        if not title or title.lower() in seen:
            continue
        seen.add(title.lower())
        item_id = f"item-{len(items) + 1:03d}"
        items.append(
            {
                "id": item_id,
                "title": title,
                "status": "open",
                "approvals": {},
                "dissents": [],
                "locked_at": None,
            }
        )
    return items


def init_session(args: argparse.Namespace) -> int:
    task_path = Path(args.task_file).expanduser()
    if not task_path.exists():
        raise SystemExit(f"task brief not found: {task_path}")
    ensure_dirs()
    if not args.no_archive:
        archive_current()
        ensure_dirs()

    task_text = read_text(task_path)
    session_id = args.session or f"council-{datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S')}"
    items = derive_items(task_text, args.item or [])
    aorg_task_id = args.aorg_task or os.environ.get("AORG_TASK_ID") or None
    aorg_role = args.aorg_role or os.environ.get("AORG_ROLE") or "codex"
    state = {
        "session_id": session_id,
        "mode": args.mode,
        "created_at": utc_now(),
        "task_file": str(task_path),
        "status": "deliberating",
        "directors": configured_directors(),
        "aorg": {
            "task_id": aorg_task_id,
            "role": aorg_role,
            "claim": None,
            "completion": None,
        },
        "items": items,
        "phase_reviews": [],
        "stuck_reports": [],
        "events": [{"at": utc_now(), "event": "session_initialized", "mode": args.mode}],
    }
    if aorg_task_id and not args.no_aorg_claim:
        result = run_aorg(["claim", aorg_role, aorg_task_id])
        state["aorg"]["claim"] = result
        if not result["ok"]:
            save_state(state)
            raise SystemExit(f"aorg claim failed for {aorg_task_id}: {result['stderr'] or result['stdout']}")
    save_state(state)

    write_text(
        DELIBERATION,
        "# Apex OS Council Deliberation\n\n"
        f"**Session:** {session_id}\n"
        f"**Mode:** {args.mode}\n"
        f"**Started:** {state['created_at']}\n\n"
        "## Task Brief\n\n"
        f"{task_text.strip()}\n\n"
        "## Open Items\n\n"
        + "\n".join(f"- `{item['id']}` {item['title']}" for item in items)
        + "\n\n## Approved Items\n\nNone yet.\n",
    )
    write_text(STATE_OF_DEBATE, "# State of Debate\n\nNo rounds recorded yet.\n")
    write_role_prompts(state)
    print(f"initialized {session_id}")
    print(STATE_FILE)
    return 0


ROLES_FILE = ROOT / "roles.json"
# Pillar 9: director prompt-file -> roles.json persona key (chair is a process role, no persona).
WINDOW_TO_ROLE_KEY = {
    "claude-director.md": "claude",
    "codex-director.md": "codex",
    "antigravity-director.md": "antigravity",
}


def load_personas() -> dict:
    """Per-director personas from roles.json (Pillar 9). Returns {} on ANY failure so the
    legacy one-line lenses remain the fallback — personas only ever ADD prompt text."""
    try:
        roles = json.loads(ROLES_FILE.read_text(encoding="utf-8")).get("roles", {})
    except (OSError, ValueError):
        return {}
    out = {}
    for key in ("claude", "codex", "antigravity"):
        role = roles.get(key)
        if isinstance(role, dict) and isinstance(role.get("persona"), dict):
            out[key] = role["persona"]
    return out


def enrich_lens_with_persona(filename: str, fallback_lens: str) -> str:
    """Append the director's persona block to the legacy lens line, or return the lens
    unchanged when no persona exists (back-compat: the '<X> lens' token is preserved)."""
    key = WINDOW_TO_ROLE_KEY.get(filename)
    persona = load_personas().get(key) if key else None
    if not persona:
        return fallback_lens
    values = ", ".join(persona.get("value_priority", []))
    return (
        f"{fallback_lens}\n"
        f"**Persona:** {persona.get('alias', key)} — {persona.get('temperament', '')}\n"
        f"**Value priority:** {values}\n"
        f"**Adversarial mandate:** {persona.get('adversarial_mandate', '')}"
    )


