        state = load_state()
        assert find_item(state, "item-001")["status"] == "open"
        record_vote(argparse.Namespace(item_id="item-001", director=directors[-1], decision="APPROVED", note="", evidence="self-test"))
        state = load_state()
        assert find_item(state, "item-001")["status"] == "locked"
        assert state["status"] == "deliberating"
        for director in directors:
            record_vote(argparse.Namespace(item_id="item-002", director=director, decision="APPROVED", note="", evidence="self-test"))
        state = load_state()
        assert state["status"] == "council_approved"
        # Pillar 9: sealed-submission -> reveal cycle (blind council deliberation)
        for director in directors:
            submit_sealed(argparse.Namespace(director=director, item_id="item-001", file=None, text=f"blind view from {director}"))
        state = load_state()
        assert set((find_item(state, "item-001").get("sealed") or {}).keys()) == set(directors)
        assert find_item(state, "item-001").get("revealed_at") is None
        reveal_item(argparse.Namespace(item_id="item-001", force=False))
        state = load_state()
        assert find_item(state, "item-001").get("revealed_at") is not None
        assert DELIBERATION.exists() and "Blind reveal" in read_text(DELIBERATION)
        write_handoff(argparse.Namespace(force=False, no_aorg_complete=True))
        assert HANDOFF.exists()
        plan = launch_window_plan(
            {"council-control", "claude-director", "antigravity-director"},
            {"claude-director": "claude", "antigravity-director": "agy", "chair": "zsh"},
            fresh=False,
        )
        assert plan == {
            "create": ["chair"],
            "recreate": [],
            "reuse": ["claude-director", "antigravity-director"],
        }
        fresh_plan = launch_window_plan(
            {"council-control", "claude-director", "antigravity-director"},
            {"claude-director": "claude", "antigravity-director": "agy", "chair": "zsh"},
            fresh=True,
        )
        assert fresh_plan == {
            "create": ["chair"],
            "recreate": ["claude-director", "antigravity-director"],
            "reuse": [],
        }
        injection = build_prompt_injection_text(state, PROMPTS / "antigravity-director.md")
        assert "----- DIRECTOR PROMPT -----" in injection
        assert "----- TASK BRIEF -----" in injection
        assert "Antigravity lens" in injection
        assert director_commands()["claude-director"].startswith("claude ")
        assert "antigravity-director" in director_commands()
        assert resolve_window("Claude") == "claude-director"
        assert resolve_window("Codex Director") == "codex-director"
        assert resolve_window("antigravity-director") == "antigravity-director"
        content = Path(__file__).read_text(encoding="utf-8")
        for pattern in BILLING_SENSITIVE_PATTERNS:
            assert re.search(pattern, content) is None, pattern
        globals()["ROOT"] = old_root
    if old_directors is None:
        os.environ.pop("APEX_COUNCIL_DIRECTORS", None)
    else:
        os.environ["APEX_COUNCIL_DIRECTORS"] = old_directors
    print("council_self_test=pass")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Apex OS Council mode")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("init")
    p.add_argument("task_file")
    p.add_argument("--mode", choices=["plan", "phase-review", "stuck-report"], default="plan")
    p.add_argument("--session")
    p.add_argument("--item", action="append")
    p.add_argument("--aorg-task")
    p.add_argument("--aorg-role", default="codex")
    p.add_argument("--no-aorg-claim", action="store_true")
    p.add_argument("--no-archive", action="store_true")
    p.set_defaults(func=init_session)

    p = sub.add_parser("record")
    p.add_argument("item_id")
    p.add_argument("director")
    p.add_argument("decision")
    p.add_argument("--note")
    p.add_argument("--evidence")
    p.set_defaults(func=record_vote)

    p = sub.add_parser("submit", help="record a director's SEALED (blind) contribution for an item (Pillar 9)")
    p.add_argument("director", help="Claude | Codex Director | Antigravity")
    p.add_argument("item_id")
    p.add_argument("--file", default=None, help="read the contribution from this file")
    p.add_argument("--text", default=None, help="inline contribution text (else --file, else stdin)")
    p.set_defaults(func=submit_sealed)

    p = sub.add_parser("reveal-item", help="reveal all sealed submissions for an item into deliberation.md (Pillar 9)")
    p.add_argument("item_id")
    p.add_argument("--force", action="store_true", help="reveal even if some active directors have not submitted")
    p.set_defaults(func=reveal_item)

    p = sub.add_parser("status")
    p.add_argument("--session", default="apex-council")
    p.set_defaults(func=status)

    p = sub.add_parser("handoff")
    p.add_argument("--force", action="store_true")
    p.add_argument("--no-aorg-complete", action="store_true")
    p.set_defaults(func=write_handoff)

    p = sub.add_parser("readiness")
    p.set_defaults(func=readiness)

    p = sub.add_parser("launch")
    p.add_argument("--session", default="apex-council")
    p.add_argument("--with-antigravity", action="store_true")
    p.add_argument("--fresh", action="store_true", help="recreate existing council-owned director panes before launch")
    p.add_argument("--inject-prompts", action="store_true", help="paste current director prompt and task brief into live director panes")
    p.add_argument("--inject-delay", type=float, default=2.0, help="seconds to wait before prompt injection after creating panes")
    p.set_defaults(func=launch)

    p = sub.add_parser("restart", help="restart a single director pane without nuking the session")
    p.add_argument("member", help="Claude | Codex Director | Antigravity | chair (or a window name)")
    p.add_argument("--session", default="apex-council")
    p.add_argument("--no-inject", action="store_true", help="do not re-inject the director prompt after restart")
    p.add_argument("--inject-delay", type=float, default=2.0)
    p.set_defaults(func=restart_director)

    p = sub.add_parser("attach", help="attach to (or switch-client to) the live council tmux session")
    p.add_argument("--session", default="apex-council")
    p.set_defaults(func=attach)

    p = sub.add_parser("self-test")
    p.set_defaults(func=self_test)

    return parser


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "--self-test":
        return self_test(argparse.Namespace())
    parser = build_parser()
    args = parser.parse_args()
    if args.cmd in {"init", "record", "status", "handoff"}:
        with council_lock():
            return args.func(args)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
