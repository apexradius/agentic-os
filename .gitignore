# Agentic OS — commit source, never artifacts.
# Rule: if `install` or `build` can regenerate it, it does not belong in git.

# ── Node ──────────────────────────────────────────────
node_modules/
.pnpm-store/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# ── Python ────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Logs & runtime scratch ────────────────────────────
*.log
logs/
tmp/
.cache/

# ── Transient applier / edit backups ──────────────────
*.bak
*.bak-*

# ── Secrets — NEVER commit ────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
credentials.*

# ── OS / editor noise ─────────────────────────────────
.DS_Store
Thumbs.db
